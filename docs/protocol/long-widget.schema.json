{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:long:schemas:widget:1.0",
  "title": "Long Plugin Widget Definitions 1.0",
  "description": "The schema for the optional top-level widgets array proposed by LPWP 1.0.",
  "type": "array",
  "maxItems": 32,
  "items": {
    "$ref": "#/$defs/widget"
  },
  "$defs": {
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "entry_point",
        "default_size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "entry_point": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+\\.html$"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"
        },
        "multiple_instances": {
          "type": "boolean",
          "default": false
        },
        "default_size": {
          "$ref": "#/$defs/size"
        },
        "min_size": {
          "$ref": "#/$defs/size"
        },
        "max_size": {
          "$ref": "#/$defs/size"
        },
        "refresh": {
          "$ref": "#/$defs/refresh"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "settings_schema": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/setting"
          }
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "event",
            "interval",
            "manual"
          ],
          "default": "event"
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 86400
        },
        "hidden_behavior": {
          "type": "string",
          "enum": [
            "suspend",
            "throttle",
            "continue"
          ],
          "default": "suspend"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "interval"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "interval_seconds"
            ]
          },
          "else": {
            "not": {
              "required": [
                "interval_seconds"
              ]
            }
          }
        }
      ]
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transparent": {
          "type": "boolean",
          "default": false
        },
        "host_chrome": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "title"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9._-]{0,63}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "enum"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "default": {},
        "enum_values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
