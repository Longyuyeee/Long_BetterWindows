{
  "schema_version": 1,
  "updated_at": "2026-07-27",
  "policy": {
    "required_plugin_count": 11,
    "required_command_count": 14,
    "isolation": "Each case runs in a fresh host process with a temporary plugin root containing only the target plugin.",
    "side_effect_rule": "Only explicitly listed read-only host API methods may be called. Clipboard, file, process mutation, storage and desktop mutation calls are forbidden."
  },
  "cases": [
    {
      "id": "base64-encode",
      "plugin_id": "com.long.base64",
      "plugin_folder": "Base64Tool",
      "command_id": "base64.encode",
      "input": "Long助手",
      "expected_success": true,
      "expected_output": { "key": "result", "exact": "TG9uZ+WKqeaJiw==" },
      "allowed_api_methods": []
    },
    {
      "id": "base64-decode",
      "plugin_id": "com.long.base64",
      "plugin_folder": "Base64Tool",
      "command_id": "base64.decode",
      "input": "TG9uZ+WKqeaJiw==",
      "expected_success": true,
      "expected_output": { "key": "result", "exact": "Long助手" },
      "allowed_api_methods": []
    },
    {
      "id": "base64-invalid",
      "plugin_id": "com.long.base64",
      "plugin_folder": "Base64Tool",
      "command_id": "base64.decode",
      "input": "%%%invalid%%%",
      "expected_success": false,
      "allowed_api_methods": []
    },
