{
  "id": "com.long.uuid-generator",
  "version": "1.1.0",
  "name": "UUID 生成器",
  "author": "Long",
  "entry_point": "index.html",
  "runtime": "webview",
  "capabilities": ["system.clipboard"],
  "commands": [
    {
      "id": "uuid.generate",
      "title": "生成 UUID",
      "description": "使用安全随机源批量生成 UUID v4",
      "aliases": ["uuid", "guid", "唯一标识", "weiyibiaoshi"],
      "accepted_inputs": ["none"],
      "argument_schema": [
        {
          "key": "amount",
          "name": "生成数量",
          "description": "一次生成的 UUID 数量",
          "type": "integer",
          "default_value": "10",
          "minimum": 1,
          "maximum": 100
        },
        {
          "key": "uppercase",
          "name": "使用大写字母",
          "description": "将 UUID 中的十六进制字母转换为大写",
          "type": "boolean",
          "default_value": "false"
        },
        {
          "key": "compact",
          "name": "移除连字符",
          "description": "输出不包含连字符的紧凑 UUID",
          "type": "boolean",
          "default_value": "false"
        }
      ],
      "argument_presets": [
        {
          "id": "quick-10",
          "name": "快速生成 10 个",
          "arguments": {
            "amount": "10",
            "uppercase": "false",
            "compact": "false"
          }
        },
        {
          "id": "batch-100",
          "name": "批量生成 100 个",
          "arguments": {
            "amount": "100",
            "uppercase": "false",
            "compact": "false"
          }
        },
        {
          "id": "compact-uppercase",
          "name": "紧凑大写 10 个",
          "arguments": {
            "amount": "10",
            "uppercase": "true",
            "compact": "true"
          }
        }
      ],
      "outputs": [
        {
          "key": "result",
          "type": "text",
          "description": "生成的 UUID 列表，每行一个"
        }
      ],
      "view_mode": "form",
      "priority": 12
    }
  ],
  "window": {"mode": "compact", "preferred_width": 650, "preferred_height": 640, "min_width": 520, "min_height": 520},
  "lifecycle": {"start_with_host": false, "close_behavior": "stop", "default_presentation": "embedded", "search_in_background": false},
  "localization": {
    "default_language": "zh-CN",
    "resources": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "default_settings": {"auto_start": false}
}
