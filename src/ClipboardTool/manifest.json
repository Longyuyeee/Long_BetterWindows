{
  "id": "com.long.clipboard-tool",
  "version": "1.2.0",
  "name": "剪贴板工具箱",
  "author": "Long",
  "entry_point": "index.html",
  "runtime": "webview",
  "capabilities": ["system.clipboard", "system.clipboard.monitor", "storage.local"],
  "commands": [
    {
      "id": "clipboard.open",
      "title": "打开剪贴板工具箱",
      "description": "查看历史、固定内容或转换文本",
      "aliases": ["剪贴板", "clipboard", "历史剪贴板", "jiantieban"],
      "accepted_inputs": ["text", "clipboard"],
      "view_mode": "list",
      "keep_alive": true,
      "priority": 26
    }
  ],
  "window": {
    "mode": "standard",
    "preferred_width": 780,
    "preferred_height": 760,
    "min_width": 620,
    "min_height": 540
  },
  "localization": {
    "default_language": "zh-CN",
    "resources": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "default_settings": {
    "auto_start": false,
    "max_items": 50,
    "max_item_characters": 65536,
    "max_collection_characters": 500000
  }
}
