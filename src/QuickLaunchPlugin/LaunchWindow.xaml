<Window x:Class="QuickLaunchPlugin.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Border Background="#F0F0F5" CornerRadius="14" Padding="14"
            BorderBrush="#20000000" BorderThickness="0.5"
            Width="400">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.2" />
        </Border.Effect>

        <StackPanel>
            <TextBox x:Name="SearchBox"
                     FontSize="16"
                     BorderThickness="0"
                     Background="Transparent"
                     TextChanged="SearchBox_TextChanged"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" />

            <ListBox x:Name="ResultsList"
                     MaxHeight="280"
                     BorderThickness="0"
                     Background="Transparent"
                     Visibility="Collapsed"
                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                     Margin="0,8,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="13"
                                   Margin="0,4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</Window>
