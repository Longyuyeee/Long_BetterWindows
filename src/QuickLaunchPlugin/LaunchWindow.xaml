<Window x:Class="QuickLaunchPlugin.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Border x:Name="MainBorder" CornerRadius="14" Padding="16"
            BorderBrush="#20000000" BorderThickness="0.5"
            Width="440">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.2" />
        </Border.Effect>

        <StackPanel>
            <TextBox x:Name="SearchBox"
                     FontSize="18"
                     BorderThickness="0"
                     Background="Transparent"
                     CaretBrush="#007AFF"
                     PreviewKeyDown="SearchBox_PreviewKeyDown"
                     TextChanged="SearchBox_TextChanged" />

            <ListBox x:Name="ResultsList"
                     MaxHeight="320"
                     BorderThickness="0"
                     Background="Transparent"
                     Visibility="Collapsed"
                     MouseDoubleClick="ResultsList_MouseDoubleClick"
                     Margin="0,8,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="{Binding Icon}" FontSize="14"
                                       Width="24" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="HintText" Text="搜索应用..."
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>
