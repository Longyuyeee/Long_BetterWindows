<Window x:Class="QuickLaunchPlugin.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷启动"
        Width="640" Height="430"
        MinWidth="520" MinHeight="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated">

    <Border x:Name="MainBorder"
            Background="{DynamicResource Long.Brush.Surface.Overlay}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Strong}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Long.Radius.Flyout}"
            Padding="18">
        <Border.Effect>
            <StaticResource ResourceKey="Long.Shadow.Level3" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Height="2" VerticalAlignment="Top" Margin="24,-18,24,0"
                    CornerRadius="0,0,3,3" Background="{DynamicResource Long.Brush.Accent.Gradient}" />

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Data="{StaticResource Long.Icon.Search}" Style="{StaticResource LongIcon}"
                      Margin="4,0,12,0" VerticalAlignment="Center" />
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Style="{StaticResource LongSearchBox}"
                         FontSize="20" FontWeight="SemiBold"
                         BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="搜索应用、文件、链接或计算"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                         TextChanged="SearchBox_TextChanged" />
                <Border Grid.Column="2" Style="{StaticResource LongHotkeyBadge}">
                    <TextBlock Text="ESC" FontFamily="{DynamicResource Long.Font.Mono}" FontSize="10" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="0,12"
                    Background="{DynamicResource Long.Brush.Stroke.Default}" />

            <ListBox x:Name="ResultsList" Grid.Row="2"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <StaticResource ResourceKey="LongCommandItem" />
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource LongBadge}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CategoryLabel}" FontSize="10" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                                <TextBlock Text="{Binding DisplaySubtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="Enter" VerticalAlignment="Center"
                                       FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" Margin="4,12,4,0">
                <TextBlock x:Name="HintText" Text="输入关键词开始搜索"
                           FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                <TextBlock x:Name="NavigationHintText" Text="↑↓ 选择 · Enter 打开" HorizontalAlignment="Right"
                           FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
            </Grid>
        </Grid>
    </Border>
</Window>
