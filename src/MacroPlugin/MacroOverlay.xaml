<Window x:Class="MacroPlugin.MacroOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        IsHitTestVisible="False">

    <Border x:Name="StatusBorder"
            Background="{DynamicResource Long.Brush.State.Danger}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.OnAccent}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Long.Radius.Control}"
            Padding="12,8" Opacity="0.96">
        <Border.Effect>
            <StaticResource ResourceKey="Long.Shadow.Level2" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot"
                     Width="8" Height="8" Fill="{DynamicResource Long.Brush.Text.OnAccent}"
                     Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="REC"
                       Foreground="{DynamicResource Long.Brush.Text.OnAccent}" FontSize="12"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" Text=""
                       Foreground="{DynamicResource Long.Brush.Text.OnAccentMuted}" FontSize="11"
                       Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
    </Border>
</Window>
