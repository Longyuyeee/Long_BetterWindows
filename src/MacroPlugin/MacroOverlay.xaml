<Window x:Class="MacroPlugin.MacroOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        IsHitTestVisible="False">

    <Border x:Name="StatusBorder"
            Background="#E0323232" CornerRadius="8"
            Padding="10,6">
        <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot"
                     Width="8" Height="8" Fill="#FF3B30"
                     Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="REC"
                       Foreground="White" FontSize="12"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="CountText" Text=""
                       Foreground="#AAFFFFFF" FontSize="11"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
