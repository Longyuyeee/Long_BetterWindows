{
  "id": "com.long.devtoolkit",
  "version": "1.1.0",
  "name": "开发者工具箱",
  "author": "Long",
  "description": "面向开发者的编码、解码、转换与识别工具，支持 Base64、时间戳、UUID、Hash、URL、进制、Unicode 等一站式转换",
  "entry_point": "index.html",
  "runtime": "webview",
  "capabilities": [
    "system.clipboard"
  ],
  "commands": [
    {
      "id": "dev-toolkit.open",
      "title": "打开开发者工具箱",
      "description": "使用编码、哈希、时间戳、UUID 和进制转换工具",
      "aliases": ["开发者工具", "转换工具", "dev toolkit", "kaifagongju"],
      "accepted_inputs": ["none", "text", "clipboard"],
      "view_mode": "form",
      "priority": 20
    }
  ],
  "window": {
    "mode": "wide",
    "preferred_width": 1040,
    "preferred_height": 760,
    "min_width": 760,
    "min_height": 560
  },
  "localization": {
    "default_language": "zh-CN",
    "resources": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "lifecycle": {
    "start_with_host": false,
    "close_behavior": "stop",
    "default_presentation": "embedded",
    "search_in_background": false
  },
  "default_settings": {
    "auto_start": false
  }
}
