<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>LongBetterWindows.Host</RootNamespace>
    <AssemblyName>LongBetterWindows.Host</AssemblyName>
    <Title>Long窗口·全能助手</Title>
    <Company>Long</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="WPF-UI" Version="3.0.4" />
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- 复制 Web 插件源码到 Plugins 输出目录 -->
  <Target Name="CopyWebPlugins" AfterTargets="Build">
    <!-- 自动复制所有 Web 插件目录到 Plugins/ -->
    <ItemGroup>
      <_WebPlugins Include="$(SolutionDir)src\ClipboardTool\**\*" />
      <_WebPlugins Include="$(SolutionDir)src\QuickNotePlugin\**\*" />
      <_WebPlugins Include="$(SolutionDir)src\TranslatePlugin\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebPlugins)"
          DestinationFiles="@(_WebPlugins->'$(SolutionDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
