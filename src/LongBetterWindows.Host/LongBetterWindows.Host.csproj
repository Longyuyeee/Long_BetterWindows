<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="..\..\Assets\app.ico" Link="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="WebAssets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Marketplace\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <NativePluginProject Include="..\SamplePlugin\SamplePlugin.csproj" />
    <NativePluginProject Include="..\FolderNotePlugin\FolderNotePlugin.csproj" />
    <NativePluginProject Include="..\QuickLaunchPlugin\QuickLaunchPlugin.csproj" />
    <NativePluginProject Include="..\MacroPlugin\MacroPlugin.csproj" />
    <NativePluginProject Include="..\ColorPickerPlugin\ColorPickerPlugin.csproj" />
    <NativePluginProject Include="..\ScreenshotPlugin\ScreenshotPlugin.csproj" />
    <NativePluginProject Include="..\WindowManagerPlugin\WindowManagerPlugin.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>LongBetterWindows.Host</RootNamespace>
    <AssemblyName>LongBetterWindows.Host</AssemblyName>
    <Title>Long窗口·全能助手</Title>
    <Company>Long</Company>
    <Product>Long窗口·全能助手</Product>
    <Description>优雅、华丽、扁平、动效化的 Windows 插件效率平台</Description>
    <Version>0.5.0-rc.1</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.5.0-rc.1</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="WPF-UI" Version="3.0.4" />
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- 仓库根目录（兼容 SolutionDir 不存在的情况） -->
  <PropertyGroup>
    <RepoRoot Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <RepoRoot Condition="'$(SolutionDir)' != ''">$(SolutionDir)</RepoRoot>
  </PropertyGroup>

  <!-- 复制所有插件到输出目录 Plugins/ -->
  <Target Name="CopyAllPlugins" AfterTargets="Build">
    <Message Importance="high" Text="复制插件到 $(OutputPath)Plugins..." />

    <!-- 原生插件仅发布运行所需的 Manifest 与 DLL，不携带源码和项目文件。 -->
    <RemoveDir Directories="$(OutputPath)Plugins\SamplePlugin;$(OutputPath)Plugins\FolderNotePlugin;$(OutputPath)Plugins\QuickLaunchPlugin;$(OutputPath)Plugins\MacroPlugin;$(OutputPath)Plugins\ColorPickerPlugin;$(OutputPath)Plugins\ScreenshotPlugin;$(OutputPath)Plugins\WindowManagerPlugin" />
    <MakeDir Directories="$(OutputPath)Plugins\SamplePlugin;$(OutputPath)Plugins\FolderNotePlugin;$(OutputPath)Plugins\QuickLaunchPlugin;$(OutputPath)Plugins\MacroPlugin;$(OutputPath)Plugins\ColorPickerPlugin;$(OutputPath)Plugins\ScreenshotPlugin;$(OutputPath)Plugins\WindowManagerPlugin" />

    <Copy SourceFiles="$(RepoRoot)src\SamplePlugin\manifest.json" DestinationFolder="$(OutputPath)Plugins\SamplePlugin" />
    <Exec Command="if exist &quot;$(RepoRoot)src\SamplePlugin\bin\$(Configuration)\net8.0-windows\SamplePlugin.dll&quot; copy /Y &quot;$(RepoRoot)src\SamplePlugin\bin\$(Configuration)\net8.0-windows\SamplePlugin.dll&quot; &quot;$(OutputPath)Plugins\SamplePlugin\&quot; &gt; nul" />

    <Copy SourceFiles="$(RepoRoot)src\FolderNotePlugin\manifest.json" DestinationFolder="$(OutputPath)Plugins\FolderNotePlugin" />
    <Exec Command="if exist &quot;$(RepoRoot)src\FolderNotePlugin\bin\$(Configuration)\net8.0-windows\FolderNotePlugin.dll&quot; copy /Y &quot;$(RepoRoot)src\FolderNotePlugin\bin\$(Configuration)\net8.0-windows\FolderNotePlugin.dll&quot; &quot;$(OutputPath)Plugins\FolderNotePlugin\&quot; &gt; nul" />

    <Copy SourceFiles="$(RepoRoot)src\QuickLaunchPlugin\manifest.json" DestinationFolder="$(OutputPath)Plugins\QuickLaunchPlugin" />
    <Exec Command="if exist &quot;$(RepoRoot)src\QuickLaunchPlugin\bin\$(Configuration)\net8.0-windows\QuickLaunchPlugin.dll&quot; copy /Y &quot;$(RepoRoot)src\QuickLaunchPlugin\bin\$(Configuration)\net8.0-windows\QuickLaunchPlugin.dll&quot; &quot;$(OutputPath)Plugins\QuickLaunchPlugin\&quot; &gt; nul" />

    <Copy SourceFiles="$(RepoRoot)src\MacroPlugin\manifest.json" DestinationFolder="$(OutputPath)Plugins\MacroPlugin" />
    <Exec Command="if exist &quot;$(RepoRoot)src\MacroPlugin\bin\$(Configuration)\net8.0-windows\MacroPlugin.dll&quot; copy /Y &quot;$(RepoRoot)src\MacroPlugin\bin\$(Configuration)\net8.0-windows\MacroPlugin.dll&quot; &quot;$(OutputPath)Plugins\MacroPlugin\&quot; &gt; nul" />

    <Copy SourceFiles="$(RepoRoot)src\ColorPickerPlugin\manifest.json" DestinationFolder="$(OutputPath)Plugins\ColorPickerPlugin" />
    <Exec Command="if exist &quot;$(RepoRoot)src\ColorPickerPlugin\bin\$(Configuration)\net8.0-windows\ColorPickerPlugin.dll&quot; copy /Y &quot;$(RepoRoot)src\ColorPickerPlugin\bin\$(Configuration)\net8.0-windows\ColorPickerPlugin.dll&quot; &quot;$(OutputPath)Plugins\ColorPickerPlugin\&quot; &gt; nul" />

    <Copy SourceFiles="$(RepoRoot)src\ScreenshotPlugin\manifest.json" DestinationFolder="$(OutputPath)Plugins\ScreenshotPlugin" />
    <Exec Command="if exist &quot;$(RepoRoot)src\ScreenshotPlugin\bin\$(Configuration)\net8.0-windows\ScreenshotPlugin.dll&quot; copy /Y &quot;$(RepoRoot)src\ScreenshotPlugin\bin\$(Configuration)\net8.0-windows\ScreenshotPlugin.dll&quot; &quot;$(OutputPath)Plugins\ScreenshotPlugin\&quot; &gt; nul" />

    <Copy SourceFiles="$(RepoRoot)src\WindowManagerPlugin\manifest.json" DestinationFolder="$(OutputPath)Plugins\WindowManagerPlugin" />
    <Exec Command="if exist &quot;$(RepoRoot)src\WindowManagerPlugin\bin\$(Configuration)\net8.0-windows\WindowManagerPlugin.dll&quot; copy /Y &quot;$(RepoRoot)src\WindowManagerPlugin\bin\$(Configuration)\net8.0-windows\WindowManagerPlugin.dll&quot; &quot;$(OutputPath)Plugins\WindowManagerPlugin\&quot; &gt; nul" />

    <!-- Web 插件：robocopy 整个目录（排除 bin/obj） -->
    <Exec Command="robocopy &quot;$(RepoRoot)src\ClipboardTool&quot; &quot;$(OutputPath)Plugins\ClipboardTool&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\QuickNotePlugin&quot; &quot;$(OutputPath)Plugins\QuickNotePlugin&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\TranslatePlugin&quot; &quot;$(OutputPath)Plugins\TranslatePlugin&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\FileRenamerPlugin&quot; &quot;$(OutputPath)Plugins\FileRenamerPlugin&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\JsonFormatterPlugin&quot; &quot;$(OutputPath)Plugins\JsonFormatterPlugin&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\Base64Tool&quot; &quot;$(OutputPath)Plugins\Base64Tool&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\TextDiffPlugin&quot; &quot;$(OutputPath)Plugins\TextDiffPlugin&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\MarkdownPreview&quot; &quot;$(OutputPath)Plugins\MarkdownPreview&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\PasswordGenerator&quot; &quot;$(OutputPath)Plugins\PasswordGenerator&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\UrlToolkit&quot; &quot;$(OutputPath)Plugins\UrlToolkit&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\TimestampConverter&quot; &quot;$(OutputPath)Plugins\TimestampConverter&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\RegexTester&quot; &quot;$(OutputPath)Plugins\RegexTester&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
    <Exec Command="robocopy &quot;$(RepoRoot)src\UuidGenerator&quot; &quot;$(OutputPath)Plugins\UuidGenerator&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
  </Target>

  <!-- 发布宿主时补齐原生插件，并将完整插件集写入最终 PublishDir。 -->
  <Target Name="BuildNativePluginsForPublish" BeforeTargets="Publish">
    <MSBuild Projects="@(NativePluginProject)"
             Targets="Build"
             BuildInParallel="true"
             RemoveProperties="RuntimeIdentifier;SelfContained"
             Properties="Configuration=$(Configuration);BuildProjectReferences=false" />
  </Target>

  <Target Name="CopyPluginsToPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Plugins" />
    <Exec Command="robocopy &quot;$(OutputPath)Plugins&quot; &quot;$(PublishDir)Plugins&quot; /S /NJH /NJS /NDL /NFL &gt; nul || exit 0" />
  </Target>

</Project>
