<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Typography -->
    <FontFamily x:Key="Long.Font.Ui">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Long.Font.Mono">Cascadia Code, Consolas</FontFamily>
    <sys:Double x:Key="Long.Type.Display">26</sys:Double>
    <sys:Double x:Key="Long.Type.Title">19</sys:Double>
    <sys:Double x:Key="Long.Type.CardTitle">14</sys:Double>
    <sys:Double x:Key="Long.Type.Body">13</sys:Double>
    <sys:Double x:Key="Long.Type.Caption">11</sys:Double>
    <sys:Double x:Key="Long.Type.Badge">10</sys:Double>

    <!-- 4px spacing scale -->
    <Thickness x:Key="Long.Space.1">4</Thickness>
    <Thickness x:Key="Long.Space.2">8</Thickness>
    <Thickness x:Key="Long.Space.3">12</Thickness>
    <Thickness x:Key="Long.Space.4">16</Thickness>
    <Thickness x:Key="Long.Space.5">20</Thickness>
    <Thickness x:Key="Long.Space.6">24</Thickness>
    <Thickness x:Key="Long.Space.8">32</Thickness>
    <Thickness x:Key="Long.Space.10">40</Thickness>

    <!-- Shape -->
    <CornerRadius x:Key="Long.Radius.Badge">6</CornerRadius>
    <CornerRadius x:Key="Long.Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Long.Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Long.Radius.Flyout">18</CornerRadius>
    <CornerRadius x:Key="Long.Radius.Brand">24</CornerRadius>

    <!-- Motion. App replaces durations with zero when Windows reduces animation. -->
    <Duration x:Key="Long.Motion.Fast">0:0:0.10</Duration>
    <Duration x:Key="Long.Motion.Normal">0:0:0.18</Duration>
    <Duration x:Key="Long.Motion.Slow">0:0:0.28</Duration>
    <Duration x:Key="Long.Motion.Loading">0:0:1.20</Duration>
    <CubicEase x:Key="Long.Easing.Standard" EasingMode="EaseOut" />
    <CubicEase x:Key="Long.Easing.Emphasized" EasingMode="EaseInOut" />

    <!-- Elevation -->
    <DropShadowEffect x:Key="Long.Shadow.Level1" BlurRadius="14" ShadowDepth="3" Opacity="0.16" Color="#000000" />
    <DropShadowEffect x:Key="Long.Shadow.Level2" BlurRadius="24" ShadowDepth="7" Opacity="0.24" Color="#000000" />
    <DropShadowEffect x:Key="Long.Shadow.Level3" BlurRadius="38" ShadowDepth="12" Opacity="0.36" Color="#000000" />
</ResourceDictionary>
