<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- Buttons -->
    <Style x:Key="LongButton" TargetType="Button">
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{DynamicResource Long.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Long.Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Long.Type.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            CornerRadius="{DynamicResource Long.Radius.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Long.Brush.Stroke.Strong}" />
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Long.Brush.Surface.Pressed}" />
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Long.Brush.Focus}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.62" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LongButton.Primary" TargetType="Button" BasedOn="{StaticResource LongButton}">
        <Setter Property="Background" Value="{DynamicResource Long.Brush.Accent.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Long.Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Long.Brush.Accent.Pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LongButton.Danger" TargetType="Button" BasedOn="{StaticResource LongButton}">
        <Setter Property="Background" Value="{DynamicResource Long.Brush.State.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.State.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.OnAccent}" />
    </Style>

    <Style x:Key="LongIconButton" TargetType="Button" BasedOn="{StaticResource LongButton}">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Inputs -->
    <Style x:Key="LongTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource Long.Brush.Background.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Long.Brush.Accent.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Long.Brush.Accent.Soft}" />
        <Setter Property="FontFamily" Value="{DynamicResource Long.Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Long.Type.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            CornerRadius="{DynamicResource Long.Radius.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Long.Brush.Stroke.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Long.Brush.Focus}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LongTextBox.Error" TargetType="TextBox" BasedOn="{StaticResource LongTextBox}">
        <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.State.Danger}" />
    </Style>

    <Style x:Key="LongPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource Long.Brush.Background.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Long.Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Long.Type.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Chrome"
                            CornerRadius="{DynamicResource Long.Radius.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Long.Brush.Stroke.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource Long.Brush.Focus}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LongCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Long.Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Long.Type.Body}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="5"
                                Background="{DynamicResource Long.Brush.Background.Raised}"
                                BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                                BorderThickness="1">
                            <Path x:Name="Mark" Data="M 4,9 L 7.5,12.5 L 14,5.5"
                                  Stroke="{DynamicResource Long.Brush.Text.OnAccent}"
                                  StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Long.Brush.Stroke.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Long.Brush.Focus}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource Long.Brush.Accent.Primary}" />
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource Long.Brush.Accent.Primary}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background"
                                    Value="{DynamicResource Long.Brush.Accent.Soft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LongSearchBox" TargetType="TextBox" BasedOn="{StaticResource LongTextBox}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="LongComboBox" TargetType="ComboBox">
        <Style.Resources>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Background" Value="{DynamicResource Long.Brush.Background.Raised}" />
                <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Primary}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemChrome" Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemChrome" Property="Background"
                                            Value="{DynamicResource Long.Brush.Surface.Hover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemChrome" Property="Background"
                                            Value="{DynamicResource Long.Brush.Accent.Soft}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource Long.Brush.Background.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Long.Font.Ui}" />
        <Setter Property="FontSize" Value="{DynamicResource Long.Type.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="ComboRoot">
                        <ToggleButton x:Name="Toggle" ClickMode="Press" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome" Background="{DynamicResource Long.Brush.Background.Raised}"
                                            BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                                            BorderThickness="1" CornerRadius="{DynamicResource Long.Radius.Control}"
                                            Padding="12,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <ContentPresenter VerticalAlignment="Center"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                              RecognizesAccessKey="True" />
                                            <Path Grid.Column="1"
                                                  Data="{StaticResource Long.Icon.ChevronDown}"
                                                  Style="{StaticResource LongIcon}"
                                                  Width="13" Height="13"
                                                  Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush"
                                                    Value="{DynamicResource Long.Brush.Stroke.Strong}" />
                                            <Setter TargetName="Chrome" Property="Background"
                                                    Value="{DynamicResource Long.Brush.Surface.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush"
                                                    Value="{DynamicResource Long.Brush.Focus}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                            <Border Width="{Binding ActualWidth, ElementName=ComboRoot}" MaxHeight="300"
                                    Margin="0,4,0,0" Padding="5"
                                    Background="{DynamicResource Long.Brush.Surface.Overlay}"
                                    BorderBrush="{DynamicResource Long.Brush.Stroke.Strong}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Long.Radius.Control}"
                                    Effect="{DynamicResource Long.Shadow.Level2}">
                                <ScrollViewer Style="{StaticResource DarkScrollViewerStyle}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Toggle" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Surfaces -->
    <Style x:Key="LongCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Long.Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Long.Radius.Card}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{DynamicResource Long.Shadow.Level1}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Long.Brush.Surface.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.Stroke.Strong}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LongPluginCard" TargetType="Border" BasedOn="{StaticResource LongCard}">
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="Padding" Value="20,18" />
    </Style>

    <Style x:Key="LongCommandItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome"
                            CornerRadius="{DynamicResource Long.Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Long.Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Long.Brush.Accent.Soft}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Long.Brush.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Badges -->
    <Style x:Key="LongBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Long.Brush.Accent.Soft}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Long.Radius.Badge}" />
        <Setter Property="Padding" Value="7,3" />
    </Style>

    <Style x:Key="LongHotkeyBadge" TargetType="Border" BasedOn="{StaticResource LongBadge}">
        <Setter Property="Background" Value="{DynamicResource Long.Brush.Background.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.Stroke.Default}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Toggle -->
    <Style x:Key="LongToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="{DynamicResource Long.Brush.Stroke.Strong}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="12" Background="{TemplateBinding Background}">
                        <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="3"
                                 Fill="{DynamicResource Long.Brush.Text.OnAccent}"
                                 HorizontalAlignment="Left" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Long.Brush.Accent.Primary}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Long.Brush.Focus}" />
                            <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Feedback and navigation -->
    <Style x:Key="LongToast" TargetType="Border" BasedOn="{StaticResource LongCard}">
        <Setter Property="CornerRadius" Value="{DynamicResource Long.Radius.Flyout}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Effect" Value="{DynamicResource Long.Shadow.Level2}" />
    </Style>

    <Style x:Key="LongEmptyState" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Muted}" />
        <Setter Property="FontSize" Value="{DynamicResource Long.Type.Body}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="24" />
    </Style>

    <Style x:Key="LongLoadingState" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Accent.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Long.Brush.Accent.Soft}" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="Indicator" Width="120" HorizontalAlignment="Left"
                                Background="{DynamicResource Long.Brush.Accent.Gradient}" CornerRadius="2">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LoadingTranslate" X="-120" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoadingTranslate"
                                                         Storyboard.TargetProperty="X"
                                                         From="-120" To="720"
                                                         Duration="{StaticResource Long.Motion.Loading}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LongNavigationItem" TargetType="RadioButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Secondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" CornerRadius="{DynamicResource Long.Radius.Control}"
                            Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Long.Brush.Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Long.Brush.Accent.Soft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window/Dialog foundations -->
    <Style x:Key="LongWindowChrome" TargetType="Window">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Long.Font.Ui}" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="42" CornerRadius="14"
                                    GlassFrameThickness="0" ResizeBorderThickness="6"
                                    UseAeroCaptionButtons="True" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LongDialog" TargetType="Window" BasedOn="{StaticResource LongWindowChrome}">
        <Setter Property="Width" Value="480" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="WindowStartupLocation" Value="CenterOwner" />
    </Style>
</ResourceDictionary>
