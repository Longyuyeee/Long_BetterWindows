<Window x:Class="LongBetterWindows.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LongBetterWindows.Host.Views"
        Title="Long窗口·全能助手"
        MinWidth="440" MinHeight="360"
        Width="500" Height="560"
        WindowStartupLocation="CenterScreen"
        Opacity="0"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0"
                      CornerRadius="8" ResizeBorderThickness="4"
                      UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="8" Background="{StaticResource SurfaceBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource TitleBarBrush}">
                <Grid>
                    <TextBlock Text="Long窗口·全能助手"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>
            </Border>

            <!-- 标题栏底部分隔线 -->
            <Border Grid.Row="1" Background="{StaticResource DividerBrush}" />

            <!-- 内容区域 -->
            <views:ToolCenterControl Grid.Row="2" />
        </Grid>
    </Border>
</Window>
