<Window x:Class="LongBetterWindows.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LongBetterWindows.Host.Views"
        Title="Long窗口·全能助手"
        MinWidth="420" MinHeight="360"
        Width="500" Height="560"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" GlassFrameThickness="0"
                      CornerRadius="8" ResizeBorderThickness="4"
                      UseAeroCaptionButtons="True" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid Grid.Row="0" Background="#2D2D30">
            <TextBlock Text="Long窗口·全能助手"
                       Foreground="#CCCCCC" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <!-- 内容 -->
        <views:ToolCenterControl Grid.Row="1" />
    </Grid>
</Window>
