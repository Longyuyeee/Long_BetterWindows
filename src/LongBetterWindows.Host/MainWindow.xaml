<Window x:Class="LongBetterWindows.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LongBetterWindows.Host.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource i18n.app.title}"
        MinWidth="720" MinHeight="560"
        Width="1120" Height="760"
        Style="{StaticResource LongWindowChrome}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.AutomationId="Long.MainWindow"
        AutomationProperties.Name="{DynamicResource i18n.app.title}">

    <Border Background="{DynamicResource Long.Brush.Background.Base}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
            BorderThickness="1" CornerRadius="{DynamicResource Long.Radius.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Long.Brush.Background.Raised}"
                    BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                    BorderThickness="0,0,0,1" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="26" Height="26"
                               Source="/LongBetterWindows.Host;component/Assets/app-icon.png"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{DynamicResource i18n.app.brand}" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Long.Brush.Text.Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource i18n.app.management}" Margin="8,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button x:Name="WorkflowReviewCancelButton" Grid.Column="1"
                            Visibility="Collapsed" Style="{StaticResource LongButton}" Width="112" Height="30"
                            Margin="0,0,8,0" Click="CancelWorkflowReview_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="Long.Workflow.ReviewCancel"
                            AutomationProperties.Name="{DynamicResource i18n.workflow.topLevel.cancelReviewA11y}"
                            Content="{DynamicResource i18n.workflow.topLevel.cancelReview}" />

                    <Button x:Name="WorkflowTerminalApprovalButton" Grid.Column="2"
                            Visibility="Collapsed" Style="{StaticResource LongButton}" Width="126" Height="30"
                            Margin="0,0,8,0" Click="WorkflowTerminalApprovalButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="Long.Workflow.TerminalOutput.ApproveTopLevel"
                            Content="{DynamicResource i18n.workflow.topLevel.allowTerminal}" />

                    <Button x:Name="WorkflowReviewConfirmButton" Grid.Column="3"
                            Visibility="Collapsed" Style="{StaticResource LongButton.Primary}" Width="88" Height="30"
                            Margin="0,0,8,0" Click="ConfirmWorkflowReview_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="Long.Workflow.ReviewConfirmTopLevel"
                            AutomationProperties.Name="{DynamicResource i18n.workflow.topLevel.confirmRunA11y}"
                            Content="{DynamicResource i18n.workflow.topLevel.confirmRun}" />

                    <Button x:Name="WorkflowTerminalClearButton" Grid.Column="2"
                            Visibility="Collapsed" Style="{StaticResource LongButton}" Width="112" Height="30"
                            Margin="0,0,8,0" Click="ClearWorkflowTerminalOutputs_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="Long.Workflow.TerminalOutput.ClearTopLevel"
                            AutomationProperties.Name="{DynamicResource i18n.workflow.topLevel.clearTerminalA11y}"
                            ToolTip="{DynamicResource i18n.workflow.topLevel.clearTerminalTooltip}"
                            Content="{DynamicResource i18n.workflow.topLevel.clearTerminal}" />

                    <Button x:Name="OpenSuperPanelButton" Grid.Column="4" Style="{StaticResource LongIconButton}" Width="32" Height="30"
                            Margin="0,0,6,0" Click="OpenSuperPanel_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{DynamicResource i18n.app.openSuperPanel}"
                            AutomationProperties.Name="{DynamicResource i18n.app.openSuperPanel}">
                        <Path Data="{StaticResource Long.Icon.Command}" Style="{StaticResource LongIcon}" Width="14" Height="14" />
                    </Button>

                    <Button x:Name="OpenPaletteButton" Grid.Column="5" Style="{StaticResource LongButton}" Height="30" MinWidth="148"
                            Margin="0,0,10,0" Click="OpenPalette_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="{DynamicResource i18n.app.openCommandCenter}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Long.Icon.Search}" Style="{StaticResource LongIcon}" Width="14" Height="14" />
                            <TextBlock Text="{DynamicResource i18n.app.openCommandCenter}" Margin="7,0,12,0" FontSize="11" />
                            <Border Style="{StaticResource LongHotkeyBadge}">
                                <TextBlock Text="Alt Space" FontFamily="{DynamicResource Long.Font.Mono}" FontSize="9"
                                           Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="6" Style="{StaticResource LongIconButton}" Width="32" Height="30"
                            Margin="0,0,4,0" Click="Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="{DynamicResource i18n.app.minimize}">
                        <TextBlock Text="—" FontSize="14" />
                    </Button>
                    <Button Grid.Column="7" Style="{StaticResource LongIconButton}" Width="32" Height="30"
                            Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="{DynamicResource i18n.app.close}">
                        <Path Data="{StaticResource Long.Icon.Close}" Style="{StaticResource LongIcon}" Width="13" Height="13" />
                    </Button>
                </Grid>
            </Border>

            <views:WorkspaceShellControl x:Name="WorkspaceShell" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
