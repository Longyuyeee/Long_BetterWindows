<UserControl x:Class="LongBetterWindows.Host.Views.WorkflowEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Loaded="WorkflowEditorControl_Loaded"
             Unloaded="WorkflowEditorControl_Unloaded">
    <UserControl.Resources>
        <DataTemplate x:Key="WorkflowInvocationEditorTemplate">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RoleLabel}" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    <ComboBox Grid.Column="1" Style="{StaticResource LongComboBox}"
                              ItemsSource="{Binding InputOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding InputType}" SelectionChanged="InvocationInputType_SelectionChanged"
                              automation:AutomationProperties.Name="命令输入类型" />
                </Grid>
                <Grid Margin="100,8,0,0" Visibility="{Binding ShowText, Converter={StaticResource BooleanToVisibility}}">
                    <TextBox Style="{StaticResource LongTextBox}" Text="{Binding Text}" MaxLength="65536"
                             TextChanged="InvocationText_TextChanged" MinHeight="34" TextWrapping="Wrap"
                             automation:AutomationProperties.Name="命令文本输入" />
                </Grid>
                <StackPanel Margin="100,8,0,0" Visibility="{Binding ShowPaths, Converter={StaticResource BooleanToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Paths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="2,2" TextTrimming="CharacterEllipsis"
                                           FontFamily="{DynamicResource Long.Font.Mono}" FontSize="10"
                                           ToolTip="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Content="选择路径" Style="{StaticResource LongButton}" Tag="{Binding}"
                                Click="PickInvocationPaths_Click"
                                automation:AutomationProperties.Name="选择命令路径" />
                        <Button Content="清除" Style="{StaticResource LongButton}" Tag="{Binding}" Margin="7,0,0,0"
                                IsEnabled="{Binding HasPaths}" Click="ClearInvocationPaths_Click"
                                automation:AutomationProperties.Name="清除命令路径" />
                    </StackPanel>
                </StackPanel>
                <Grid Margin="100,8,0,0" Visibility="{Binding ShowImage, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ImageSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                    <Button Grid.Column="1" Content="选择 PNG" Style="{StaticResource LongButton}" Tag="{Binding}" Margin="8,0,0,0"
                            Click="PickInvocationImage_Click"
                            automation:AutomationProperties.Name="选择命令 PNG 图片" />
                    <Button Grid.Column="2" Content="清除" Style="{StaticResource LongButton}" Tag="{Binding}" Margin="7,0,0,0"
                            IsEnabled="{Binding HasImage}" Click="ClearInvocationImage_Click"
                            automation:AutomationProperties.Name="清除命令图片" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid MinHeight="600">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="WorkflowListColumn" Width="232" />
            <ColumnDefinition x:Name="WorkflowDividerColumn" Width="1" />
            <ColumnDefinition x:Name="WorkflowGapColumn" Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="本机工作流" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="WorkflowCountText" Text="0 项" Margin="0,3,0,0"
                               FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                </StackPanel>
                <Button x:Name="RefreshWorkflowButton" Grid.Column="1" Style="{StaticResource LongIconButton}" Margin="0,0,6,0"
                        Click="Refresh_Click" ToolTip="刷新工作流"
                        automation:AutomationProperties.Name="刷新工作流列表">
                    <Path Data="{StaticResource Long.Icon.Refresh}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
                <Button x:Name="ImportWorkflowButton" Grid.Column="2" Style="{StaticResource LongIconButton}" Margin="0,0,6,0"
                        Click="ImportWorkflow_Click" ToolTip="导入工作流"
                        automation:AutomationProperties.Name="导入外部工作流">
                    <Path Data="{StaticResource Long.Icon.Import}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
                <Button x:Name="NewWorkflowButton" Grid.Column="3" Style="{StaticResource LongIconButton}"
                        Click="NewWorkflow_Click" ToolTip="新建组合动作"
                        automation:AutomationProperties.Name="新建组合动作">
                    <Path Data="{StaticResource Long.Icon.Add}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
            </Grid>

            <ListBox x:Name="WorkflowList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     SelectionChanged="WorkflowList_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource LongCommandItem}">
                        <Setter Property="Margin" Value="0,0,0,5" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="10"
                                       Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                       Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ListStatusText" Grid.Row="2" Margin="2,10,2,0" FontSize="10"
                       TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource Long.Brush.Stroke.Default}" />

        <Grid Grid.Column="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="CompactWorkflowBar" Visibility="Collapsed" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="CompactWorkflowCombo" Style="{StaticResource LongComboBox}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="CompactWorkflowCombo_SelectionChanged"
                          automation:AutomationProperties.Name="选择本机工作流" />
                <Button x:Name="CompactRefreshButton" Grid.Column="1" Style="{StaticResource LongIconButton}" Margin="8,0,6,0"
                        Click="Refresh_Click" ToolTip="刷新工作流"
                        automation:AutomationProperties.Name="刷新工作流列表">
                    <Path Data="{StaticResource Long.Icon.Refresh}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
                <Button x:Name="CompactImportButton" Grid.Column="2" Style="{StaticResource LongIconButton}" Margin="0,0,6,0"
                        Click="ImportWorkflow_Click" ToolTip="导入工作流"
                        automation:AutomationProperties.Name="导入外部工作流">
                    <Path Data="{StaticResource Long.Icon.Import}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
                <Button x:Name="CompactNewButton" Grid.Column="3" Style="{StaticResource LongIconButton}"
                        Click="NewWorkflow_Click" ToolTip="新建组合动作"
                        automation:AutomationProperties.Name="新建组合动作">
                    <Path Data="{StaticResource Long.Icon.Add}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
            </Grid>

            <Border x:Name="ImportReviewPanel" Grid.Row="1" Visibility="Collapsed"
                    CornerRadius="{DynamicResource Long.Radius.Control}" Padding="16"
                    Background="{DynamicResource Long.Brush.Background.Raised}"
                    BorderBrush="{DynamicResource Long.Brush.Stroke.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="审查外部工作流" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="ImportReviewName" Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="ImportReviewSource" Margin="0,5,0,0" TextWrapping="Wrap"
                               FontFamily="{DynamicResource Long.Font.Mono}" FontSize="10"
                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                    <TextBlock x:Name="ImportReviewSummary" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="{DynamicResource Long.Radius.Control}"
                            Background="{DynamicResource Long.Brush.Accent.Soft}">
                        <StackPanel>
                            <TextBlock x:Name="ImportReviewTrust" FontWeight="SemiBold" />
                            <TextBlock x:Name="ImportReviewPreflight" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="取消" Style="{StaticResource LongButton}" Margin="0,0,8,0"
                                Click="CancelImport_Click" automation:AutomationProperties.Name="取消导入工作流" />
                        <Button Content="采用为草稿" Style="{StaticResource LongButton.Primary}"
                                Click="AdoptImport_Click" automation:AutomationProperties.Name="采用导入工作流为草稿" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid x:Name="EmptyEditor" Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                    <Path Data="{StaticResource Long.Icon.Command}" Style="{StaticResource LongIcon}"
                          Width="34" Height="34" HorizontalAlignment="Center" />
                    <TextBlock Text="选择或创建一个组合动作" Margin="0,14,0,0" FontSize="15"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="工作流只在本机保存，执行前仍会重新预检并要求批准。"
                               Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="EditorBody" Grid.Row="1" Visibility="Collapsed">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="EditorHeading" Text="组合动作" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="EditorDirtyText" Margin="0,4,0,0" FontSize="11"
                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PrepareRunButton" Style="{StaticResource LongButton}" Margin="0,0,8,0"
                                Click="PrepareRun_Click" automation:AutomationProperties.Name="准备执行组合动作">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Long.Icon.Play}" Style="{StaticResource LongIcon}" Width="16" Height="16" />
                                <TextBlock Text="准备执行" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteWorkflowButton" Style="{StaticResource LongIconButton}" Margin="0,0,8,0"
                                Click="DeleteWorkflow_Click" ToolTip="删除组合动作"
                                automation:AutomationProperties.Name="删除组合动作">
                            <Path Data="{StaticResource Long.Icon.Delete}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                        </Button>
                        <Button x:Name="SaveWorkflowButton" Style="{StaticResource LongButton.Primary}"
                                Click="SaveWorkflow_Click" automation:AutomationProperties.Name="保存组合动作">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Long.Icon.Save}" Style="{StaticResource LongIcon}"
                                      Stroke="{DynamicResource Long.Brush.Text.OnAccent}" Width="16" Height="16" />
                                <TextBlock Text="保存" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="工作流 ID" Margin="2,0,0,6" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <TextBox x:Name="WorkflowIdBox" Style="{StaticResource LongTextBox}" MaxLength="64"
                                 TextChanged="Identity_TextChanged" automation:AutomationProperties.Name="工作流 ID" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="名称" Margin="2,0,0,6" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <TextBox x:Name="WorkflowNameBox" Style="{StaticResource LongTextBox}" MaxLength="120"
                                 TextChanged="Identity_TextChanged" automation:AutomationProperties.Name="组合动作名称" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="失败策略" Margin="2,0,0,6" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <ComboBox x:Name="FailureModeCombo" Style="{StaticResource LongComboBox}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectionChanged="FailureMode_SelectionChanged"
                                  automation:AutomationProperties.Name="失败策略" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="添加命令步骤" Margin="2,0,0,6" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="AddCommandCombo" Style="{StaticResource LongComboBox}"
                                      DisplayMemberPath="Display" SelectedValuePath="Key"
                                      automation:AutomationProperties.Name="选择要添加的命令" />
                            <Button x:Name="AddStepButton" Grid.Column="1" Style="{StaticResource LongIconButton}" Margin="8,0,0,0"
                                    Click="AddStep_Click" ToolTip="添加步骤"
                                    automation:AutomationProperties.Name="添加命令步骤">
                                <Path Data="{StaticResource Long.Icon.Add}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <TextBlock Text="步骤" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                <ItemsControl x:Name="StepsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LongCard}" Effect="{x:Null}" Margin="0,0,0,8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Position}" VerticalAlignment="Center" FontFamily="{DynamicResource Long.Font.Mono}"
                                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    <ComboBox Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource LongComboBox}"
                                              ItemsSource="{Binding CommandOptions}" DisplayMemberPath="Display" SelectedValuePath="Key"
                                              SelectedValue="{Binding CommandKey}" SelectionChanged="StepCommand_SelectionChanged"
                                              automation:AutomationProperties.Name="步骤命令" />
                                    <ComboBox Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource LongComboBox}"
                                              ItemsSource="{Binding EffectOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Effect}" SelectionChanged="StepEffect_SelectionChanged"
                                              automation:AutomationProperties.Name="步骤类型" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Style="{StaticResource LongIconButton}" Margin="0,0,5,0" IsEnabled="{Binding CanMoveUp}"
                                                Tag="{Binding}" Click="MoveStepUp_Click" ToolTip="上移步骤"
                                                automation:AutomationProperties.Name="上移步骤">
                                            <Path Data="{StaticResource Long.Icon.ArrowUp}" Style="{StaticResource LongIcon}" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{StaticResource LongIconButton}" Margin="0,0,5,0" IsEnabled="{Binding CanMoveDown}"
                                                Tag="{Binding}" Click="MoveStepDown_Click" ToolTip="下移步骤"
                                                automation:AutomationProperties.Name="下移步骤">
                                            <Path Data="{StaticResource Long.Icon.ArrowDown}" Style="{StaticResource LongIcon}" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{StaticResource LongIconButton}" Tag="{Binding}" Click="RemoveStep_Click" ToolTip="删除步骤"
                                                automation:AutomationProperties.Name="删除步骤">
                                            <Path Data="{StaticResource Long.Icon.Delete}" Style="{StaticResource LongIcon}" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,9,0,0"
                                          Visibility="{Binding IsMutating, Converter={StaticResource BooleanToVisibility}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="补偿命令" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource LongComboBox}"
                                                  ItemsSource="{Binding CompensationOptions}" DisplayMemberPath="Display" SelectedValuePath="Key"
                                                  SelectedValue="{Binding CompensationKey}" SelectionChanged="StepCompensation_SelectionChanged"
                                                  automation:AutomationProperties.Name="步骤补偿命令" />
                                    </Grid>
                                    <ContentControl Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,9,0,0"
                                                    Content="{Binding PrimaryInput}"
                                                    ContentTemplate="{StaticResource WorkflowInvocationEditorTemplate}" />
                                    <ContentControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,9,0,0"
                                                    Visibility="{Binding HasCompensation, Converter={StaticResource BooleanToVisibility}}"
                                                    Content="{Binding CompensationInput}"
                                                    ContentTemplate="{StaticResource WorkflowInvocationEditorTemplate}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyStepsText" Text="尚未添加步骤" Margin="2,8,0,10"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                <Border x:Name="PreflightPanel" CornerRadius="{DynamicResource Long.Radius.Control}"
                        Padding="12,10" Margin="0,6,0,0" Background="{DynamicResource Long.Brush.Background.Raised}"
                        BorderBrush="{DynamicResource Long.Brush.Stroke.Default}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="PreflightTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="PreflightDetail" Margin="0,4,0,0" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <CheckBox x:Name="SensitiveInputCheckBox" Content="允许将潜在敏感输入保存到本机文件"
                                  Margin="0,9,0,0" Visibility="Collapsed"
                                  automation:AutomationProperties.Name="允许保存敏感输入" />
                    </StackPanel>
                </Border>

                <Border x:Name="ExecutionReviewPanel" Visibility="Collapsed" Margin="0,10,0,0"
                        CornerRadius="{DynamicResource Long.Radius.Control}" Padding="12"
                        Background="{DynamicResource Long.Brush.Accent.Soft}"
                        BorderBrush="{DynamicResource Long.Brush.Focus}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="确认本次执行权限" FontWeight="SemiBold" />
                        <TextBlock x:Name="ExecutionReviewSummary" Margin="0,5,0,8" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <ItemsControl x:Name="ExecutionPermissionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Plugin}" FontFamily="{DynamicResource Long.Font.Mono}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Capabilities}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="取消" Style="{StaticResource LongButton}" Margin="0,0,8,0"
                                    Click="CancelRunReview_Click" automation:AutomationProperties.Name="取消执行确认" />
                            <Button Content="确认并执行" Style="{StaticResource LongButton.Primary}"
                                    Click="ConfirmRun_Click" automation:AutomationProperties.Name="确认并执行组合动作" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ExecutionRunningPanel" Visibility="Collapsed" Margin="0,10,0,0"
                        CornerRadius="{DynamicResource Long.Radius.Control}" Padding="12"
                        Background="{DynamicResource Long.Brush.Background.Raised}"
                        BorderBrush="{DynamicResource Long.Brush.Stroke.Default}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="正在执行" FontWeight="SemiBold" />
                            <TextBlock Text="命令按顺序运行；取消后仍会按失败策略尝试补偿。" Margin="0,4,12,0"
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="取消执行" Style="{StaticResource LongButton}"
                                Click="CancelExecution_Click" automation:AutomationProperties.Name="取消正在运行的组合动作" />
                    </Grid>
                </Border>

                <Border x:Name="ExecutionResultPanel" Visibility="Collapsed" Margin="0,10,0,0"
                        CornerRadius="{DynamicResource Long.Radius.Control}" Padding="12"
                        Background="{DynamicResource Long.Brush.Background.Raised}"
                        BorderBrush="{DynamicResource Long.Brush.Stroke.Default}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="ExecutionResultTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="ExecutionResultDetail" Margin="0,4,0,0" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    </StackPanel>
                </Border>

                <Expander x:Name="ReportsExpander" Header="执行记录" Margin="0,14,0,0" IsExpanded="False">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="1"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="ReportList" MaxHeight="220" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="ReportList_SelectionChanged"
                                 automation:AutomationProperties.Name="执行报告列表">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource LongCommandItem}">
                                    <Setter Property="Margin" Value="0,0,0,5" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="10"
                                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="1" Background="{DynamicResource Long.Brush.Stroke.Default}" />
                        <StackPanel Grid.Column="3">
                            <TextBlock x:Name="ReportDetailTitle" Text="选择一条执行记录" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReportDetailMeta" Margin="0,4,0,8" FontSize="10"
                                       Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                            <ItemsControl x:Name="ReportTimeline">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" FontFamily="{DynamicResource Long.Font.Mono}" FontSize="10"
                                                       Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11" />
                                            <TextBlock Grid.Column="2" Text="{Binding Step}" FontSize="11"
                                                       Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Expander>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
