<UserControl x:Class="LongBetterWindows.Host.Views.WorkflowEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LongBetterWindows.Host.Views"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.AutomationId="Long.Workflow.Editor"
             automation:AutomationProperties.Name="{DynamicResource i18n.workflow.editor.name}"
             Loaded="WorkflowEditorControl_Loaded"
             Unloaded="WorkflowEditorControl_Unloaded">
    <Grid MinHeight="600">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="WorkflowListColumn" Width="232" />
            <ColumnDefinition x:Name="WorkflowDividerColumn" Width="1" />
            <ColumnDefinition x:Name="WorkflowGapColumn" Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              automation:AutomationProperties.AutomationId="Long.Workflow.WideNavigation"
              automation:AutomationProperties.Name="{DynamicResource i18n.workflow.editor.wideNavigation}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource i18n.workflow.local.title}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="WorkflowCountText" Text="{DynamicResource i18n.workflow.local.emptyCount}" Margin="0,3,0,0"
                               FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                </StackPanel>
                <Button x:Name="RefreshWorkflowButton" Grid.Column="1" Style="{StaticResource LongIconButton}" Margin="0,0,6,0"
                        Click="Refresh_Click" ToolTip="{DynamicResource i18n.workflow.action.refresh}"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.refreshList}">
                    <Path Data="{StaticResource Long.Icon.Refresh}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
                <Button x:Name="ImportWorkflowButton" Grid.Column="2" Style="{StaticResource LongIconButton}" Margin="0,0,6,0"
                        Click="ImportWorkflow_Click" ToolTip="{DynamicResource i18n.workflow.action.import}"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.importExternal}">
                    <Path Data="{StaticResource Long.Icon.Import}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
                <Button x:Name="TemplateWorkflowButton" Grid.Column="3" Style="{StaticResource LongIconButton}" Margin="0,0,6,0"
                        Click="TemplateWorkflow_Click" ToolTip="{DynamicResource i18n.workflow.action.fromTemplate}"
                        automation:AutomationProperties.AutomationId="Long.Workflow.Templates"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.chooseTemplate}">
                    <Path Data="{StaticResource Long.Icon.Sparkle}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
                <Button x:Name="NewWorkflowButton" Grid.Column="4" Style="{StaticResource LongIconButton}"
                        Click="NewWorkflow_Click" ToolTip="{DynamicResource i18n.workflow.action.new}"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.new}">
                    <Path Data="{StaticResource Long.Icon.Add}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
            </Grid>

            <ListBox x:Name="WorkflowList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     automation:AutomationProperties.AutomationId="Long.Workflow.List"
                     automation:AutomationProperties.Name="{DynamicResource i18n.workflow.local.list}"
                     SelectionChanged="WorkflowList_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource LongCommandItem}">
                        <Setter Property="Margin" Value="0,0,0,5" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="10"
                                       Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                       Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ListStatusText" Grid.Row="2" Margin="2,10,2,0" FontSize="10"
                       TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource Long.Brush.Stroke.Default}" />

        <Grid Grid.Column="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="CompactWorkflowBar" Visibility="Collapsed" Margin="0,0,0,14"
                  automation:AutomationProperties.AutomationId="Long.Workflow.CompactNavigation"
                  automation:AutomationProperties.Name="{DynamicResource i18n.workflow.editor.compactNavigation}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="CompactWorkflowCombo" Style="{StaticResource LongComboBox}"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="CompactWorkflowCombo_SelectionChanged"
                          automation:AutomationProperties.Name="{DynamicResource i18n.workflow.local.choose}" />
                <Button x:Name="CompactRefreshButton" Grid.Column="1" Style="{StaticResource LongIconButton}" Margin="8,0,6,0"
                        Click="Refresh_Click" ToolTip="{DynamicResource i18n.workflow.action.refresh}"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.refreshList}">
                    <Path Data="{StaticResource Long.Icon.Refresh}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
                <Button x:Name="CompactImportButton" Grid.Column="2" Style="{StaticResource LongIconButton}" Margin="0,0,6,0"
                        Click="ImportWorkflow_Click" ToolTip="{DynamicResource i18n.workflow.action.import}"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.importExternal}">
                    <Path Data="{StaticResource Long.Icon.Import}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
                <Button x:Name="CompactTemplateButton" Grid.Column="3" Style="{StaticResource LongIconButton}" Margin="0,0,6,0"
                        Click="TemplateWorkflow_Click" ToolTip="{DynamicResource i18n.workflow.action.fromTemplate}"
                        automation:AutomationProperties.AutomationId="Long.Workflow.Templates.Compact"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.chooseTemplate}">
                    <Path Data="{StaticResource Long.Icon.Sparkle}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
                <Button x:Name="CompactNewButton" Grid.Column="4" Style="{StaticResource LongIconButton}"
                        Click="NewWorkflow_Click" ToolTip="{DynamicResource i18n.workflow.action.new}"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.new}">
                    <Path Data="{StaticResource Long.Icon.Add}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                </Button>
            </Grid>

            <Border x:Name="ImportReviewPanel" Grid.Row="1" Visibility="Collapsed"
                    CornerRadius="{DynamicResource Long.Radius.Control}" Padding="16"
                    Background="{DynamicResource Long.Brush.Background.Raised}"
                    BorderBrush="{DynamicResource Long.Brush.Stroke.Default}" BorderThickness="1"
                    automation:AutomationProperties.AutomationId="Long.Workflow.ImportReview"
                    automation:AutomationProperties.Name="{DynamicResource i18n.workflow.import.reviewExternal}">
                <StackPanel>
                    <TextBlock x:Name="ImportReviewHeading" Text="{DynamicResource i18n.workflow.import.reviewExternal}"
                               FontSize="17" FontWeight="SemiBold"
                               automation:AutomationProperties.AutomationId="Long.Workflow.ImportReview.Title" />
                    <TextBlock x:Name="ImportReviewName" Margin="0,12,0,0" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="ImportReviewSource" Margin="0,5,0,0" TextWrapping="Wrap"
                               FontFamily="{DynamicResource Long.Font.Mono}" FontSize="10"
                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                    <TextBlock x:Name="ImportReviewSummary" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="{DynamicResource Long.Radius.Control}"
                            Background="{DynamicResource Long.Brush.Accent.Soft}">
                        <StackPanel>
                            <TextBlock x:Name="ImportReviewTrust" FontWeight="SemiBold" />
                            <TextBlock x:Name="ImportReviewPreflight" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="{DynamicResource i18n.action.cancel}" Style="{StaticResource LongButton}" Margin="0,0,8,0"
                                Click="CancelImport_Click" automation:AutomationProperties.Name="{DynamicResource i18n.workflow.import.cancel}" />
                        <Button Content="{DynamicResource i18n.workflow.import.adoptDraft}" Style="{StaticResource LongButton.Primary}"
                                Click="AdoptImport_Click" automation:AutomationProperties.Name="{DynamicResource i18n.workflow.import.adoptDraft}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid x:Name="EmptyEditor" Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                    <Path Data="{StaticResource Long.Icon.Command}" Style="{StaticResource LongIcon}"
                          Width="34" Height="34" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource i18n.workflow.empty.title}" Margin="0,14,0,0" FontSize="15"
                               FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource i18n.workflow.empty.desc}"
                               Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="EditorBody" Grid.Row="1" Visibility="Collapsed">
                <StackPanel x:Name="EditorConfigurationPanel">
                <Grid x:Name="EditorHeaderGrid" Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="EditorHeading" Text="{DynamicResource i18n.workflow.editor.heading}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="EditorDirtyText" Margin="0,4,0,0" FontSize="11"
                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                    </StackPanel>
                    <StackPanel x:Name="EditorHeaderActions" Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PrepareRunButton" Style="{StaticResource LongButton}" Margin="0,0,8,0"
                                automation:AutomationProperties.AutomationId="Long.Workflow.PrepareRun"
                                Click="PrepareRun_Click" automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.prepareRun}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Long.Icon.Play}" Style="{StaticResource LongIcon}" Width="16" Height="16" />
                                <TextBlock Text="{DynamicResource i18n.workflow.action.prepareRunShort}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportWorkflowButton" Style="{StaticResource LongIconButton}" Margin="0,0,8,0"
                                Click="ExportWorkflow_Click" ToolTip="{DynamicResource i18n.workflow.action.export}"
                                automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.export}">
                            <Path Data="{StaticResource Long.Icon.Export}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                        </Button>
                        <Button x:Name="DuplicateWorkflowButton" Style="{StaticResource LongIconButton}" Margin="0,0,8,0"
                                Click="DuplicateWorkflow_Click" ToolTip="{DynamicResource i18n.workflow.action.duplicate}"
                                automation:AutomationProperties.AutomationId="Long.Workflow.Duplicate"
                                automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.duplicate}">
                            <Path Data="{StaticResource Long.Icon.Copy}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                        </Button>
                        <Button x:Name="DeleteWorkflowButton" Style="{StaticResource LongIconButton}" Margin="0,0,8,0"
                                Click="DeleteWorkflow_Click" ToolTip="{DynamicResource i18n.workflow.action.delete}"
                                automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.delete}">
                            <Path Data="{StaticResource Long.Icon.Delete}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                        </Button>
                        <Button x:Name="SaveWorkflowButton" Style="{StaticResource LongButton.Primary}"
                                Click="SaveWorkflow_Click" automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.save}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Long.Icon.Save}" Style="{StaticResource LongIcon}"
                                      Stroke="{DynamicResource Long.Brush.Text.OnAccent}" Width="16" Height="16" />
                                <TextBlock Text="{DynamicResource i18n.action.save}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource i18n.workflow.field.id}" Margin="2,0,0,6" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <TextBox x:Name="WorkflowIdBox" Style="{StaticResource LongTextBox}" MaxLength="64"
                                 TextChanged="Identity_TextChanged"
                                 automation:AutomationProperties.AutomationId="Long.Workflow.Id"
                                 automation:AutomationProperties.Name="{DynamicResource i18n.workflow.field.id}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource i18n.workflow.field.name}" Margin="2,0,0,6" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <TextBox x:Name="WorkflowNameBox" Style="{StaticResource LongTextBox}" MaxLength="120"
                                 TextChanged="Identity_TextChanged"
                                 automation:AutomationProperties.AutomationId="Long.Workflow.Name"
                                 automation:AutomationProperties.Name="{DynamicResource i18n.workflow.field.nameA11y}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource i18n.workflow.field.failureMode}" Margin="2,0,0,6" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <ComboBox x:Name="FailureModeCombo" Style="{StaticResource LongComboBox}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectionChanged="FailureMode_SelectionChanged"
                                  automation:AutomationProperties.Name="{DynamicResource i18n.workflow.field.failureMode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource i18n.workflow.field.addCommand}" Margin="2,0,0,6" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="AddCommandCombo" Style="{StaticResource LongComboBox}"
                                      DisplayMemberPath="Display" SelectedValuePath="Key"
                                      automation:AutomationProperties.Name="{DynamicResource i18n.workflow.field.chooseCommand}" />
                            <Button x:Name="AddStepButton" Grid.Column="1" Style="{StaticResource LongIconButton}" Margin="8,0,0,0"
                                    Click="AddStep_Click" ToolTip="{DynamicResource i18n.workflow.action.addStep}"
                                    automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.addStep}">
                                <Path Data="{StaticResource Long.Icon.Add}" Style="{StaticResource LongIcon}" Width="17" Height="17" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource i18n.workflow.steps.title}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                <ItemsControl x:Name="StepsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LongCard}" Effect="{x:Null}" Margin="0,0,0,8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Position}" VerticalAlignment="Center" FontFamily="{DynamicResource Long.Font.Mono}"
                                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    <ComboBox Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource LongComboBox}"
                                              ItemsSource="{Binding CommandOptions}" DisplayMemberPath="Display" SelectedValuePath="Key"
                                              SelectedValue="{Binding CommandKey}" SelectionChanged="StepCommand_SelectionChanged"
                                              automation:AutomationProperties.Name="{DynamicResource i18n.workflow.step.command}" />
                                    <ComboBox Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource LongComboBox}"
                                              ItemsSource="{Binding EffectOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Effect}" SelectionChanged="StepEffect_SelectionChanged"
                                              automation:AutomationProperties.Name="{DynamicResource i18n.workflow.step.effect}" />
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Style="{StaticResource LongIconButton}" Margin="0,0,5,0" IsEnabled="{Binding CanMoveUp}"
                                                Tag="{Binding}" Click="MoveStepUp_Click" ToolTip="{DynamicResource i18n.workflow.action.moveUp}"
                                                automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.moveUp}">
                                            <Path Data="{StaticResource Long.Icon.ArrowUp}" Style="{StaticResource LongIcon}" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{StaticResource LongIconButton}" Margin="0,0,5,0" IsEnabled="{Binding CanMoveDown}"
                                                Tag="{Binding}" Click="MoveStepDown_Click" ToolTip="{DynamicResource i18n.workflow.action.moveDown}"
                                                automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.moveDown}">
                                            <Path Data="{StaticResource Long.Icon.ArrowDown}" Style="{StaticResource LongIcon}" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{StaticResource LongIconButton}" Tag="{Binding}" Click="RemoveStep_Click" ToolTip="{DynamicResource i18n.workflow.action.removeStep}"
                                                automation:AutomationProperties.Name="{DynamicResource i18n.workflow.action.removeStep}">
                                            <Path Data="{StaticResource Long.Icon.Delete}" Style="{StaticResource LongIcon}" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,9,0,0"
                                          Visibility="{Binding IsMutating, Converter={StaticResource BooleanToVisibility}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource i18n.workflow.step.compensation}" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource LongComboBox}"
                                                  ItemsSource="{Binding CompensationOptions}" DisplayMemberPath="Display" SelectedValuePath="Key"
                                                  SelectedValue="{Binding CompensationKey}" SelectionChanged="StepCompensation_SelectionChanged"
                                                  automation:AutomationProperties.Name="{DynamicResource i18n.workflow.step.compensationA11y}" />
                                    </Grid>
                                    <views:WorkflowInvocationEditorControl Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,9,0,0"
                                                                           Editor="{Binding PrimaryInput}"
                                                                           automation:AutomationProperties.AutomationId="Long.Workflow.Invocation.Primary"
                                                                           InvocationChanged="InvocationEditor_Changed" />
                                    <views:WorkflowInvocationEditorControl Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,9,0,0"
                                                                           Visibility="{Binding HasCompensation, Converter={StaticResource BooleanToVisibility}}"
                                                                           Editor="{Binding CompensationInput}"
                                                                           InvocationChanged="InvocationEditor_Changed" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyStepsText" Text="{DynamicResource i18n.workflow.steps.empty}" Margin="2,8,0,10"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                <Border x:Name="PreflightPanel" CornerRadius="{DynamicResource Long.Radius.Control}"
                        Padding="12,10" Margin="0,6,0,0" Background="{DynamicResource Long.Brush.Background.Raised}"
                        BorderBrush="{DynamicResource Long.Brush.Stroke.Default}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="PreflightTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="PreflightDetail" Margin="0,4,0,0" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <CheckBox x:Name="SensitiveInputCheckBox" Content="{DynamicResource i18n.workflow.sensitive.allowSave}"
                                  Margin="0,9,0,0" Visibility="Collapsed"
                                  automation:AutomationProperties.Name="{DynamicResource i18n.workflow.sensitive.allowSaveA11y}" />
                    </StackPanel>
                </Border>

                </StackPanel>

                <Border x:Name="ExecutionReviewPanel" Visibility="Collapsed" Margin="0,10,0,0"
                        automation:AutomationProperties.AutomationId="Long.Workflow.ExecutionReview"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.execution.review.name}"
                        CornerRadius="{DynamicResource Long.Radius.Control}" Padding="12"
                        Background="{DynamicResource Long.Brush.Accent.Soft}"
                        BorderBrush="{DynamicResource Long.Brush.Focus}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource i18n.workflow.execution.review.title}" FontWeight="SemiBold" />
                        <TextBlock x:Name="ExecutionReviewSummary" Margin="0,5,0,8" TextWrapping="Wrap"
                                   automation:AutomationProperties.AutomationId="Long.Workflow.ExecutionReview.Summary"
                                   FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <ItemsControl x:Name="ExecutionPermissionList"
                                      automation:AutomationProperties.Name="{DynamicResource i18n.workflow.execution.review.permissions}">
                            <automation:AutomationProperties.AutomationId>Long.Workflow.ExecutionReview.Permissions</automation:AutomationProperties.AutomationId>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Plugin}" FontFamily="{DynamicResource Long.Font.Mono}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Capabilities}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox x:Name="TerminalOutputApprovalCheckBox"
                                  automation:AutomationProperties.AutomationId="Long.Workflow.ExecutionReview.TerminalOutput"
                                  Content="{DynamicResource i18n.workflow.execution.review.terminalApproval}"
                                  Margin="0,9,0,0"
                                  automation:AutomationProperties.Name="{DynamicResource i18n.workflow.execution.review.terminalApprovalA11y}" />
                        <TextBlock Text="{DynamicResource i18n.workflow.execution.review.terminalHelp}"
                                   Margin="24,3,0,0" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="CancelRunReviewButton" Content="{DynamicResource i18n.workflow.execution.review.cancel}" Style="{StaticResource LongButton}" Margin="0,0,8,0"
                                    automation:AutomationProperties.AutomationId="Long.Workflow.ExecutionReview.Cancel"
                                    Click="CancelRunReview_Click" automation:AutomationProperties.Name="{DynamicResource i18n.workflow.execution.review.cancelA11y}" />
                            <Button Content="{DynamicResource i18n.workflow.execution.review.confirm}" Style="{StaticResource LongButton.Primary}"
                                    automation:AutomationProperties.AutomationId="Long.Workflow.ExecutionReview.Confirm"
                                    Click="ConfirmRun_Click" automation:AutomationProperties.Name="{DynamicResource i18n.workflow.execution.review.confirmA11y}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ExecutionRunningPanel" Visibility="Collapsed" Margin="0,10,0,0"
                        automation:AutomationProperties.AutomationId="Long.Workflow.ExecutionRunning"
                        CornerRadius="{DynamicResource Long.Radius.Control}" Padding="12"
                        Background="{DynamicResource Long.Brush.Background.Raised}"
                        BorderBrush="{DynamicResource Long.Brush.Stroke.Default}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource i18n.workflow.execution.running.title}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource i18n.workflow.execution.running.detail}" Margin="0,4,12,0"
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource i18n.workflow.execution.running.cancel}" Style="{StaticResource LongButton}"
                                Click="CancelExecution_Click" automation:AutomationProperties.Name="{DynamicResource i18n.workflow.execution.running.cancelA11y}" />
                    </Grid>
                </Border>

                <Border x:Name="ExecutionResultPanel" Visibility="Collapsed" Margin="0,10,0,0"
                        automation:AutomationProperties.AutomationId="Long.Workflow.ExecutionResult"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.execution.result.name}"
                        CornerRadius="{DynamicResource Long.Radius.Control}" Padding="12"
                        Background="{DynamicResource Long.Brush.Background.Raised}"
                        BorderBrush="{DynamicResource Long.Brush.Stroke.Default}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="ExecutionResultTitle" FontWeight="SemiBold"
                                   automation:AutomationProperties.AutomationId="Long.Workflow.ExecutionResult.Title" />
                        <TextBlock x:Name="ExecutionResultDetail" Margin="0,4,0,0" FontSize="11"
                                   automation:AutomationProperties.AutomationId="Long.Workflow.ExecutionResult.Detail"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        <ItemsControl x:Name="ExecutionOutputList" Margin="0,8,0,0" Visibility="Collapsed"
                                      automation:AutomationProperties.Name="{DynamicResource i18n.workflow.execution.result.outputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Step}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Output}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{DynamicResource Long.Font.Mono}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="10"
                                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="TerminalOutputPanel" Margin="0,12,0,0" Visibility="Collapsed"
                                    automation:AutomationProperties.AutomationId="Long.Workflow.TerminalOutput">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource i18n.workflow.terminal.title}" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Content="{DynamicResource i18n.workflow.terminal.clear}" Style="{StaticResource LongButton}"
                                        Padding="8,3" Click="ClearTerminalOutputs_Click"
                                        automation:AutomationProperties.AutomationId="Long.Workflow.TerminalOutput.Clear"
                                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.terminal.clearA11y}" />
                            </Grid>
                            <ItemsControl x:Name="TerminalOutputList" Margin="0,6,0,0"
                                          automation:AutomationProperties.Name="{DynamicResource i18n.workflow.terminal.list}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Detail}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,3">
                                                <Button Content="{DynamicResource i18n.workflow.terminal.copy}" Tag="{Binding}" Padding="8,3"
                                                        Style="{StaticResource LongButton}"
                                                        Click="CopyTerminalOutput_Click"
                                                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.terminal.copyA11y}" />
                                                <Button Content="{DynamicResource i18n.workflow.terminal.export}" Tag="{Binding}" Margin="6,0,0,0" Padding="8,3"
                                                        Style="{StaticResource LongButton}"
                                                        Click="ExportTerminalOutput_Click"
                                                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.terminal.exportA11y}" />
                                            </StackPanel>
                                            <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                                     automation:AutomationProperties.AutomationId="Long.Workflow.TerminalOutput.Value"
                                                     automation:AutomationProperties.Name="{DynamicResource i18n.workflow.terminal.valueA11y}"
                                                     MaxHeight="120" TextWrapping="Wrap" AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Expander x:Name="ReportsExpander" Header="{DynamicResource i18n.workflow.reports.title}" Margin="0,14,0,0" IsExpanded="False">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="1"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ListBox x:Name="ReportList" MaxHeight="220" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="ReportList_SelectionChanged"
                                 automation:AutomationProperties.Name="{DynamicResource i18n.workflow.reports.list}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource LongCommandItem}">
                                    <Setter Property="Margin" Value="0,0,0,5" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="10"
                                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="1" Background="{DynamicResource Long.Brush.Stroke.Default}" />
                        <StackPanel Grid.Column="3">
                            <TextBlock x:Name="ReportDetailTitle" Text="{DynamicResource i18n.workflow.reports.select}" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReportDetailMeta" Margin="0,4,0,8" FontSize="10"
                                       Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                            <ItemsControl x:Name="ReportTimeline">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" FontFamily="{DynamicResource Long.Font.Mono}" FontSize="10"
                                                       Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11" />
                                            <TextBlock Grid.Column="2" Text="{Binding Step}" FontSize="11"
                                                       Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Expander>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
