<UserControl x:Class="LongBetterWindows.Host.Views.MarketPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部搜索栏 -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,16" CornerRadius="12,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 搜索框 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Height="40">
                        <Grid>
                            <TextBlock Text="🔍 搜索插件..."
                                     Foreground="#64748B"
                                     VerticalAlignment="Center"
                                     Margin="12,0"
                                     x:Name="SearchPlaceholder"/>
                            <TextBox x:Name="SearchBox"
                                   Background="Transparent"
                                   Foreground="#F8FAFC"
                                   BorderThickness="0"
                                   VerticalContentAlignment="Center"
                                   Padding="12,0"
                                   FontSize="14"
                                   TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="1" Content="🔄 刷新"
                          Width="80" Height="40"
                          Margin="12,0,0,0"
                          Background="#334155"
                          Foreground="#F8FAFC"
                          BorderThickness="0"
                          Cursor="Hand"
                          FontSize="13"
                          Click="RefreshButton_Click"/>
                </Grid>

                <!-- 分类标签 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" x:Name="CategoryPanel">
                    <!-- 动态生成分类按钮 -->
                </StackPanel>
            </Grid>
        </Border>

        <!-- 插件列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 精选插件区域 -->
                <StackPanel Grid.Row="0" x:Name="FeaturedSection" Margin="0,0,0,20">
                    <TextBlock Text="⭐ 精选推荐"
                             Foreground="#F8FAFC"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Margin="0,0,0,12"/>
                    <WrapPanel x:Name="FeaturedPluginsPanel"/>
                </StackPanel>

                <!-- 所有插件区域 -->
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="AllPluginsHeader"
                             Text="📦 所有插件"
                             Foreground="#F8FAFC"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Margin="0,0,0,12"/>
                    <WrapPanel x:Name="PluginsPanel"/>

                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyState"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="0,100">
                        <TextBlock Text="🔍" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="未找到匹配的插件"
                                 Foreground="#64748B"
                                 FontSize="16"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 加载指示器 -->
        <Border x:Name="LoadingOverlay"
                Grid.RowSpan="2"
                Background="#80000000"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="加载中..."
                         Foreground="#F8FAFC"
                         FontSize="16"
                         Margin="0,12,0,0"
                         HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
