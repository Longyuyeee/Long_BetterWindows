<UserControl x:Class="LongBetterWindows.Host.Views.WorkflowInvocationEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <StackPanel DataContext="{Binding Editor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding RoleLabel}" VerticalAlignment="Center" FontSize="11"
                       Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
            <ComboBox Grid.Column="1" Style="{StaticResource LongComboBox}"
                      ItemsSource="{Binding InputOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding InputType}" SelectionChanged="InputType_SelectionChanged"
                      automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.inputType}" />
        </Grid>
        <Grid Margin="100,8,0,0" Visibility="{Binding ShowText, Converter={StaticResource BooleanToVisibility}}">
            <TextBox Style="{StaticResource LongTextBox}" Text="{Binding Text}" MaxLength="65536"
                     TextChanged="Text_TextChanged" MinHeight="34" TextWrapping="Wrap"
                     automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.textInput}" />
        </Grid>
        <StackPanel Margin="100,8,0,0" Visibility="{Binding ShowPaths, Converter={StaticResource BooleanToVisibility}}">
            <ItemsControl ItemsSource="{Binding Paths}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Margin="2,2" TextTrimming="CharacterEllipsis"
                                   FontFamily="{DynamicResource Long.Font.Mono}" FontSize="10"
                                   ToolTip="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Button Content="{DynamicResource i18n.workflow.invocation.choosePath}" Style="{StaticResource LongButton}" Click="PickPaths_Click"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.chooseCommandPath}" />
                <Button Content="{DynamicResource i18n.action.clear}" Style="{StaticResource LongButton}" Margin="7,0,0,0"
                        IsEnabled="{Binding HasPaths}" Click="ClearPaths_Click"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.clearPath}" />
            </StackPanel>
        </StackPanel>
        <Grid Margin="100,8,0,0" Visibility="{Binding ShowImage, Converter={StaticResource BooleanToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ImageSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
            <Button Grid.Column="1" Content="{DynamicResource i18n.workflow.invocation.choosePng}" Style="{StaticResource LongButton}" Margin="8,0,0,0"
                    Click="PickImage_Click" automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.chooseCommandPng}" />
            <Button Grid.Column="2" Content="{DynamicResource i18n.action.clear}" Style="{StaticResource LongButton}" Margin="7,0,0,0"
                    IsEnabled="{Binding HasImage}" Click="ClearImage_Click"
                    automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.clearImage}" />
        </Grid>
        <Expander Margin="100,8,0,0"
                  IsExpanded="{Binding UsesArgumentSchema, Mode=OneWay}">
            <Expander.Header>
                <TextBlock Text="{Binding ArgumentSummary}" FontSize="11"
                           Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
            </Expander.Header>
            <StackPanel Margin="0,7,0,0">
                <Grid Margin="0,0,0,8"
                      Visibility="{Binding HasArgumentPresets, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Style="{StaticResource LongComboBox}"
                              ItemsSource="{Binding ArgumentPresets}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedArgumentPreset}"
                              automation:AutomationProperties.AutomationId="Long.Workflow.ArgumentPreset"
                              automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.choosePreset}" />
                    <Button Grid.Column="1" Content="{DynamicResource i18n.action.apply}" Style="{StaticResource LongButton}"
                            Margin="8,0,0,0"
                            IsEnabled="{Binding CanApplyArgumentPreset}"
                            Click="ApplyArgumentPreset_Click"
                            automation:AutomationProperties.AutomationId="Long.Workflow.ArgumentPreset.Apply"
                            automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.applyPreset}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding SchemaArguments}"
                              Visibility="{Binding UsesArgumentSchema, Converter={StaticResource BooleanToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10"
                                    CornerRadius="{DynamicResource Long.Radius.Control}"
                                    Background="{DynamicResource Long.Brush.Surface.Card}"
                                    BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="1,0,1,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ConstraintSummary}" FontSize="9"
                                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    </Grid>
                                    <TextBox Style="{StaticResource LongTextBox}" Text="{Binding Value}"
                                             MaxLength="{Binding InputMaxLength}"
                                             TextChanged="SchemaArgumentValue_TextChanged"
                                             Visibility="{Binding IsTextEditor, Converter={StaticResource BooleanToVisibility}}"
                                             automation:AutomationProperties.AutomationId="{Binding Key}"
                                             automation:AutomationProperties.Name="{Binding AutomationName}" />
                                    <PasswordBox Style="{StaticResource LongPasswordBox}"
                                                 MaxLength="{Binding InputMaxLength}"
                                                 Loaded="SchemaSensitive_Loaded"
                                                 PasswordChanged="SchemaSensitive_PasswordChanged"
                                                 Visibility="{Binding IsSensitiveEditor, Converter={StaticResource BooleanToVisibility}}"
                                                 automation:AutomationProperties.AutomationId="{Binding Key}"
                                                 automation:AutomationProperties.Name="{Binding AutomationName}"
                                                 automation:AutomationProperties.HelpText="{DynamicResource i18n.workflow.invocation.sensitiveHelp}" />
                                    <CheckBox Style="{StaticResource LongCheckBox}" Content="{DynamicResource i18n.action.enable}"
                                              IsThreeState="{Binding AllowsUnset}"
                                              IsChecked="{Binding BooleanValue, Mode=OneWay}"
                                              Checked="SchemaBoolean_Changed"
                                              Unchecked="SchemaBoolean_Changed"
                                              Indeterminate="SchemaBoolean_Changed"
                                              Visibility="{Binding IsBooleanEditor, Converter={StaticResource BooleanToVisibility}}"
                                              automation:AutomationProperties.AutomationId="{Binding Key}"
                                              automation:AutomationProperties.Name="{Binding AutomationName}" />
                                    <ComboBox Style="{StaticResource LongComboBox}"
                                              ItemsSource="{Binding EnumValues}"
                                              SelectedItem="{Binding SelectedEnumValue, Mode=OneWay}"
                                              SelectionChanged="SchemaEnum_SelectionChanged"
                                              Visibility="{Binding IsEnumEditor, Converter={StaticResource BooleanToVisibility}}"
                                              automation:AutomationProperties.AutomationId="{Binding Key}"
                                              automation:AutomationProperties.Name="{Binding AutomationName}" />
                                    <TextBlock Text="{Binding Description}" Margin="1,5,1,0" TextWrapping="Wrap"
                                               FontSize="9" Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                               Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibility}}" />
                                    <TextBlock Text="{Binding Error}" Margin="1,5,1,0" TextWrapping="Wrap"
                                               FontSize="9" Foreground="{DynamicResource Long.Brush.State.Danger}"
                                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}"
                                               automation:AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{Binding HasUnrecognizedArguments, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="{DynamicResource i18n.workflow.invocation.unrecognizedArguments}"
                               Margin="1,0,0,6" FontSize="10"
                               Foreground="{DynamicResource Long.Brush.State.Warning}" />
                    <ItemsControl ItemsSource="{Binding Arguments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource LongTextBox}" Text="{Binding Key}"
                                             IsReadOnly="True" MaxLength="128"
                                             automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.unrecognizedKey}" />
                                    <TextBox Grid.Column="2" Style="{StaticResource LongTextBox}"
                                             Text="••••••" IsReadOnly="True"
                                             automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.unrecognizedValueHidden}" />
                                    <Button Grid.Column="3" Style="{StaticResource LongIconButton}" Margin="7,0,0,0"
                                            Tag="{Binding}" Click="RemoveArgument_Click" ToolTip="{DynamicResource i18n.workflow.invocation.removeUnrecognized}"
                                            automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.removeUnrecognizedA11y}">
                                        <Path Data="{StaticResource Long.Icon.Delete}" Style="{StaticResource LongIcon}" Width="15" Height="15" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Arguments}"
                              Visibility="{Binding UsesAdvancedArguments, Converter={StaticResource BooleanToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource LongTextBox}" Text="{Binding Key}" MaxLength="128"
                                         TextChanged="ArgumentKey_TextChanged"
                                         automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.argumentKey}" />
                                <TextBox Grid.Column="2" Style="{StaticResource LongTextBox}" Text="{Binding Value}" MaxLength="65536"
                                         TextChanged="ArgumentValue_TextChanged"
                                         automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.argumentValue}" />
                                <Button Grid.Column="3" Style="{StaticResource LongIconButton}" Margin="7,0,0,0"
                                        Tag="{Binding}" Click="RemoveArgument_Click" ToolTip="{DynamicResource i18n.workflow.invocation.removeArgument}"
                                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.removeArgumentA11y}">
                                    <Path Data="{StaticResource Long.Icon.Delete}" Style="{StaticResource LongIcon}" Width="15" Height="15" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ArgumentError}" Margin="2,0,0,6" TextWrapping="Wrap" FontSize="10"
                           Foreground="{DynamicResource Long.Brush.State.Danger}"
                           Visibility="{Binding HasArgumentError, Converter={StaticResource BooleanToVisibility}}" />
                <Button Style="{StaticResource LongIconButton}" HorizontalAlignment="Left"
                        IsEnabled="{Binding CanAddArgument}" Click="AddArgument_Click" ToolTip="{DynamicResource i18n.workflow.invocation.addArgument}"
                        Visibility="{Binding UsesAdvancedArguments, Converter={StaticResource BooleanToVisibility}}"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.invocation.addArgumentA11y}">
                    <Path Data="{StaticResource Long.Icon.Add}" Style="{StaticResource LongIcon}" Width="15" Height="15" />
                </Button>
            </StackPanel>
        </Expander>
        <Expander Margin="100,8,0,0" IsExpanded="False" DataContext="{Binding BindingEditor}">
            <Expander.Header>
                <TextBlock Text="{Binding Summary}" FontSize="11"
                           Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
            </Expander.Header>
            <StackPanel Margin="0,7,0,0">
                <ItemsControl ItemsSource="{Binding Bindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Style="{StaticResource LongComboBox}"
                                          ItemsSource="{Binding OutputOptions}" DisplayMemberPath="Display"
                                          SelectedItem="{Binding Output}"
                                          SelectionChanged="BindingOutput_SelectionChanged"
                                          automation:AutomationProperties.Name="{DynamicResource i18n.workflow.binding.sourceOutput}" />
                                <ComboBox Grid.Column="2" Style="{StaticResource LongComboBox}"
                                          ItemsSource="{Binding TargetOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Target}"
                                          SelectionChanged="BindingTarget_SelectionChanged"
                                          automation:AutomationProperties.Name="{DynamicResource i18n.workflow.binding.target}" />
                                <TextBox Grid.Column="4" Style="{StaticResource LongTextBox}"
                                         Text="{Binding ArgumentKey}" MaxLength="128"
                                         TextChanged="BindingArgumentKey_TextChanged"
                                         Visibility="{Binding ShowArgumentKeyTextBox, Converter={StaticResource BooleanToVisibility}}"
                                         automation:AutomationProperties.Name="{DynamicResource i18n.workflow.binding.argumentKey}" />
                                <ComboBox Grid.Column="4" Style="{StaticResource LongComboBox}"
                                          ItemsSource="{Binding ArgumentKeyOptions}"
                                          SelectedItem="{Binding ArgumentKey, Mode=OneWay}"
                                          SelectionChanged="BindingArgumentKey_SelectionChanged"
                                          Visibility="{Binding ShowArgumentKeyOptions, Converter={StaticResource BooleanToVisibility}}"
                                          automation:AutomationProperties.Name="{DynamicResource i18n.workflow.binding.chooseArgument}" />
                                <Button Grid.Column="5" Style="{StaticResource LongIconButton}" Margin="7,0,0,0"
                                        Tag="{Binding}" Click="RemoveBinding_Click" ToolTip="{DynamicResource i18n.workflow.binding.remove}"
                                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.binding.removeA11y}">
                                    <Path Data="{StaticResource Long.Icon.Delete}" Style="{StaticResource LongIcon}" Width="15" Height="15" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Error}" Margin="2,0,0,6" TextWrapping="Wrap" FontSize="10"
                           Foreground="{DynamicResource Long.Brush.State.Danger}"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}" />
                <Button Style="{StaticResource LongIconButton}" HorizontalAlignment="Left"
                        IsEnabled="{Binding CanAdd}" Click="AddBinding_Click" ToolTip="{DynamicResource i18n.workflow.binding.add}"
                        automation:AutomationProperties.Name="{DynamicResource i18n.workflow.binding.addA11y}">
                    <Path Data="{StaticResource Long.Icon.Add}" Style="{StaticResource LongIcon}" Width="15" Height="15" />
                </Button>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
