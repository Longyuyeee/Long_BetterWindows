<Window x:Class="LongBetterWindows.Host.Views.FloatingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AutomationProperties.AutomationId="Long.FolderNote.Hud.Window"
        Deactivated="Window_Deactivated"
        Activated="Window_Activated"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Border x:Name="HudBorder" Style="{StaticResource LongToast}">

        <StackPanel Width="320">
            <TextBlock x:Name="TitleLabel" Text="{DynamicResource i18n.folderNote.hud.title}"
                       FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource Long.Brush.Accent.Primary}" Margin="0,0,0,4"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FolderLabel" Text=""
                       FontSize="11"
                       Foreground="{DynamicResource Long.Brush.Text.Secondary}" Margin="0,0,0,10"
                       TextTrimming="CharacterEllipsis" />

            <TextBox x:Name="NoteTextBox"
                     AutomationProperties.AutomationId="Long.FolderNote.Hud.Input"
                     AutomationProperties.Name="{DynamicResource i18n.folderNote.hud.inputAutomationName}"
                     FontSize="14"
                     CaretBrush="{DynamicResource Long.Brush.Accent.Primary}"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource Long.Brush.Text.Primary}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="60"
                     MaxHeight="200"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="NoteTextBox_TextChanged" />

            <TextBlock x:Name="HintText" Text="{DynamicResource i18n.folderNote.hud.emptyHint}"
                       FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Muted}"
                       Margin="0,8,0,0" TextAlignment="Right" />
        </StackPanel>
    </Border>
</Window>
