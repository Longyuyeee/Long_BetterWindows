<Window x:Class="LongBetterWindows.Host.Views.FloatingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Deactivated="Window_Deactivated"
        Activated="Window_Activated"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Border Background="#E8F0F8F5" CornerRadius="16" Padding="16,12"
            BorderBrush="#20000000" BorderThickness="0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" />
        </Border.Effect>

        <StackPanel Width="320">
            <TextBlock x:Name="TitleLabel" Text="备注"
                       FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource AccentBlueBrush}" Margin="0,0,0,4"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FolderLabel" Text=""
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"
                       TextTrimming="CharacterEllipsis" />

            <TextBox x:Name="NoteTextBox"
                     FontSize="14"
                     CaretBrush="{DynamicResource AccentBlueBrush}"
                     BorderThickness="0"
                     Background="Transparent"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="60"
                     MaxHeight="200"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="NoteTextBox_TextChanged" />

            <TextBlock x:Name="HintText" Text="输入备注内容..."
                       FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                       Margin="0,8,0,0" TextAlignment="Right" />
        </StackPanel>
    </Border>
</Window>
