<Window x:Class="LongBetterWindows.Host.Views.FloatingHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FocusManager.LostFocus="Window_LostFocus"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Border Background="#E8F0F8F5" CornerRadius="16" Padding="16,12"
            BorderBrush="#20000000" BorderThickness="0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" />
        </Border.Effect>

        <StackPanel Width="320">
            <TextBlock Text="备注" FontSize="12"
                       Foreground="#80000000" Margin="0,0,0,8" />

            <TextBox x:Name="NoteTextBox"
                     FontSize="14"
                     CaretBrush="#FF007AFF"
                     BorderThickness="0"
                     Background="Transparent"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     MinHeight="60"
                     MaxHeight="200"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="NoteTextBox_TextChanged"
                     LostFocus="NoteTextBox_LostFocus" />

            <TextBlock x:Name="HintText" Text="输入备注内容..."
                       FontSize="11" Foreground="#60000000"
                       Margin="0,8,0,0" TextAlignment="Right" />
        </StackPanel>
    </Border>
</Window>
