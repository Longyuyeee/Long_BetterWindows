<UserControl x:Class="LongBetterWindows.Host.Views.InstalledPluginRailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220"
             AutomationProperties.AutomationId="Long.Workspace.PluginRail">
    <UserControl.Resources>
        <DataTemplate x:Key="PluginRailWideItemTemplate">
            <Grid Height="52"
                  Margin="6,1"
                  ToolTip="{Binding Name}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Long.Brush.Accent.Soft}"
                            CornerRadius="6">
                        <TextBlock Text="{Binding Monogram}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Long.Brush.Accent.Primary}" />
                    </Border>
                    <Image Source="{Binding IconPath}"
                           Width="32"
                           Height="32"
                           Stretch="UniformToFill"
                           ImageFailed="PluginIcon_ImageFailed" />
                </Grid>
                <StackPanel Grid.Column="1"
                            Margin="8,0,4,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Long.Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,2,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource Long.Brush.Text.Muted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2"
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource LongIconButton}"
                        Tag="{Binding Id}"
                        IsEnabled="{Binding CanOpen}"
                        Click="RunPlugin_Click"
                        ToolTip="{DynamicResource plugins.open}"
                        AutomationProperties.Name="{DynamicResource plugins.open}"
                        AutomationProperties.AutomationId="Long.Workspace.PluginRail.Run">
                    <Path Data="{StaticResource Long.Icon.Play}"
                          Style="{StaticResource LongIcon}"
                          Width="11"
                          Height="11" />
                </Button>
                <Ellipse Width="7"
                         Height="7"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,6,34,0"
                         Fill="{DynamicResource Long.Brush.State.Success}"
                         Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PluginRailCompactItemTemplate">
            <Grid Height="52"
                  Margin="5,1"
                  ToolTip="{Binding Name}">
                <Grid Width="32" Height="32">
                    <Border Background="{DynamicResource Long.Brush.Accent.Soft}"
                            CornerRadius="6">
                        <TextBlock Text="{Binding Monogram}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Long.Brush.Accent.Primary}" />
                    </Border>
                    <Image Source="{Binding IconPath}"
                           Width="32"
                           Height="32"
                           Stretch="UniformToFill"
                           ImageFailed="PluginIcon_ImageFailed" />
                    <Ellipse Width="7"
                             Height="7"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Fill="{DynamicResource Long.Brush.State.Success}"
                             Stroke="{DynamicResource Long.Brush.Background.Raised}"
                             StrokeThickness="1"
                             Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="PluginRailItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="54" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource Long.Brush.Background.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource Long.Brush.Accent.Soft}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource Long.Brush.Accent.Soft}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Long.Brush.Background.Raised}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="RailHeader" Margin="12,14,12,10">
                <TextBlock x:Name="RailTitle"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                <Grid Margin="0,10,0,0">
                    <TextBox x:Name="PluginFilterBox"
                             Height="34"
                             Padding="10,0"
                             Style="{StaticResource LongTextBox}"
                             FontSize="12"
                             TextChanged="PluginFilterBox_TextChanged"
                             AutomationProperties.AutomationId="Long.Workspace.PluginRail.Search" />
                    <TextBlock x:Name="PluginFilterHint"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Long.Brush.Text.Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=PluginFilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>

            <ListBox x:Name="PluginList"
                     Grid.Row="1"
                     Margin="4,0,4,8"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource PluginRailItemStyle}"
                     ItemTemplate="{StaticResource PluginRailWideItemTemplate}"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     PreviewMouseLeftButtonUp="PluginList_PreviewMouseLeftButtonUp"
                     PreviewMouseDoubleClick="PluginList_PreviewMouseDoubleClick"
                     PreviewKeyDown="PluginList_PreviewKeyDown"
                     AutomationProperties.Name="{DynamicResource plugins.list}"
                     AutomationProperties.AutomationId="Long.Workspace.PluginRail.List">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
