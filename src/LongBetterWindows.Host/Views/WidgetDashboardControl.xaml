<UserControl x:Class="LongBetterWindows.Host.Views.WidgetDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             MinHeight="420">
    <UserControl.Resources>
        <Style x:Key="WidgetSectionCard" TargetType="Border" BasedOn="{StaticResource LongCard}">
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="ResponsiveRoot">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CatalogRow" Height="*" />
            <RowDefinition x:Name="NarrowGapRow" Height="0" />
            <RowDefinition x:Name="SurfaceRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CatalogColumn" Width="292" />
            <ColumnDefinition x:Name="WideGapColumn" Width="16" />
            <ColumnDefinition x:Name="SurfaceColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="CatalogCard" Grid.Row="0" Grid.Column="0"
                Style="{StaticResource WidgetSectionCard}" Padding="18">
            <StackPanel>
                <TextBlock Text="{DynamicResource i18n.widgets.catalog.title}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                <TextBlock Text="{DynamicResource i18n.widgets.catalog.subtitle}"
                           Margin="0,5,0,14" TextWrapping="Wrap"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                <StackPanel x:Name="CatalogItems" />
                <TextBlock x:Name="CatalogEmptyText"
                           Text="{DynamicResource i18n.widgets.catalog.empty}"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}" />
            </StackPanel>
        </Border>

        <Border x:Name="SurfaceCard" Grid.Row="0" Grid.Column="2"
                Style="{StaticResource WidgetSectionCard}" Padding="18">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource i18n.widgets.surface.title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                        <TextBlock Text="{DynamicResource i18n.widgets.surface.subtitle}"
                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource i18n.widgets.refresh}"
                            Style="{StaticResource LongButton}" Margin="12,0,0,0"
                            VerticalAlignment="Top" Click="Refresh_Click"
                            automation:AutomationProperties.AutomationId="Long.Widgets.Refresh" />
                </Grid>

                <Border Background="{DynamicResource Long.Brush.Surface.Hover}"
                        BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                        BorderThickness="1" CornerRadius="{DynamicResource Long.Radius.Control}"
                        Padding="8">
                    <Grid>
                        <Grid x:Name="SurfaceGrid" MinHeight="240"
                              SnapsToDevicePixels="True" />
                        <StackPanel x:Name="SurfaceEmptyPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="360">
                            <TextBlock Text="✦" FontSize="28"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Long.Brush.Accent.Primary}" />
                            <TextBlock Text="{DynamicResource i18n.widgets.surface.empty}"
                                       Margin="0,8,0,0" TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText" Margin="2,12,2,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.AutomationId="Long.Widgets.Status" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
