<UserControl x:Class="LongBetterWindows.Host.Views.CapabilityDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252628"
             BorderBrush="#3A3A3D"
             BorderThickness="0,1,0,0">

    <UserControl.Resources>
        <Style x:Key="CapItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#2B2D30" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- 标题 -->
                <TextBlock Text="权限详情" FontSize="14" FontWeight="SemiBold"
                           Foreground="#F8FAFC" Margin="0,0,0,12" />

                <!-- 权限列表容器 -->
                <StackPanel x:Name="CapabilitiesPanel" />

                <!-- 统计信息 -->
                <Border Style="{StaticResource CapItemStyle}" Margin="0,12,0,0"
                        Background="#1E1F22">
                    <StackPanel>
                        <TextBlock Text="📊 API 调用统计" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#F8FAFC" Margin="0,0,0,8" />
                        <TextBlock x:Name="StatsText" FontSize="11" Foreground="#94A3B8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
