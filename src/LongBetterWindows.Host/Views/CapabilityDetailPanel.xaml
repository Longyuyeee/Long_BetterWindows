<UserControl x:Class="LongBetterWindows.Host.Views.CapabilityDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource Long.Brush.Background.Base}">
        <ScrollViewer Style="{StaticResource DarkScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto" Padding="22">
            <StackPanel>
                <TextBlock x:Name="PluginNameText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="PermissionSummaryText" Margin="0,5,0,18"
                           Foreground="{DynamicResource Long.Brush.Text.Secondary}" />

                <ItemsControl x:Name="CapabilityItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LongPluginCard}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{Binding LevelBrush}"
                                             Margin="0,2,12,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Margin="0,4,12,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding CapabilityKey}" Margin="0,6,0,0" FontSize="10"
                                                   FontFamily="{DynamicResource Long.Font.Mono}"
                                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource LongBadge}"
                                            BorderBrush="{Binding LevelBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LevelText}" Foreground="{Binding LevelBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="NoCapabilitiesText" Text="该插件未声明宿主能力"
                           Style="{StaticResource LongEmptyState}" Visibility="Collapsed" Margin="0,10,0,16" />

                <Border Style="{StaticResource LongCard}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource i18n.plugins.usage.title}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="StatsText" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
