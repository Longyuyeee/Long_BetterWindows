<UserControl x:Class="LongBetterWindows.Host.Views.MarketplaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:contracts="clr-namespace:LongBetterWindows.Host.Contracts"
             MinHeight="650"
             AutomationProperties.AutomationId="Long.Marketplace"
             AutomationProperties.Name="{DynamicResource i18n.market.name}"
             PreviewKeyDown="MarketplaceControl_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="MarketHeroCard"
                CornerRadius="{DynamicResource Long.Radius.Flyout}"
                Background="{DynamicResource Long.Brush.Accent.Gradient}"
                Padding="24,20" Margin="0,0,0,16">
            <Grid x:Name="MarketHeroGrid">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MarketHeroTextColumn" Width="*"/>
                    <ColumnDefinition x:Name="MarketHeroActionColumn" Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="8" Background="{DynamicResource Long.Brush.Surface.OnAccent}" Padding="8,4">
                            <TextBlock Text="LONG MARKET" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource Long.Brush.Text.OnAccent}" />
                        </Border>
                        <TextBlock x:Name="MarketSourceBadge" Text="{DynamicResource i18n.market.source.local}" Margin="10,4,0,0"
                                   Foreground="{DynamicResource Long.Brush.Text.OnAccentMuted}" />
                    </StackPanel>
                    <TextBlock x:Name="MarketHeroTitle"
                               Text="{DynamicResource i18n.market.hero.title}"
                               FontSize="22" FontWeight="SemiBold" Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.OnAccent}" />
                    <TextBlock Text="{DynamicResource i18n.market.hero.subtitle}"
                               FontSize="12" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.OnAccentMuted}" />
                </StackPanel>
                <Button x:Name="ImportLocalPackageButton" Grid.Column="1"
                        Content="{DynamicResource i18n.market.import}" VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource i18n.market.import}"
                        Style="{StaticResource LongButton}" Background="{DynamicResource Long.Brush.Surface.OnAccent}"
                        BorderBrush="{DynamicResource Long.Brush.Stroke.OnAccent}"
                        Foreground="{DynamicResource Long.Brush.Text.OnAccent}"
                        Click="ImportLocalPackage_Click" />
            </Grid>
        </Border>

        <Grid x:Name="MarketFilterGrid" Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MarketSearchColumn" Width="*" />
                <ColumnDefinition x:Name="MarketCategoryColumn" Width="190" />
                <ColumnDefinition x:Name="MarketRefreshColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CategoryBox" Grid.Column="1" Height="48" Margin="10,0"
                      Style="{StaticResource LongComboBox}"
                      AutomationProperties.AutomationId="Long.Marketplace.Category"
                      AutomationProperties.Name="{DynamicResource i18n.market.category}"
                      VerticalContentAlignment="Center" SelectionChanged="CategoryBox_SelectionChanged" />
            <Button x:Name="RefreshCatalogButton" Grid.Column="2"
                    Content="{DynamicResource i18n.market.refresh}" Style="{StaticResource LongButton}"
                    AutomationProperties.AutomationId="Long.Marketplace.Refresh"
                    AutomationProperties.Name="{DynamicResource i18n.market.refresh}"
                    Height="48" Click="RefreshCatalog_Click" />
            <Button x:Name="CompactImportLocalPackageButton" Grid.Row="1" Grid.ColumnSpan="3"
                    Content="{DynamicResource i18n.market.import}" Margin="0,10,0,0"
                    Visibility="Collapsed"
                    AutomationProperties.Name="{DynamicResource i18n.market.import}"
                    Style="{StaticResource LongButton}"
                    Click="ImportLocalPackage_Click" />
        </Grid>

        <Grid x:Name="MarketBodyGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MarketListColumn" Width="330" />
                <ColumnDefinition x:Name="MarketBodyGapColumn" Width="14" />
                <ColumnDefinition x:Name="MarketDetailColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="MarketListCard" Style="{StaticResource LongCard}" Padding="10" Effect="{x:Null}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="8,6,8,10">
                        <TextBlock x:Name="ResultCountText" Text="{DynamicResource i18n.market.results.empty}" FontSize="13" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="Long.Marketplace.ResultCount"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{DynamicResource i18n.market.trustedDiscovery}" HorizontalAlignment="Right" FontSize="10"
                                   Foreground="{DynamicResource Long.Brush.State.Success}" />
                    </Grid>
                    <Border x:Name="CatalogNotice" Grid.Row="1" Visibility="Collapsed"
                            Margin="2,0,2,8" Padding="10" CornerRadius="6"
                            Background="{DynamicResource Long.Brush.Background.Raised}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CatalogNoticeTitle" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CatalogNoticeDescription" Margin="0,3,10,0" FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Long.Brush.Text.Secondary}"/>
                            </StackPanel>
                            <Button x:Name="CatalogNoticeRetryButton" Grid.Column="1"
                                    Content="{DynamicResource i18n.market.retry}"
                                    AutomationProperties.Name="{DynamicResource i18n.market.retry}"
                                    Style="{StaticResource LongButton}"
                                    Click="CatalogRetry_Click"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                    <ListBox x:Name="MarketList" Background="Transparent" BorderThickness="0"
                             AutomationProperties.AutomationId="Long.Marketplace.Results"
                             AutomationProperties.Name="{DynamicResource i18n.market.results}"
                             SelectionChanged="MarketList_SelectionChanged"
                             PreviewMouseLeftButtonUp="MarketList_PreviewMouseLeftButtonUp"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource LongCommandItem}">
                                <Setter Property="Padding" Value="10" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="AutomationProperties.ItemStatus" Value="{Binding State}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="11"
                                            Background="{DynamicResource Long.Brush.Accent.Soft}">
                                        <TextBlock Text="{Binding Monogram}" FontSize="15" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Long.Brush.Accent.Primary}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="9"
                                                       Foreground="{DynamicResource Long.Brush.Accent.Primary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource i18n.market.state.get}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static contracts:MarketplaceInstallState.Installed}">
                                                                <Setter Property="Text" Value="{DynamicResource i18n.market.state.installed}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static contracts:MarketplaceInstallState.UpdateAvailable}">
                                                                <Setter Property="Text" Value="{DynamicResource i18n.market.state.update}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static contracts:MarketplaceInstallState.DowngradeAvailable}">
                                                                <Setter Property="Text" Value="{DynamicResource i18n.market.state.downgrade}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="{x:Static contracts:MarketplaceInstallState.Incompatible}">
                                                                <Setter Property="Text" Value="{DynamicResource i18n.market.state.incompatible}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding Meta}" Margin="0,4,0,0" FontSize="9"
                                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="CatalogStatePanel" Visibility="Collapsed"
                                VerticalAlignment="Center" Margin="20"
                                AutomationProperties.AutomationId="Long.Marketplace.CatalogState"
                                AutomationProperties.LiveSetting="Polite">
                        <TextBlock x:Name="CatalogStateTitle" FontSize="15" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CatalogStateDescription" Margin="0,7,0,0" FontSize="11"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}"/>
                        <ProgressBar x:Name="CatalogStateProgress" Width="120" Height="4" Margin="0,16,0,0"
                                     IsIndeterminate="True" Visibility="Collapsed"/>
                        <Button x:Name="CatalogStateRetryButton"
                                Content="{DynamicResource i18n.market.retry}" Margin="0,16,0,0"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource i18n.market.retry}"
                                Style="{StaticResource LongButton}"
                                Click="CatalogRetry_Click"/>
                    </StackPanel>
                    </Grid>
                    <TextBlock x:Name="CatalogStatusText" Grid.Row="3" Margin="8,10,8,6" FontSize="10"
                               AutomationProperties.AutomationId="Long.Marketplace.Status"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                </Grid>
            </Border>

            <Border x:Name="MarketDetailCard" Grid.Column="2" Style="{StaticResource LongCard}" Padding="24" Effect="{x:Null}">
                <Grid>
                    <StackPanel x:Name="MarketEmptyDetail" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Center"
                                Background="{DynamicResource Long.Brush.Accent.Soft}">
                            <TextBlock Text="L" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Long.Brush.Accent.Primary}" />
                        </Border>
                        <TextBlock Text="{DynamicResource i18n.market.emptyDetail.title}" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="{DynamicResource i18n.market.emptyDetail.desc}"
                                   Style="{StaticResource LongEmptyState}" Margin="24,8" />
                    </StackPanel>

                    <Grid x:Name="MarketDetail" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="MarketBackButton"
                                Content="{DynamicResource i18n.market.backToResults}"
                                AutomationProperties.AutomationId="Long.Marketplace.Back"
                                AutomationProperties.Name="{DynamicResource i18n.market.backToResults}"
                                HorizontalAlignment="Left" Margin="0,0,0,14"
                                Visibility="Collapsed" Style="{StaticResource LongButton}"
                                Click="MarketBackButton_Click" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="17"
                                    Background="{DynamicResource Long.Brush.Accent.Soft}">
                                <TextBlock x:Name="DetailMonogram" FontSize="21" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Long.Brush.Accent.Primary}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailName" FontSize="20" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="Long.Marketplace.DetailName" />
                                <TextBlock x:Name="DetailPublisher" FontSize="11" Margin="0,5,0,0"
                                           Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource LongBadge}" VerticalAlignment="Top">
                                <TextBlock x:Name="DetailState" FontSize="10" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="Long.Marketplace.DetailState" />
                            </Border>
                        </Grid>

                        <TextBlock x:Name="DetailDescription" Grid.Row="2" Margin="0,18,0,0"
                                   TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}" />

                        <Grid Grid.Row="3" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border CornerRadius="10" Background="{DynamicResource Long.Brush.Background.Raised}" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource i18n.market.version}" FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    <ComboBox x:Name="VersionBox" Height="34" Margin="0,7,0,0"
                                              AutomationProperties.AutomationId="Long.Marketplace.Version"
                                              AutomationProperties.Name="{DynamicResource i18n.market.chooseVersion}"
                                              Style="{StaticResource LongComboBox}"
                                              SelectionChanged="VersionBox_SelectionChanged" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource Long.Brush.Background.Raised}" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource i18n.market.trustStatus}" FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    <TextBlock x:Name="DetailTrust" Margin="0,9,0,0" FontSize="12" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Long.Brush.State.Success}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="4" Margin="0,18,0,0">
                            <TextBlock Text="{DynamicResource i18n.market.permissions}" FontSize="12" FontWeight="SemiBold" />
                            <ItemsControl x:Name="CapabilityItems" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LongHotkeyBadge}" Margin="0,0,7,7">
                                            <TextBlock Text="{Binding}" FontSize="10" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border x:Name="CompatibilityCard" CornerRadius="10" Padding="12" Margin="0,8,0,0"
                                    Background="{DynamicResource Long.Brush.Background.Raised}">
                                <StackPanel>
                                    <TextBlock x:Name="CompatibilityTitle" FontWeight="SemiBold" FontSize="11" />
                                    <TextBlock x:Name="CompatibilityText" Margin="0,4,0,0" FontSize="10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="ReleaseNotesText" Margin="0,12,0,0" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                        </StackPanel>

                        <Grid Grid.Row="5" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailHint" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                       FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="UninstallButton" Grid.Column="1" Content="{DynamicResource i18n.action.uninstall}" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="Long.Marketplace.Uninstall"
                                    AutomationProperties.Name="{DynamicResource i18n.market.uninstallSelected}"
                                    Style="{StaticResource LongButton}" Click="UninstallButton_Click" />
                            <Button x:Name="InstallButton" Grid.Column="2" Content="{DynamicResource i18n.market.choosePackage}"
                                    AutomationProperties.AutomationId="Long.Marketplace.Install"
                                    AutomationProperties.Name="{DynamicResource i18n.market.chooseAndReview}"
                                    Style="{StaticResource LongButton.Primary}" Click="InstallButton_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="ConfirmOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{DynamicResource OverlayDarkBrush}">
            <Border x:Name="ConfirmCard" MaxWidth="520" MaxHeight="590" Margin="16"
                    VerticalAlignment="Center" HorizontalAlignment="Stretch"
                    Style="{StaticResource LongCard}" Padding="26" Effect="{DynamicResource Long.Shadow.Level3}"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="ConfirmTitle" Text="{DynamicResource i18n.market.confirm.installTitle}" FontSize="20" FontWeight="SemiBold"
                                   AutomationProperties.AutomationId="Long.Marketplace.ConfirmTitle" />
                        <Button x:Name="ConfirmCloseButton"
                                HorizontalAlignment="Right" Style="{StaticResource LongIconButton}"
                                AutomationProperties.AutomationId="Long.Marketplace.ConfirmClose"
                                AutomationProperties.Name="{DynamicResource i18n.market.confirm.close}"
                                Click="CancelConfirmation_Click">
                            <Path Data="{StaticResource Long.Icon.Close}"
                                  Style="{StaticResource LongIcon}"
                                  Width="11"
                                  Height="11" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ConfirmSubtitle" Margin="0,8,42,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    <Border CornerRadius="12" Background="{DynamicResource Long.Brush.Background.Raised}"
                            Padding="14" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ConfirmTrustText" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="Long.Marketplace.ConfirmTrust"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="ConfirmHashText" Margin="0,6,0,0" FontSize="10" FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                            <TextBlock x:Name="ConfirmCompatibilityText" Margin="0,7,0,0" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{DynamicResource i18n.market.confirm.permissionChanges}" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <ItemsControl x:Name="PermissionDiffItems" Margin="0,9,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,3" FontSize="11" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="HighTrustWarning" Visibility="Collapsed" CornerRadius="10" Padding="12" Margin="0,14,0,0"
                            Background="{DynamicResource Long.Brush.Accent.Soft}">
                        <TextBlock Text="{DynamicResource i18n.market.confirm.highTrustWarning}"
                                   FontSize="11" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock x:Name="ConfirmErrorText" Margin="0,12,0,0" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="Long.Marketplace.ConfirmError"
                               AutomationProperties.LiveSetting="Assertive"
                               Foreground="{DynamicResource Long.Brush.State.Danger}" />
                    <TextBlock x:Name="ConfirmOperationStatusText" Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="Long.Marketplace.OperationStatus"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="InstallProgress" Width="120" Height="4" Visibility="Collapsed" IsIndeterminate="True"
                                     AutomationProperties.Name="{DynamicResource i18n.market.operationInProgress}" />
                        <Button x:Name="ConfirmCancelButton" Grid.Column="1" Content="{DynamicResource i18n.action.cancel}" Margin="0,0,8,0" Style="{StaticResource LongButton}"
                                AutomationProperties.AutomationId="Long.Marketplace.ConfirmCancel"
                                AutomationProperties.Name="{DynamicResource i18n.market.cancelOperation}"
                                Click="CancelConfirmation_Click" />
                        <Button x:Name="ConfirmActionButton" Grid.Column="2" Content="{DynamicResource i18n.market.confirm.installAction}"
                                AutomationProperties.AutomationId="Long.Marketplace.ConfirmAction"
                                AutomationProperties.Name="{DynamicResource i18n.market.confirmOperation}"
                                Style="{StaticResource LongButton.Primary}" Click="ConfirmAction_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
