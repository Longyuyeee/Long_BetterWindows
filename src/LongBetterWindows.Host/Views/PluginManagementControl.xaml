<UserControl x:Class="LongBetterWindows.Host.Views.PluginManagementControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Foreground="{DynamicResource Long.Brush.Text.Primary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="PluginStateDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Long.Brush.Text.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Long.Brush.State.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PluginListCard" TargetType="Border"
               BasedOn="{StaticResource LongPluginCard}">
            <Setter Property="Effect" Value="{x:Null}" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid x:Name="PluginToolbar" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PluginHeaderColumn" Width="*" />
                <ColumnDefinition x:Name="PluginRefreshColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PluginsHeader" Text="{DynamicResource i18n.plugins.installed}" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button x:Name="RefreshPluginsButton" Grid.Column="1"
                    ToolTip="{DynamicResource i18n.action.refresh}"
                    automation:AutomationProperties.Name="{DynamicResource i18n.action.refresh}"
                    Style="{StaticResource LongIconButton}"
                    Click="RefreshPlugins_Click">
                <Path Data="{StaticResource Long.Icon.Refresh}"
                      Style="{StaticResource LongIcon}" Width="17" Height="17" />
            </Button>
        </Grid>

        <TextBlock x:Name="EmptyStateText" Text="{DynamicResource i18n.plugins.empty}"
                   Style="{StaticResource LongEmptyState}" Visibility="Collapsed"
                   automation:AutomationProperties.LiveSetting="Polite" />

        <ListBox x:Name="PluginsPanel" MaxHeight="640"
                 automation:AutomationProperties.Name="{DynamicResource i18n.plugins.list}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
            </ListBox.Resources>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PluginListCard}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Style="{StaticResource PluginStateDot}"
                                     Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <WrapPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Long.Brush.Text.Primary}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="360"
                                               VerticalAlignment="Center" />
                                    <Border Style="{StaticResource LongBadge}" Margin="7,0,0,0">
                                        <TextBlock Text="{Binding RuntimeLabel}" FontSize="10"
                                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    </Border>
                                    <Border Style="{StaticResource LongHotkeyBadge}" Margin="7,0,0,0"
                                            Visibility="{Binding HasHotkey, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="{Binding Hotkey}" FontSize="10"
                                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}"
                                                   FontFamily="{DynamicResource Long.Font.Mono}" />
                                    </Border>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                               Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text=" · " FontSize="11"
                                               Visibility="{Binding HasCapabilities, Converter={StaticResource BooleanToVisibility}}"
                                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    <TextBlock Text="{Binding CapabilitySummary}" FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasCapabilities, Converter={StaticResource BooleanToVisibility}}"
                                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Width="38" Height="38"
                                    Style="{StaticResource LongIconButton}" Tag="{Binding}"
                                    ToolTip="{DynamicResource i18n.plugins.actions}"
                                    automation:AutomationProperties.Name="{DynamicResource i18n.plugins.actions}"
                                    Click="PluginActions_Click">
                                <Path Data="{StaticResource Long.Icon.MoreHorizontal}"
                                      Style="{StaticResource LongIcon}" Width="18" Height="18" />
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
