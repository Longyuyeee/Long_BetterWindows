<UserControl x:Class="LongBetterWindows.Host.Views.PluginManagementControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Foreground="{DynamicResource Long.Brush.Text.Primary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="PluginStateDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource Long.Brush.Text.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Long.Brush.State.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PluginToggleButton" TargetType="Button" BasedOn="{StaticResource LongButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Long.Brush.State.Danger}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.State.Danger}" />
                    <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.OnAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid x:Name="PluginToolbar" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PluginHeaderColumn" Width="*" />
                <ColumnDefinition x:Name="PluginSearchColumn" Width="280" />
                <ColumnDefinition x:Name="PluginRefreshColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PluginsHeader" Text="{DynamicResource i18n.plugins.installed}" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Grid x:Name="PluginSearchHost" Grid.Column="1" Margin="0,0,10,0">
                <TextBox x:Name="PluginSearchBox" Style="{StaticResource LongTextBox}"
                         TextChanged="PluginSearch_TextChanged"
                         automation:AutomationProperties.AutomationId="Long.Plugins.Search"
                         automation:AutomationProperties.Name="{DynamicResource i18n.plugins.search}" />
                <TextBlock Text="{DynamicResource i18n.plugins.searchHint}"
                           Margin="12,0,8,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=PluginSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button x:Name="RefreshPluginsButton" Grid.Column="2"
                    Content="{DynamicResource i18n.action.refresh}"
                    automation:AutomationProperties.Name="{DynamicResource i18n.action.refresh}"
                    Style="{StaticResource LongButton}"
                    Click="RefreshPlugins_Click" />
        </Grid>

        <TextBlock x:Name="EmptyStateText" Text="{DynamicResource i18n.plugins.empty}"
                   Style="{StaticResource LongEmptyState}" Visibility="Collapsed"
                   automation:AutomationProperties.LiveSetting="Polite" />

        <ListBox x:Name="PluginsPanel" MaxHeight="640"
                 automation:AutomationProperties.Name="{DynamicResource i18n.plugins.list}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
            </ListBox.Resources>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource LongPluginCard}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Style="{StaticResource PluginStateDot}"
                                             Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Long.Brush.Text.Primary}"
                                               VerticalAlignment="Center" />
                                    <Border Style="{StaticResource LongBadge}" Margin="7,0,0,0">
                                        <TextBlock Text="{Binding RuntimeLabel}" FontSize="9"
                                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="16,5,0,0">
                                    <Border Style="{StaticResource LongHotkeyBadge}" Margin="0,0,8,0"
                                            Visibility="{Binding HasHotkey, Converter={StaticResource BooleanToVisibility}}">
                                        <TextBlock Text="{Binding Hotkey}" FontSize="10"
                                                   FontFamily="{DynamicResource Long.Font.Mono}" />
                                    </Border>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                               Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="16,6,0,0">
                                    <ItemsControl ItemsSource="{Binding VisibleCapabilities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource LongBadge}" Margin="0,0,5,0">
                                                    <TextBlock Text="{Binding}" FontSize="10"
                                                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding AdditionalCapabilityText}" FontSize="10"
                                               Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasAdditionalCapabilities, Converter={StaticResource BooleanToVisibility}}" />
                                </StackPanel>
                            </StackPanel>

                            <WrapPanel Grid.Row="1" Margin="16,14,0,0"
                                       HorizontalAlignment="Right">
                                <Button Content="{DynamicResource i18n.action.open}" MinWidth="62" Margin="0,0,6,0"
                                        Style="{StaticResource LongButton.Primary}" Tag="{Binding}"
                                        automation:AutomationProperties.Name="{DynamicResource i18n.plugins.open}"
                                        Click="OpenPlugin_Click"
                                        Visibility="{Binding CanOpen, Converter={StaticResource BooleanToVisibility}}" />
                                <Button Width="38" Margin="0,0,6,0" Style="{StaticResource LongIconButton}"
                                        Tag="{Binding}" Click="PluginSettings_Click"
                                        ToolTip="{DynamicResource i18n.plugins.settings}"
                                        automation:AutomationProperties.Name="{DynamicResource i18n.plugins.openSettings}"
                                        Visibility="{Binding CanOpenSettings, Converter={StaticResource BooleanToVisibility}}">
                                    <Path Data="{StaticResource Long.Icon.Settings}" Style="{StaticResource LongIcon}"
                                          Width="17" Height="17" />
                                </Button>
                                <Button Width="38" Margin="0,0,6,0" Style="{StaticResource LongIconButton}"
                                        Tag="{Binding}" Click="CapabilityDetails_Click"
                                        ToolTip="{DynamicResource i18n.plugins.capabilities}"
                                        automation:AutomationProperties.Name="{DynamicResource i18n.plugins.openCapabilities}">
                                    <Path Data="{StaticResource Long.Icon.Shield}" Style="{StaticResource LongIcon}"
                                          Width="17" Height="17" />
                                </Button>
                                <Button Content="{Binding ToggleText}" MinWidth="62" Tag="{Binding}"
                                        Style="{StaticResource PluginToggleButton}" Click="PluginToggle_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
