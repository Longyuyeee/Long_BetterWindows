<UserControl x:Class="LongBetterWindows.Host.Views.PluginSettingsModuleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Long.Workspace.PluginSettings">
    <UserControl.Resources>
        <Style x:Key="PluginModuleTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground"
                    Value="{DynamicResource Long.Brush.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface"
                                        Property="Background"
                                        Value="{DynamicResource Long.Brush.Background.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface"
                                        Property="Background"
                                        Value="{DynamicResource Long.Brush.Accent.Soft}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Long.Brush.Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PluginModuleTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0"
                                      IsItemsHost="True"
                                      Background="Transparent" />
                            <Border Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                                    BorderThickness="0,1,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Margin="0,14,0,0"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StateDot"
                         Width="8"
                         Height="8"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource Long.Brush.Text.Muted}" />
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                <Border Margin="9,0,0,0"
                        Style="{StaticResource LongBadge}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="RuntimeText"
                               FontSize="10"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </Border>
                <TextBlock x:Name="HotkeyText"
                           Margin="10,0,0,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource Long.Font.Mono}"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}"
                           Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ToggleButton"
                        Margin="0,0,8,0"
                        Style="{StaticResource LongButton}"
                        Click="ToggleButton_Click"
                        AutomationProperties.AutomationId="Long.Workspace.PluginSettings.Toggle" />
                <Button x:Name="RunButton"
                        Style="{StaticResource LongButton.Primary}"
                        Click="RunButton_Click"
                        AutomationProperties.AutomationId="Long.Workspace.PluginSettings.Run">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Long.Icon.Play}"
                              Style="{StaticResource LongIcon}"
                              Width="12"
                              Height="12"
                              Margin="0,0,7,0" />
                        <TextBlock x:Name="RunButtonText" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0">
            <TabControl x:Name="ModuleTabs"
                        MinHeight="420"
                        Style="{StaticResource PluginModuleTabControlStyle}"
                        SelectionChanged="ModuleTabs_SelectionChanged"
                        AutomationProperties.AutomationId="Long.Workspace.PluginSettings.Tabs">
                <TabItem x:Name="CommandsTab"
                         Style="{StaticResource PluginModuleTabItemStyle}"
                         AutomationProperties.AutomationId="Long.Workspace.PluginSettings.Tab.Commands"
                         Header="{DynamicResource i18n.plugins.commands}">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ItemsControl x:Name="CommandsList"
                                      AutomationProperties.Name="{DynamicResource i18n.plugins.commands}"
                                      AutomationProperties.AutomationId="Long.Workspace.PluginSettings.Commands">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LongCard}"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource Long.Brush.Text.Secondary}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding AliasSummary}"
                                                           Margin="0,8,0,0"
                                                           Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding InputSummary}"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <CheckBox Tag="{Binding Key}"
                                                          Style="{StaticResource LongCheckBox}"
                                                          Content="{DynamicResource i18n.plugins.command.enabled}"
                                                          IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          Margin="0,0,0,8"
                                                          Click="CommandEnabled_Click"
                                                          AutomationProperties.Name="{Binding EnabledAutomationName}"
                                                          AutomationProperties.AutomationId="{Binding Key, StringFormat=Long.Workspace.PluginSettings.CommandEnabled.{0}}" />
                                                <Button Tag="{Binding ResultId}"
                                                        Content="{Binding PinText}"
                                                        Style="{StaticResource LongButton}"
                                                        Click="CommandPin_Click"
                                                        AutomationProperties.Name="{Binding PinAutomationName}"
                                                        AutomationProperties.ItemStatus="{Binding IsPinned}"
                                                        AutomationProperties.AutomationId="{Binding Key, StringFormat=Long.Workspace.PluginSettings.Command.{0}}" />
                                            </StackPanel>
                                            <Grid Grid.Row="1"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,12,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.ColumnSpan="2"
                                                           Margin="0,0,0,5"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Long.Brush.Text.Secondary}"
                                                           Text="{DynamicResource i18n.plugins.command.customAliases}" />
                                                <TextBox Grid.Row="1"
                                                 Text="{Binding CustomAliasesText, UpdateSourceTrigger=PropertyChanged}"
                                                         MinWidth="220"
                                                         MaxLength="300"
                                                         Style="{StaticResource LongTextBox}"
                                                         ToolTip="{DynamicResource i18n.plugins.command.aliasesHint}"
                                                         AutomationProperties.Name="{Binding AliasesAutomationName}"
                                                         AutomationProperties.HelpText="{DynamicResource i18n.plugins.command.aliasesHint}"
                                                         AutomationProperties.AutomationId="{Binding Key, StringFormat=Long.Workspace.PluginSettings.CommandAliases.{0}}" />
                                                <Button Grid.Row="1"
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Content="{DynamicResource i18n.action.save}"
                                                        Style="{StaticResource LongButton}"
                                                        Click="CommandAliasesSave_Click"
                                                        AutomationProperties.Name="{Binding AliasesSaveAutomationName}"
                                                        AutomationProperties.AutomationId="{Binding Key, StringFormat=Long.Workspace.PluginSettings.CommandAliasesSave.{0}}" />
                                            </Grid>
                                            <Grid Grid.Row="2"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,12,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.ColumnSpan="3"
                                                           Margin="0,0,0,5"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Long.Brush.Text.Secondary}"
                                                           Text="{DynamicResource i18n.plugins.command.hotkey}" />
                                                <TextBox Grid.Row="1"
                                                         Text="{Binding HotkeyText, UpdateSourceTrigger=PropertyChanged}"
                                                         IsEnabled="{Binding CanEditHotkey}"
                                                         MaxLength="40"
                                                         MinWidth="220"
                                                         Style="{StaticResource LongTextBox}"
                                                         ToolTip="{DynamicResource i18n.plugins.command.hotkey.hint}"
                                                         AutomationProperties.Name="{Binding HotkeyAutomationName}"
                                                         AutomationProperties.HelpText="{DynamicResource i18n.plugins.command.hotkey.hint}"
                                                         AutomationProperties.AutomationId="{Binding Key, StringFormat=Long.Workspace.PluginSettings.CommandHotkey.{0}}" />
                                                <Button Grid.Row="1"
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Content="{DynamicResource i18n.action.apply}"
                                                        IsEnabled="{Binding CanEditHotkey}"
                                                        Style="{StaticResource LongButton}"
                                                        Click="CommandHotkeySave_Click"
                                                        AutomationProperties.Name="{Binding HotkeySaveAutomationName}"
                                                        AutomationProperties.AutomationId="{Binding Key, StringFormat=Long.Workspace.PluginSettings.CommandHotkeySave.{0}}" />
                                                <Button Grid.Row="1"
                                                        Grid.Column="2"
                                                        Width="34"
                                                        Height="34"
                                                        Margin="6,0,0,0"
                                                        IsEnabled="{Binding CanClearHotkey}"
                                                        Style="{StaticResource LongIconButton}"
                                                        ToolTip="{DynamicResource i18n.plugins.command.hotkey.clear}"
                                                        Click="CommandHotkeyClear_Click"
                                                        AutomationProperties.Name="{Binding HotkeyClearAutomationName}"
                                                        AutomationProperties.AutomationId="{Binding Key, StringFormat=Long.Workspace.PluginSettings.CommandHotkeyClear.{0}}">
                                                    <Path Data="{StaticResource Long.Icon.Close}"
                                                          Style="{StaticResource LongIcon}"
                                                          Width="12"
                                                          Height="12" />
                                                </Button>
                                                <TextBlock Grid.Row="2"
                                                           Grid.ColumnSpan="3"
                                                           Margin="0,5,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                                           Text="{Binding HotkeyStatus}"
                                                           AutomationProperties.Name="{Binding HotkeyStatusAutomationName}"
                                                           AutomationProperties.LiveSetting="Polite"
                                                           AutomationProperties.AutomationId="{Binding Key, StringFormat=Long.Workspace.PluginSettings.CommandHotkeyStatus.{0}}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="CommandsEmptyText"
                                   Grid.Row="0"
                                   Style="{StaticResource LongEmptyState}"
                                   Text="{DynamicResource i18n.plugins.commands.empty}"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="CommandFeedbackText"
                                   Grid.Row="1"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}"
                                   Visibility="Collapsed"
                                   AutomationProperties.AutomationId="Long.Workspace.PluginSettings.CommandFeedback"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="SettingsTab"
                         Style="{StaticResource PluginModuleTabItemStyle}"
                         AutomationProperties.AutomationId="Long.Workspace.PluginSettings.Tab.Settings"
                         Header="{DynamicResource i18n.plugins.settings}">
                    <Grid Margin="0,16,0,0">
                        <ContentControl x:Name="SettingsHost"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Top"
                                        AutomationProperties.AutomationId="Long.Workspace.PluginSettings.Content" />
                        <TextBlock x:Name="SettingsUnavailableText"
                                   Style="{StaticResource LongEmptyState}"
                                   Text="{DynamicResource i18n.plugins.settingsUnavailable}"
                                   Visibility="Collapsed" />
                    </Grid>
                </TabItem>
                <TabItem x:Name="CapabilitiesTab"
                         Style="{StaticResource PluginModuleTabItemStyle}"
                         AutomationProperties.AutomationId="Long.Workspace.PluginSettings.Tab.Capabilities"
                         Header="{DynamicResource i18n.plugins.capabilities}">
                    <Grid Margin="0,16,0,0">
                        <local:CapabilityDetailPanel x:Name="CapabilityPanel"
                                                     xmlns:local="clr-namespace:LongBetterWindows.Host.Views" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </StackPanel>
</UserControl>
