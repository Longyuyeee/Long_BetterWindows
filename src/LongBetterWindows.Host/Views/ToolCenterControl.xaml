<UserControl x:Class="LongBetterWindows.Host.Views.ToolCenterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LongBetterWindows.Host.Views"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Focusable="True" PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <Style x:Key="OverviewCard" TargetType="Border" BasedOn="{StaticResource LongCard}">
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="220" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 管理导航，只承担配置与管理职责 -->
        <Border Grid.Column="0" Background="{DynamicResource Long.Brush.Background.Raised}">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="8,0,8,18">
                    <TextBlock Text="TOOLCENTER" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                    <TextBlock Text="{DynamicResource i18n.shell.managementConfig}" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavOverview" Content="{DynamicResource i18n.nav.overview}" GroupName="MainNav" IsChecked="True"
                                 Style="{StaticResource LongNavigationItem}" Click="Navigation_Click" Tag="overview" />
                    <RadioButton x:Name="NavWorkflows" Content="{DynamicResource i18n.nav.workflows}" GroupName="MainNav"
                                 Style="{StaticResource LongNavigationItem}" Click="Navigation_Click" Tag="workflows" />
                    <RadioButton x:Name="NavPlugins" Content="{DynamicResource i18n.nav.plugins}" GroupName="MainNav"
                                 Style="{StaticResource LongNavigationItem}" Click="Navigation_Click" Tag="plugins" />
                    <RadioButton x:Name="NavMarket" Content="{DynamicResource i18n.nav.market}" GroupName="MainNav"
                                 Style="{StaticResource LongNavigationItem}" Click="Navigation_Click" Tag="market" />
                    <RadioButton x:Name="NavSystem" Content="{DynamicResource i18n.nav.system}" GroupName="MainNav"
                                 Style="{StaticResource LongNavigationItem}" Click="Navigation_Click" Tag="system" />
                    <RadioButton x:Name="NavDiagnostics" Content="{DynamicResource i18n.nav.diagnostics}" GroupName="MainNav"
                                 Style="{StaticResource LongNavigationItem}" Click="Navigation_Click" Tag="diagnostics" />
                    <RadioButton x:Name="NavDeveloper" Content="{DynamicResource i18n.nav.developer}" GroupName="MainNav"
                                 Style="{StaticResource LongNavigationItem}" Click="Navigation_Click" Tag="developer" />
                    <RadioButton x:Name="NavSettings" Content="{DynamicResource i18n.nav.settings}" GroupName="MainNav"
                                 Style="{StaticResource LongNavigationItem}" Click="Navigation_Click" Tag="settings" />
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource LongCard}" Padding="12" Effect="{x:Null}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Long.Brush.State.Success}" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource i18n.shell.hostHealthy}" Margin="7,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource i18n.shell.switchPages}" FontSize="9" Margin="14,5,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource Long.Brush.Stroke.Default}" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="104" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="PageHeader" Grid.Row="0" Margin="32,20,32,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="{DynamicResource i18n.page.overview.title}" FontSize="{DynamicResource Long.Type.Display}"
                               FontWeight="SemiBold" Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                    <TextBlock x:Name="PageSubtitle" Text="{DynamicResource i18n.page.overview.subtitle}"
                               FontSize="{DynamicResource Long.Type.Body}" Margin="0,5,0,0"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                          automation:AutomationProperties.AutomationId="Long.ToolCenter.ContentScroll"
                          automation:AutomationProperties.Name="{DynamicResource i18n.shell.pageContent}"
                          HorizontalContentAlignment="Stretch"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Border x:Name="ContentBodyFrame" Padding="32,0,32,32"
                        HorizontalAlignment="Stretch">
                <Grid x:Name="ContentBody">
                    <!-- 概览 -->
                    <StackPanel x:Name="PanelOverview">
                        <Border x:Name="WelcomeBanner" Visibility="Collapsed" Margin="0,0,0,18"
                                CornerRadius="{DynamicResource Long.Radius.Card}"
                                Background="{DynamicResource Long.Brush.Accent.Gradient}" Padding="22,18">
                            <Grid x:Name="WelcomeGrid">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="WelcomeTextColumn" Width="*"/>
                                    <ColumnDefinition x:Name="WelcomeActionColumn" Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Source="/LongBetterWindows.Host;component/Assets/app-icon.png"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource i18n.overview.welcome.title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Long.Brush.Text.OnAccent}" />
                                        <TextBlock Text="{DynamicResource i18n.overview.welcome.desc}"
                                                   Margin="0,6,10,0" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Long.Brush.Text.OnAccentMuted}" />
                                    </StackPanel>
                                </Grid>
                                <Button x:Name="WelcomeDismissButton" Grid.Column="1"
                                        Content="{DynamicResource i18n.overview.welcome.dismiss}" Style="{StaticResource LongButton}"
                                        Background="{DynamicResource Long.Brush.Surface.OnAccent}"
                                        BorderBrush="{DynamicResource Long.Brush.Stroke.OnAccent}" Foreground="{DynamicResource Long.Brush.Text.OnAccent}"
                                        Click="WelcomeDismiss_Click" />
                            </Grid>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,0,0,20">
                            <Border Style="{StaticResource OverviewCard}" Margin="0,0,12,0">
                                <StackPanel><TextBlock Text="{DynamicResource i18n.overview.metrics.plugins}" TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    <TextBlock x:Name="OverviewPluginCount" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource OverviewCard}" Margin="0,0,12,0">
                                <StackPanel><TextBlock Text="{DynamicResource i18n.overview.metrics.commands}" TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    <TextBlock x:Name="OverviewCommandCount" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource OverviewCard}">
                                <StackPanel><TextBlock Text="{DynamicResource i18n.overview.metrics.capabilities}" TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                    <TextBlock x:Name="OverviewCapabilityCount" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid x:Name="OverviewActionsGrid">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="OverviewPrimaryColumn" Width="1.3*"/>
                                <ColumnDefinition x:Name="OverviewGapColumn" Width="16"/>
                                <ColumnDefinition x:Name="OverviewStatusColumn" Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource OverviewCard}">
                                <Grid x:Name="OverviewLaunchGrid">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="OverviewLaunchTextColumn" Width="*"/>
                                        <ColumnDefinition x:Name="OverviewLaunchActionColumn" Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{DynamicResource i18n.overview.action.title}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource i18n.overview.action.desc}" Margin="0,7,12,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Secondary}" /></StackPanel>
                                    <Button x:Name="OverviewLaunchButton" Grid.Column="1"
                                            Content="{DynamicResource i18n.app.openCommandCenter}"
                                            automation:AutomationProperties.Name="{DynamicResource i18n.app.openCommandCenter}"
                                            Style="{StaticResource LongButton.Primary}"
                                            Click="OpenPalette_Click" />
                                </Grid>
                            </Border>
                            <Border x:Name="OverviewStatusCard" Grid.Column="2" Style="{StaticResource OverviewCard}">
                                <StackPanel><TextBlock Text="{DynamicResource i18n.overview.status.title}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource i18n.overview.status.ready}" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.State.Success}" />
                                    <TextBlock Text="{DynamicResource i18n.overview.status.releasePending}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Muted}" /></StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- 组合动作 -->
                    <Grid x:Name="PanelWorkflows" Visibility="Collapsed">
                        <ContentControl x:Name="WorkflowEditorHost"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        automation:AutomationProperties.AutomationId="Long.ToolCenter.WorkflowHost"
                                        automation:AutomationProperties.Name="组合动作工作台" />
                    </Grid>

                    <!-- 插件管理 -->
                    <Grid x:Name="PanelPlugins" Visibility="Collapsed">
                        <ContentControl x:Name="PluginManagementHost"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </Grid>

                    <!-- Long 原生插件市场 -->
                    <Grid x:Name="PanelMarket" Visibility="Collapsed">
                        <ContentControl x:Name="MarketHost" />
                    </Grid>

                    <!-- 系统集成 -->
                    <StackPanel x:Name="PanelSystem" Visibility="Collapsed">
                        <UniformGrid x:Name="SystemIntegrationGrid" Columns="2">
                            <Border Style="{StaticResource LongCard}" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource i18n.system.column.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource i18n.system.column.desc}" Margin="0,5,0,0" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/><TextBlock x:Name="ColumnStatusText" Margin="0,8,0,0"/></StackPanel><Button x:Name="ColumnButton" Grid.Column="1" Content="{DynamicResource i18n.action.enable}" Style="{StaticResource LongButton.Primary}" Click="ColumnButton_Click"/></Grid></Border>
                            <Border Style="{StaticResource LongCard}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource i18n.system.sparse.title}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource i18n.system.sparse.desc}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/>
                                        <TextBlock x:Name="SparsePackageStatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   automation:AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Button x:Name="SparsePackageButton" Content="{DynamicResource i18n.action.chooseRegister}"
                                                Style="{StaticResource LongButton.Primary}"
                                                Click="SparsePackageButton_Click"/>
                                        <Button x:Name="SparsePackageRemoveButton" Content="{DynamicResource i18n.action.uninstall}" Margin="0,6,0,0"
                                                Visibility="Collapsed"
                                                Style="{StaticResource LongButton}"
                                                Click="SparsePackageRemoveButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource LongCard}" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource i18n.system.legacy.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource i18n.system.legacy.desc}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/><TextBlock x:Name="ContextMenuStatusText" Margin="0,8,0,0" automation:AutomationProperties.LiveSetting="Polite"/></StackPanel><Button x:Name="ContextMenuButton" Grid.Column="1" Content="{DynamicResource i18n.action.register}" Style="{StaticResource LongButton.Primary}" Click="ContextMenuButton_Click"/></Grid></Border>
                            <Border Style="{StaticResource LongCard}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource i18n.system.startup.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource i18n.system.startup.desc}" Margin="0,5,0,0" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/><TextBlock x:Name="StartupStatusText" Margin="0,8,0,0"/></StackPanel><Button x:Name="StartupButton" Grid.Column="1" Content="{DynamicResource i18n.action.enable}" Style="{StaticResource LongButton.Primary}" Click="StartupButton_Click"/></Grid></Border>
                            <Border Style="{StaticResource LongCard}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{DynamicResource i18n.system.hotkey.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource i18n.system.hotkey.desc}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/><Border Style="{StaticResource LongHotkeyBadge}" HorizontalAlignment="Left" Margin="0,10,0,0"><TextBlock Text="Alt + Space" FontFamily="{DynamicResource Long.Font.Mono}"/></Border></StackPanel></Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- 平台诊断 -->
                    <Grid x:Name="PanelDiagnostics" Visibility="Collapsed">
                        <ContentControl x:Name="DiagnosticsHost" />
                    </Grid>

                    <!-- 开发者 -->
                    <StackPanel x:Name="PanelDev" Visibility="Collapsed">
                        <UniformGrid x:Name="DeveloperGrid" Columns="2">
                            <Border Style="{StaticResource LongCard}" Margin="0,0,12,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource i18n.developer.workbench.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource i18n.developer.workbench.desc}" Margin="0,5,0,0" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/></StackPanel><Button Grid.Column="1" Content="{DynamicResource i18n.action.open}" Style="{StaticResource LongButton.Primary}" Click="DevTools_Click" AutomationProperties.Name="{DynamicResource i18n.developer.workbench.openA11y}"/></Grid></Border>
                            <Border Style="{StaticResource LongCard}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource i18n.developer.design.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource i18n.developer.design.desc}" Margin="0,5,0,0" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/></StackPanel><Button Grid.Column="1" Content="{DynamicResource i18n.developer.design.preview}" Style="{StaticResource LongButton}" Click="DesignSystemPreview_Click" AutomationProperties.Name="{DynamicResource i18n.developer.design.previewA11y}"/></Grid></Border>
                            <Border Style="{StaticResource LongCard}" Margin="0,0,12,12"><StackPanel><TextBlock Text="{DynamicResource i18n.developer.docs.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource i18n.developer.docs.desc}" Margin="0,5,0,8" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/><StackPanel x:Name="DocLinksPanel"/></StackPanel></Border>
                            <Border Style="{StaticResource LongCard}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Source="/LongBetterWindows.Host;component/Assets/app-icon.png" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource i18n.developer.about.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="AboutVersion" Margin="0,6,0,0" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/><TextBlock x:Name="AboutStats" Margin="0,4,0,0" Foreground="{DynamicResource Long.Brush.Text.Muted}"/></StackPanel></Grid></Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- 设置 -->
                    <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                        <Border Style="{StaticResource LongCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource i18n.settings.language.title}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource i18n.settings.language.desc}" Margin="0,5,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/>
                                </StackPanel>
                                <ComboBox x:Name="LanguageSelector" Grid.Column="1" Width="156"
                                          VerticalAlignment="Center"
                                          SelectionChanged="LanguageSelector_SelectionChanged">
                                    <ComboBoxItem Tag="zh-CN" Content="{DynamicResource i18n.settings.language.zh}"/>
                                    <ComboBoxItem Tag="en-US" Content="{DynamicResource i18n.settings.language.en}"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LongCard}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource i18n.settings.theme.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource i18n.settings.theme.desc}" Margin="0,5,0,0" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/></StackPanel><Button Grid.Column="1" Content="{DynamicResource i18n.settings.theme.action}" Style="{StaticResource LongButton}" Click="ThemeToggle_Click"/></Grid></Border>
                        <Border Style="{StaticResource LongCard}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource i18n.settings.motion.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource i18n.settings.motion.desc}" Margin="0,5,0,0" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/></StackPanel><ToggleButton Grid.Column="1" Style="{StaticResource LongToggle}" IsChecked="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}, Mode=OneWay}" IsEnabled="False"/></Grid></Border>
                        <Border Style="{StaticResource LongCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{DynamicResource i18n.settings.update.title}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource i18n.settings.update.desc}" Margin="0,5,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/>
                                    <TextBlock x:Name="UpdateStatusText" Margin="0,8,0,0"
                                               Text="{DynamicResource i18n.settings.update.status.ready}"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                <Button x:Name="UpdateActionButton" Grid.Column="1"
                                        Content="{DynamicResource i18n.settings.update.action.check}"
                                        Style="{StaticResource LongButton.Primary}"
                                        Click="UpdateAction_Click"
                                        AutomationProperties.Name="{DynamicResource i18n.settings.update.action.check}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource LongCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource i18n.settings.gesture.title}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource i18n.settings.gesture.desc}"
                                           Margin="0,5,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Long.Brush.Text.Secondary}"/>
                                <TextBlock x:Name="MouseGestureStatusText" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Long.Brush.Text.Muted}"/>
                                <WrapPanel x:Name="MouseGestureButtons" Margin="0,12,0,0">
                                    <Button Content="{DynamicResource i18n.settings.gesture.disabled}" Tag="Disabled" Style="{StaticResource LongButton}"
                                            Click="MouseGestureMode_Click"/>
                                    <Button Content="{DynamicResource i18n.settings.gesture.middle}" Tag="MiddleButton" Style="{StaticResource LongButton}"
                                            Margin="6,0,0,0" Click="MouseGestureMode_Click"/>
                                    <Button Content="{DynamicResource i18n.settings.gesture.longRight}" Tag="LongRightPress" Style="{StaticResource LongButton}"
                                            Margin="6,0,0,0" Click="MouseGestureMode_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource LongCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource i18n.settings.privacy.title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource i18n.settings.privacy.desc}" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Long.Brush.Text.Secondary}"/><TextBlock x:Name="SearchPreferenceStatusText" Margin="0,8,0,0" Foreground="{DynamicResource Long.Brush.Text.Muted}"/></StackPanel><Button Grid.Column="1" Content="{DynamicResource i18n.settings.privacy.clear}" Style="{StaticResource LongButton}" Click="ClearSearchPreferences_Click"/></Grid></Border>
                    </StackPanel>
                </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
