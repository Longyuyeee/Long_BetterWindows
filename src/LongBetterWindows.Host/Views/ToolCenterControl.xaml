<UserControl x:Class="LongBetterWindows.Host.Views.ToolCenterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16">
            <TextBlock Text="Long窗口·全能助手" FontWeight="SemiBold" FontSize="16"
                       Margin="0,0,0,16" />

            <Border Background="#10000000" CornerRadius="12" Padding="20,16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="插件开发工具"
                                   FontSize="14" FontWeight="Medium" Foreground="#007AFF" />
                        <TextBlock Text="内置代码编辑器——写插件、测试、打包一体化"
                                   FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="打开"
                                Width="80" Height="32" FontSize="12"
                                Click="DevTools_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="系统功能" FontWeight="SemiBold" FontSize="13"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,10" />

            <Border Background="#10000000" CornerRadius="12" Padding="20,16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="备注列注入"
                                   FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="在资源管理器中显示「备注」列 (System.Comment)"
                                   FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="ColumnStatusText" Text=""
                                   FontSize="11" Foreground="#80000000" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="ColumnButton"
                                Content="一键开启"
                                Width="80" Height="32"
                                Click="ColumnButton_Click"
                                FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#10000000" CornerRadius="12" Padding="20,16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="右键菜单"
                                   FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="在文件夹右键菜单中显示「备注此文件夹」"
                                   FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="ContextMenuStatusText" Text=""
                                   FontSize="11" Foreground="#80000000" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="ContextMenuButton"
                                Content="注册"
                                Width="80" Height="32"
                                Click="ContextMenuButton_Click"
                                FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#10000000" CornerRadius="12" Padding="20,16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="开机自启"
                                   FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="系统启动时自动运行 Long窗口"
                                   FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="StartupStatusText" Text=""
                                   FontSize="11" Foreground="#80000000" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="StartupButton"
                                Content="启用"
                                Width="80" Height="32"
                                Click="StartupButton_Click"
                                FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#10000000" CornerRadius="12" Padding="20,16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="主题切换" FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="在暗色和亮色主题间切换" FontSize="12"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="切换" Width="80" Height="32" FontSize="12"
                                Click="ThemeToggle_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#10000000" CornerRadius="12" Padding="20,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="开发文档"
                               FontSize="14" FontWeight="Medium" />
                    <TextBlock Text="点击查看开发指南和设计文档"
                               FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,8" />
                    <StackPanel x:Name="DocLinksPanel" />
                </StackPanel>
            </Border>

            <Border Background="#10000000" CornerRadius="12" Padding="20,16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="关于 Long窗口"
                               FontSize="14" FontWeight="Medium" />
                    <TextBlock Text="v0.2.0-alpha · .NET 8.0 · WPF"
                               FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="打造极致优雅、深度集成的 Windows 效率增强中枢。"
                               FontSize="11" Foreground="#80000000"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="PluginsPanel" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
