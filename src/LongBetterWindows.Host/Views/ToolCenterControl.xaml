<UserControl x:Class="LongBetterWindows.Host.Views.ToolCenterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16">
            <TextBlock Text="工具中心" FontWeight="SemiBold" FontSize="16"
                       Margin="0,0,0,16" />

            <Border Background="#10000000" CornerRadius="12" Padding="20,16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="ToolNameText" Text="文件夹备注助手"
                                   FontSize="14" FontWeight="Medium" />
                        <TextBlock x:Name="ToolDescText"
                                   Text="为文件夹添加备注，热键 Alt+M"
                                   FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="StatusText" Text="未启用"
                                   FontSize="11" Foreground="#80000000" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="ToggleButton"
                                Content="启用"
                                Width="80" Height="32"
                                Click="ToggleButton_Click"
                                FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#10000000" CornerRadius="12" Padding="20,16"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="备注列注入"
                                   FontSize="14" FontWeight="Medium" />
                        <TextBlock Text="在资源管理器中显示「备注」列 (System.Comment)"
                                   FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="ColumnStatusText" Text=""
                                   FontSize="11" Foreground="#80000000" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="ColumnButton"
                                Content="一键开启"
                                Width="80" Height="32"
                                Click="ColumnButton_Click"
                                FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:Name="PluginsPanel" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
