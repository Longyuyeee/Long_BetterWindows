<UserControl x:Class="LongBetterWindows.Host.Views.ToolCenterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Style="{StaticResource DarkScrollViewerStyle}">
        <StackPanel Margin="20,16">

            <!-- ═══ 标题 ═══ -->
            <TextBlock Text="Long窗口·全能助手" FontWeight="SemiBold" FontSize="16"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2" />
            <TextBlock Text="打造极致优雅、深度集成的 Windows 效率增强中枢。"
                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,16" />

            <!-- ═══ 分段控件 ═══ -->
            <Border Style="{StaticResource SegmentedBarStyle}" Margin="0,0,0,14"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="TabSystem"   Content="系统配置" Style="{StaticResource SegmentedTabStyle}" Click="Tab_Click" />
                    <Button x:Name="TabPlugins"  Content="插件管理" Style="{StaticResource SegmentedTabStyle}" Click="Tab_Click" />
                    <Button x:Name="TabDev"      Content="开发工具" Style="{StaticResource SegmentedTabStyle}" Click="Tab_Click" />
                </StackPanel>
            </Border>

            <!-- ═══ 分隔线 ═══ -->
            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,12" />

            <!-- ═══════════════════════════════════════ -->
            <!-- 面板 1: 系统配置                         -->
            <!-- ═══════════════════════════════════════ -->
            <StackPanel x:Name="PanelSystem" Visibility="Visible">

                <!-- 首次运行欢迎横幅 -->
                <Border x:Name="WelcomeBanner" Visibility="Collapsed"
                        Background="{StaticResource AccentBlueBrush}" CornerRadius="10"
                        Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="欢迎使用 Long窗口！" FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,0,0,4" />
                        <TextBlock FontSize="11" Foreground="#D0E0FF" TextWrapping="Wrap"
                                   Text="三个面板助你高效工作：系统配置管理底层能力，插件管理启停插件，开发工具快速创建和调试。点击顶部标签切换面板。" />
                        <Button Content="了解了" Width="64" Height="24"
                                FontSize="11" Foreground="White"
                                Background="#30FFFFFF" BorderThickness="0"
                                Cursor="Hand" Margin="0,8,0,0"
                                Click="WelcomeDismiss_Click" />
                    </StackPanel>
                </Border>

                <!-- 系统功能卡片 (WrapPanel = 窄屏1列 / 宽屏2列) -->
                <WrapPanel x:Name="SystemCardsPanel" ItemWidth="215">

                <!-- 备注列注入 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="备注列注入" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="在资源管理器中显示「备注」列"
                                       Style="{StaticResource CardDescStyle}" />
                            <TextBlock x:Name="ColumnStatusText" FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="ColumnButton" Grid.Column="1"
                                Content="一键开启"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="76" Click="ColumnButton_Click" />
                    </Grid>
                </Border>

                <!-- 右键菜单 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="右键菜单" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="在文件夹右键菜单中添加「备注此文件夹」"
                                       Style="{StaticResource CardDescStyle}" />
                            <TextBlock x:Name="ContextMenuStatusText" FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="ContextMenuButton" Grid.Column="1"
                                Content="注册"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="76" Click="ContextMenuButton_Click" />
                    </Grid>
                </Border>

                <!-- 开机自启 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="开机自启" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="系统启动时自动运行 Long窗口"
                                       Style="{StaticResource CardDescStyle}" />
                            <TextBlock x:Name="StartupStatusText" FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="StartupButton" Grid.Column="1"
                                Content="启用"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="76" Click="StartupButton_Click" />
                    </Grid>
                </Border>

                <!-- 主题切换 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="主题切换" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="暗色 / 亮色主题一键切换"
                                       Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="切换"
                                Style="{StaticResource SecondaryButtonStyle}" Width="72"
                                Click="ThemeToggle_Click" />
                    </Grid>
                </Border>

                </WrapPanel>

            </StackPanel>

            <!-- ═══════════════════════════════════════ -->
            <!-- 面板 2: 插件管理                         -->
            <!-- ═══════════════════════════════════════ -->
            <StackPanel x:Name="PanelPlugins" Visibility="Collapsed">

                <!-- 插件列表 header + 搜索 + 刷新 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock x:Name="PluginsHeader" Text="已安装插件" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="PluginSearchBox" Width="120" Height="22"
                             FontSize="11" Margin="12,0,0,0"
                             VerticalContentAlignment="Center"
                             Style="{x:Null}"
                             Background="{StaticResource CardBackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource DividerBrush}"
                             BorderThickness="1"
                             CaretBrush="{StaticResource AccentBlueBrush}"
                             TextChanged="PluginSearch_TextChanged"
                             ToolTip="搜索插件..." />
                    <Button Content="刷新" Width="48" Height="22"
                            ToolTip="重新扫描插件目录"
                            FontSize="11" Foreground="#CCCCCC"
                            Background="#3A3A3D" BorderThickness="0"
                            Cursor="Hand" Margin="12,0,0,0"
                            Click="RefreshPlugins_Click" />
                </StackPanel>

                <!-- 插件加载中提示 -->
                <TextBlock x:Name="PluginsLoading" Text="正在扫描插件..."
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,4,0,0" />

                <!-- 插件卡片容器 (动态填充) -->
                <StackPanel x:Name="PluginsPanel" />

            </StackPanel>

            <!-- ═══════════════════════════════════════ -->
            <!-- 面板 3: 开发工具                         -->
            <!-- ═══════════════════════════════════════ -->
            <StackPanel x:Name="PanelDev" Visibility="Collapsed">

                <WrapPanel ItemWidth="215">
                <!-- 插件开发工具 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="插件开发工具" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="内置代码编辑器——写插件、测试、打包一体化"
                                       Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="DevTools_Click" />
                    </Grid>
                </Border>

                <!-- 开发文档 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="开发文档" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="点击查看开发指南和设计文档"
                                   Style="{StaticResource CardDescStyle}" />
                        <StackPanel x:Name="DocLinksPanel" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="关于 Long窗口" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="AboutVersion" Text="v0.4.0 · .NET 8.0 · WPF"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,2,0,0" />
                        <TextBlock x:Name="AboutStats"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                </WrapPanel>

            </StackPanel>

            <!-- 底部留白 -->
            <Border Height="16" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
