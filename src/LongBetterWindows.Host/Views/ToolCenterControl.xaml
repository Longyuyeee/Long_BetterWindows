<UserControl x:Class="LongBetterWindows.Host.Views.ToolCenterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E8E8E8" />
        </Style>
        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Width" Value="72" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#007AFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0062CC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button"
               BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#3A3A3D" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A4A4D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GreenBtn" TargetType="Button"
               BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#34C759" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2DAF4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RedBtn" TargetType="Button"
               BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#FF3B30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0352B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>
        <Style x:Key="DocLink" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#007AFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1F22">
        <StackPanel Margin="20,16">

            <!-- 标题 -->
            <TextBlock Text="Long窗口·全能助手" FontWeight="SemiBold" FontSize="16"
                       Foreground="#E8E8E8" Margin="0,0,0,2" />
            <TextBlock Text="打造极致优雅、深度集成的 Windows 效率增强中枢。"
                       FontSize="11" Foreground="#888888" Margin="0,0,0,16" />

            <!-- 插件开发工具 -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="插件开发工具" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="内置代码编辑器——写插件、测试、打包一体化"
                                   Style="{StaticResource CardDesc}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="打开"
                            Style="{StaticResource PrimaryBtn}"
                            Click="DevTools_Click" />
                </Grid>
            </Border>

            <!-- 系统功能 -->
            <TextBlock Text="系统功能" Style="{StaticResource SectionTitle}" />

            <!-- 备注列 -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="备注列注入" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="在资源管理器中显示「备注」列"
                                   Style="{StaticResource CardDesc}" />
                        <TextBlock x:Name="ColumnStatusText" FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="ColumnButton" Grid.Column="1"
                            Content="一键开启" Style="{StaticResource PrimaryBtn}"
                            Width="76" Click="ColumnButton_Click" />
                </Grid>
            </Border>

            <!-- 右键菜单 -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="右键菜单" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="在文件夹右键菜单中添加「备注此文件夹」"
                                   Style="{StaticResource CardDesc}" />
                        <TextBlock x:Name="ContextMenuStatusText" FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="ContextMenuButton" Grid.Column="1"
                            Content="注册" Style="{StaticResource PrimaryBtn}"
                            Width="76" Click="ContextMenuButton_Click" />
                </Grid>
            </Border>

            <!-- 开机自启 -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="开机自启" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="系统启动时自动运行 Long窗口"
                                   Style="{StaticResource CardDesc}" />
                        <TextBlock x:Name="StartupStatusText" FontSize="11"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="StartupButton" Grid.Column="1"
                            Content="启用" Style="{StaticResource PrimaryBtn}"
                            Width="76" Click="StartupButton_Click" />
                </Grid>
            </Border>

            <!-- 主题切换 -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="主题切换" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="暗色 / 亮色主题一键切换"
                                   Style="{StaticResource CardDesc}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="切换"
                            Style="{StaticResource SecondaryBtn}" Width="72"
                            Click="ThemeToggle_Click" />
                </Grid>
            </Border>

            <!-- 文档 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="开发文档" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="点击查看开发指南和设计文档"
                               Style="{StaticResource CardDesc}" />
                    <StackPanel x:Name="DocLinksPanel" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="关于 Long窗口" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="v0.2.0-alpha · .NET 8.0 · WPF"
                               Foreground="#999999" FontSize="11" Margin="0,2,0,0" />
                    <TextBlock Text="12 项原子能力 · 16 个插件 · 3 种运行时"
                               Foreground="#777777" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- 插件列表 -->
            <StackPanel x:Name="PluginsPanel" Margin="0,4,0,16" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
