<Window x:Class="LongBetterWindows.Host.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LongBetterWindows.Host.Controls"
        xmlns:interaction="clr-namespace:LongBetterWindows.Host.Interaction"
        Title="Long Command Palette"
        Width="700" Height="470"
        MinWidth="560" MinHeight="320"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{DynamicResource Long.Brush.Surface.Overlay}"
        ShowInTaskbar="False"
        Topmost="True"
        Style="{StaticResource LongWindowChrome}"
        WindowStartupLocation="CenterScreen"
        Deactivated="Window_Deactivated"
        AutomationProperties.AutomationId="Long.CommandPalette"
        AutomationProperties.Name="{DynamicResource i18n.palette.title}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border x:Name="PaletteChrome"
            Background="{DynamicResource Long.Brush.Surface.Overlay}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Strong}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Long.Radius.Flyout}"
            Padding="16">
        <Border.Effect>
            <StaticResource ResourceKey="Long.Shadow.Level3" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Height="2" VerticalAlignment="Top" Margin="18,-16,18,0"
                    CornerRadius="0,0,3,3" Background="{DynamicResource Long.Brush.Accent.Gradient}" />

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource Long.Icon.Search}"
                      Style="{StaticResource LongIcon}"
                      Margin="4,0,14,0" VerticalAlignment="Center" />
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Style="{StaticResource LongSearchBox}"
                         FontSize="20" FontWeight="SemiBold"
                         BorderThickness="0" Background="Transparent"
                         AutomationProperties.AutomationId="Long.CommandPalette.Search"
                         AutomationProperties.Name="{DynamicResource i18n.palette.searchAutomation}"
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_KeyDown" />
                <TextBlock x:Name="SearchHint" Grid.Column="1" Text="{DynamicResource i18n.palette.searchHint}"
                           IsHitTestVisible="False" VerticalAlignment="Center"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                <Border Grid.Column="2" Style="{StaticResource LongHotkeyBadge}"
                        VerticalAlignment="Center">
                    <TextBlock Text="ESC" FontSize="10"
                               FontFamily="{DynamicResource Long.Font.Mono}"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </Border>
            </Grid>

            <Border Grid.Row="1" Height="1" Margin="0,10,0,10"
                    Background="{DynamicResource Long.Brush.Stroke.Default}" />

            <Grid Grid.Row="2">
            <ListBox x:Name="ResultsList"
                     IsSynchronizedWithCurrentItem="True"
                     AutomationProperties.AutomationId="Long.CommandPalette.Results"
                     AutomationProperties.Name="{DynamicResource i18n.palette.resultsAutomation}"
                     AutomationProperties.LiveSetting="Polite"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
                </ListBox.Resources>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Margin="8,9,8,5"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource LongCommandItem}">
                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Margin="0,0,11,0"
                                    CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"
                                                Value="{DynamicResource Long.Brush.Background.Raised}" />
                                        <Setter Property="BorderBrush"
                                                Value="{DynamicResource Long.Brush.Stroke.Default}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIconLabel}" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Long.Brush.Accent.Soft}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource Long.Brush.Accent.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Path Width="17" Height="17"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource Long.Brush.Accent.Primary}"
                                          StrokeThickness="1.6">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource Long.Icon.Command}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconKind}"
                                                                 Value="{x:Static interaction:SearchResultIconKind.Management}">
                                                        <Setter Property="Data" Value="{StaticResource Long.Icon.Settings}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconKind}"
                                                                 Value="{x:Static interaction:SearchResultIconKind.Marketplace}">
                                                        <Setter Property="Data" Value="{StaticResource Long.Icon.Plugin}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconKind}"
                                                                 Value="{x:Static interaction:SearchResultIconKind.Plugin}">
                                                        <Setter Property="Data" Value="{StaticResource Long.Icon.Plugin}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconKind}"
                                                                 Value="{x:Static interaction:SearchResultIconKind.Settings}">
                                                        <Setter Property="Data" Value="{StaticResource Long.Icon.Settings}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasIconPath}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasIconLabel}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <controls:DecorativeTextBlock Text="{Binding IconLabel}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Long.Brush.Accent.Primary}"
                                               Focusable="False"
                                               IsHitTestVisible="False">
                                        <controls:DecorativeTextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasIconLabel}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:DecorativeTextBlock.Style>
                                    </controls:DecorativeTextBlock>
                                    <Image Source="{Binding IconPath}"
                                           Width="26" Height="26"
                                           Stretch="Uniform">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasIconPath}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource Long.Brush.Text.Secondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Click="SecondaryActions_Click"
                                    Width="28" Height="28" Margin="8,0,2,0"
                                    ToolTip="{DynamicResource i18n.palette.moreActions}" Content="⋯"
                                    AutomationProperties.AutomationId="Long.Result.MoreActions"
                                    AutomationProperties.Name="{DynamicResource i18n.palette.moreResultActions}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LongIconButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSecondaryActions}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="3" Tag="{Binding Id}"
                                    Click="PinResult_Click"
                                    Width="28" Height="28" Margin="8,0,2,0"
                                    ToolTip="{DynamicResource i18n.palette.togglePin}"
                                    AutomationProperties.Name="{DynamicResource i18n.palette.togglePin}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource LongIconButton}">
                                        <Setter Property="Content" Value="☆" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanPin}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Content" Value="★" />
                                                <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Accent.Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Source}"
                                       FontSize="11" Margin="16,0,2,0"
                                       Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource Long.Icon.Command}" Style="{StaticResource LongIcon}"
                          Width="28" Height="28" HorizontalAlignment="Center"
                          Stroke="{DynamicResource Long.Brush.Text.Muted}" />
                    <TextBlock x:Name="EmptyStateText" Text="{DynamicResource i18n.palette.empty}"
                               Style="{StaticResource LongEmptyState}" Margin="0,10,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="4,10,4,0">
                <TextBlock Text="{DynamicResource i18n.palette.keyboardHint}"
                           FontSize="10"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                <ItemsControl x:Name="ContextBadges" HorizontalAlignment="Center"
                              MaxWidth="380" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource LongBadge}" Margin="2,0"
                                    AutomationProperties.Name="{Binding Label}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" MaxWidth="150"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="10" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="{Binding Id}"
                                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                    <Button Content="×" Tag="{Binding Id}" Click="ContextRemove_Click"
                                            Width="16" Height="16" Margin="5,0,-3,0" Padding="0"
                                            BorderThickness="0" Background="Transparent"
                                            Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                            AutomationProperties.Name="{DynamicResource i18n.palette.removeContext}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="StatusText" HorizontalAlignment="Right"
                           FontSize="10"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                <TextBlock x:Name="SelectionAnnouncement"
                           Width="1" Height="1" Opacity="0"
                           IsHitTestVisible="False" Focusable="False"
                           AutomationProperties.AutomationId="Long.CommandPalette.SelectionAnnouncement"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Grid>
    </Border>
</Window>
