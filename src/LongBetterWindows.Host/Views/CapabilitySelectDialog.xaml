<Window x:Class="LongBetterWindows.Host.Views.CapabilitySelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="440" Height="360" MinWidth="360" MinHeight="300"
        Style="{StaticResource LongWindowChrome}"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Long.UI.Select.Window"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource Long.Brush.Surface.Card}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
            BorderThickness="1" CornerRadius="{DynamicResource Long.Radius.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Long.Brush.Background.Raised}"
                    BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                    BorderThickness="0,0,0,1" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               Margin="0,0,42,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Long.Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis" />
                    <Button HorizontalAlignment="Right" Width="32" Height="30"
                            Style="{StaticResource LongIconButton}" Click="Cancel_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="Long.UI.Select.Close"
                            AutomationProperties.Name="{DynamicResource i18n.action.cancel}">
                        <Path Data="{StaticResource Long.Icon.Close}" Style="{StaticResource LongIcon}"
                              Width="13" Height="13" />
                    </Button>
                </Grid>
            </Border>
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="24,20,24,12"
                       Foreground="{DynamicResource Long.Brush.Text.Secondary}"
                       FontSize="13" LineHeight="20" TextWrapping="Wrap" />
            <ListBox x:Name="OptionsList" Grid.Row="2" Margin="24,0"
                     Background="{DynamicResource Long.Brush.Background.Raised}"
                     Foreground="{DynamicResource Long.Brush.Text.Primary}"
                     BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                     BorderThickness="1" Padding="5"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource LongCommandItem}"
                     AutomationProperties.AutomationId="Long.UI.Select.Options" />
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="24,20,24,22">
                <Button Style="{StaticResource LongButton}" Margin="0,0,8,0"
                        Click="Cancel_Click" IsCancel="True"
                        AutomationProperties.AutomationId="Long.UI.Select.Cancel"
                        Content="{DynamicResource i18n.action.cancel}" />
                <Button Style="{StaticResource LongButton.Primary}"
                        Click="Confirm_Click" IsDefault="True"
                        AutomationProperties.AutomationId="Long.UI.Select.Confirm"
                        Content="{DynamicResource i18n.action.confirm}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
