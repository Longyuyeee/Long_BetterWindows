<UserControl x:Class="LongBetterWindows.Host.Views.PerformancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- 标题 -->
            <TextBlock Text="性能监控" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource LightTextBrush}" Margin="0,0,0,20"/>

            <!-- 系统性能卡片 -->
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="系统性能" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource LightTextBrush}" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU 使用率 -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="CPU 使用率" FontSize="12"
                                       Foreground="{DynamicResource GrayBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="CpuPercentText" Text="0.0%" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource BlueBrush}"/>
                            <TextBlock x:Name="CpuAvgText" Text="平均: 0.0%" FontSize="11"
                                       Foreground="{DynamicResource GrayBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 内存使用 -->
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="内存使用" FontSize="12"
                                       Foreground="{DynamicResource GrayBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MemoryText" Text="0 MB" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource GreenBrush}"/>
                            <TextBlock Text="工作集" FontSize="11"
                                       Foreground="{DynamicResource GrayBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- API 调用总数 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="API 调用" FontSize="12"
                                       Foreground="{DynamicResource GrayBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ApiCallsText" Text="0" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource OrangeBrush}"/>
                            <TextBlock x:Name="PluginCountText" Text="0 个插件" FontSize="11"
                                       Foreground="{DynamicResource GrayBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- CPU 历史图表占位 -->
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                            CornerRadius="8" Height="120" Margin="0,16,0,0">
                        <Canvas x:Name="CpuChartCanvas"/>
                    </Border>

                    <TextBlock Text="CPU 使用率历史（最近 60 秒）" FontSize="11"
                               Foreground="{DynamicResource GrayBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 插件性能排行 -->
            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="插件性能排行" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource LightTextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="🔄 刷新" HorizontalAlignment="Right"
                                Background="Transparent"
                                Foreground="{DynamicResource BlueBrush}"
                                BorderThickness="0" Cursor="Hand"
                                Click="RefreshButton_Click"/>
                    </Grid>

                    <StackPanel x:Name="PluginPerformancePanel"/>

                    <TextBlock x:Name="NoDataText" Text="暂无性能数据"
                               FontSize="13" Foreground="{DynamicResource GrayBrush}"
                               HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
