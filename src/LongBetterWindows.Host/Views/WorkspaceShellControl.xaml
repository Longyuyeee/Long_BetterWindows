<UserControl x:Class="LongBetterWindows.Host.Views.WorkspaceShellControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LongBetterWindows.Host.Views"
             AutomationProperties.AutomationId="Long.Workspace.Shell">
    <UserControl.Resources>
        <Style x:Key="WorkspaceModuleTabStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Secondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource Long.Brush.Background.Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Long.Brush.Accent.Primary}" />
                                <Setter TargetName="Surface"
                                        Property="BorderThickness"
                                        Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Background"
                                        Value="{DynamicResource Long.Brush.Accent.Soft}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Long.Brush.Text.Primary}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceModuleCloseStyle"
               TargetType="Button"
               BasedOn="{StaticResource LongIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0,3,0" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanClose}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Long.Brush.Background.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Long.Brush.Background.Raised}"
                BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="ModuleScroller"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              Padding="10,5">
                    <ItemsControl x:Name="ModuleItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ModuleTabButton"
                                            Style="{StaticResource WorkspaceModuleTabStyle}"
                                            Tag="{Binding Key}"
                                            ToolTip="{Binding Title}"
                                            Click="ModuleTab_Click"
                                            AutomationProperties.Name="{Binding Title}"
                                            AutomationProperties.AutomationId="Long.Workspace.ModuleTab">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource WorkspaceModuleCloseStyle}"
                                            Tag="{Binding Key}"
                                            Click="ModuleClose_Click"
                                            ToolTip="{DynamicResource i18n.app.close}"
                                            AutomationProperties.Name="{DynamicResource i18n.app.close}"
                                            AutomationProperties.AutomationId="Long.Workspace.ModuleClose">
                                        <Path Data="{StaticResource Long.Icon.Close}"
                                              Style="{StaticResource LongIcon}"
                                              Width="11"
                                              Height="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid x:Name="WorkspaceSearchHost"
                      Grid.Column="1"
                      Width="280"
                      Margin="8,5,10,5"
                      Visibility="Collapsed">
                    <TextBox x:Name="WorkspaceSearchBox"
                             Style="{StaticResource LongSearchBox}"
                             Height="34"
                             Padding="12,0,34,0"
                             FontSize="12"
                             FontWeight="Normal"
                             TextChanged="WorkspaceSearchBox_TextChanged"
                             AutomationProperties.AutomationId="Long.Workspace.Search" />
                    <TextBlock x:Name="WorkspaceSearchHint"
                               Margin="12,0,34,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Long.Brush.Text.Muted}"
                               IsHitTestVisible="False"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=WorkspaceSearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="ClearWorkspaceSearchButton"
                            Width="28"
                            Height="28"
                            Margin="0,0,3,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource LongIconButton}"
                            ToolTip="{DynamicResource i18n.action.clear}"
                            AutomationProperties.Name="{DynamicResource i18n.action.clear}"
                            AutomationProperties.AutomationId="Long.Workspace.Search.Clear"
                            Visibility="Collapsed"
                            Click="ClearWorkspaceSearch_Click">
                        <Path Data="{StaticResource Long.Icon.Close}"
                              Style="{StaticResource LongIcon}"
                              Width="10"
                              Height="10" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <local:InstalledPluginRailControl x:Name="InstalledPluginRail" />
            <Grid Grid.Column="1">
                <local:ToolCenterControl x:Name="ToolCenterContent" />
                <Grid x:Name="PluginRuntimeSurface"
                      Visibility="Collapsed"
                      Background="{DynamicResource Long.Brush.Background.Base}"
                      AutomationProperties.AutomationId="Long.Workspace.PluginRuntime">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource Long.Brush.Background.Raised}">
                        <Grid Margin="16,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="6"
                                        Background="{DynamicResource Long.Brush.Accent.Soft}">
                                    <Path Data="{StaticResource Long.Icon.Plugin}"
                                          Style="{StaticResource LongIcon}"
                                          Width="14" Height="14"
                                          Stroke="{DynamicResource Long.Brush.Accent.Primary}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="PluginRuntimeTitle"
                                           Margin="9,0,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Style="{StaticResource LongBadge}"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource i18n.pluginWindow.embeddedMode}"
                                               FontSize="9"
                                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource LongButton}"
                                    Height="30"
                                    Margin="0,0,7,0"
                                    Content="{DynamicResource i18n.plugins.settings}"
                                    Click="PluginRuntimeSettings_Click"
                                    AutomationProperties.AutomationId="Long.Workspace.PluginRuntime.Settings" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource LongButton}"
                                    Height="30"
                                    Margin="0,0,7,0"
                                    Content="{DynamicResource i18n.pluginWindow.detach}"
                                    Click="PluginRuntimeDetach_Click"
                                    AutomationProperties.AutomationId="Long.Workspace.PluginRuntime.Detach" />
                            <Button x:Name="PluginRuntimeEndButton"
                                    Grid.Column="3"
                                    Style="{StaticResource LongButton}"
                                    Height="30"
                                    Content="{DynamicResource i18n.pluginWindow.endRun}"
                                    Click="PluginRuntimeEnd_Click"
                                    AutomationProperties.AutomationId="Long.Workspace.PluginRuntime.End" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <ContentControl x:Name="PluginRuntimeContent" />
                        <TextBlock x:Name="PluginRuntimeDetachedText"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Long.Brush.Text.Muted}"
                                   FontSize="13"
                                   Text="{DynamicResource i18n.pluginWindow.detachedMode}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
