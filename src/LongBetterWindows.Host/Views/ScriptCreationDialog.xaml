<Window x:Class="LongBetterWindows.Host.Views.ScriptCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource i18n.developer.script.title}" Height="410" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource Long.Brush.Text.Primary}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="RadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{DynamicResource Long.Brush.Surface.Card}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
            BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource i18n.developer.script.heading}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Long.Brush.Text.Primary}" Margin="0,0,0,20" />

            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource i18n.developer.script.fileName}" FontSize="12" Foreground="{DynamicResource Long.Brush.Text.Secondary}" Margin="0,0,0,6" />
                <TextBox x:Name="ScriptNameBox" Height="32" FontSize="13"
                         Style="{StaticResource LongTextBox}"
                         Padding="8,6" Text="my-plugin"
                         AutomationProperties.Name="{DynamicResource i18n.developer.script.fileName}"
                         CaretBrush="{DynamicResource Long.Brush.Accent.Primary}" />
                <TextBlock Text="{DynamicResource i18n.developer.script.extensionHint}"
                           FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Muted}" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource i18n.developer.script.language}" FontSize="12" Foreground="{DynamicResource Long.Brush.Text.Secondary}" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LangCSharp" Content="C# Script (.csx)"
                                 GroupName="Language" IsChecked="False"
                                 Style="{StaticResource RadioButtonStyle}" />
                    <RadioButton x:Name="LangJS" Content="JavaScript (.js)"
                                 GroupName="Language" IsChecked="True"
                                 Style="{StaticResource RadioButtonStyle}" />
                    <RadioButton x:Name="LangTS" Content="TypeScript (.ts)"
                                 GroupName="Language" IsChecked="False"
                                 Style="{StaticResource RadioButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource i18n.developer.script.template}" FontSize="12" Foreground="{DynamicResource Long.Brush.Text.Secondary}" Margin="0,0,0,8" />
                <StackPanel>
                    <RadioButton x:Name="TplHotkey" Content="{DynamicResource i18n.developer.script.template.hotkey}"
                                 GroupName="Template" IsChecked="True"
                                 Style="{StaticResource RadioButtonStyle}"
                                 Margin="0,0,0,6" />
                    <RadioButton x:Name="TplNote" Content="{DynamicResource i18n.developer.script.template.note}"
                                 GroupName="Template" IsChecked="False"
                                 Style="{StaticResource RadioButtonStyle}"
                                 Margin="0,0,0,6" />
                    <RadioButton x:Name="TplBlank" Content="{DynamicResource i18n.developer.script.template.blank}"
                                 GroupName="Template" IsChecked="False"
                                 Style="{StaticResource RadioButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <CheckBox x:Name="OpenEditorCheck" Grid.Row="4" Content="{DynamicResource i18n.developer.script.openEditor}"
                      Style="{StaticResource LongCheckBox}" FontSize="11" IsChecked="False" Margin="0,0,0,16" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource i18n.action.cancel}" Width="80" Height="32" Margin="0,0,8,0"
                        Style="{StaticResource LongButton}"
                        FontSize="12" Cursor="Hand" Click="Cancel_Click" />
                <Button Content="{DynamicResource i18n.action.create}" Width="80" Height="32"
                        Style="{StaticResource LongButton.Primary}"
                        FontSize="12" Cursor="Hand" Click="Create_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
