<Window x:Class="LongBetterWindows.Host.Views.PluginDevTools"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="900" Height="650" MinWidth="600" MinHeight="400"
        Style="{StaticResource LongWindowChrome}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Long.Developer.Workbench.Window">
    <Border Background="{DynamicResource Long.Brush.Background.Base}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
            BorderThickness="1" CornerRadius="{DynamicResource Long.Radius.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Long.Brush.Background.Raised}"
                    BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                    BorderThickness="0,0,0,1" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               Margin="0,0,42,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Long.Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis" />
                    <Button HorizontalAlignment="Right" Width="32" Height="30"
                            Style="{StaticResource LongIconButton}" Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="Long.Developer.Workbench.Close"
                            AutomationProperties.Name="{DynamicResource i18n.developer.design.close}">
                        <Path Data="{StaticResource Long.Icon.Close}" Style="{StaticResource LongIcon}"
                              Width="13" Height="13" />
                    </Button>
                </Grid>
            </Border>
            <Grid x:Name="WebViewHost" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
