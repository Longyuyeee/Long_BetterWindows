<Window x:Class="LongBetterWindows.Host.Views.PluginWindowHost"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="插件"
        MinWidth="420" MinHeight="280"
        Width="720" Height="560"
        Style="{StaticResource LongWindowChrome}"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Long.Plugin.DetachedWindow"
        AutomationProperties.Name="Long 分离插件窗口"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource Long.Brush.Background.Base}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
            BorderThickness="1" CornerRadius="{DynamicResource Long.Radius.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Long.Brush.Background.Raised}"
                    BorderBrush="{DynamicResource Long.Brush.Stroke.Default}" BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <Button HorizontalAlignment="Left" Style="{StaticResource LongIconButton}"
                            Width="30" Height="30" Click="Back_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="Long.Plugin.DetachedBack"
                            ToolTip="返回管理中心" AutomationProperties.Name="返回管理中心">
                        <TextBlock Text="‹" FontSize="22" Margin="0,-3,0,0" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="40,0,42,0">
                        <Border Width="24" Height="24" CornerRadius="7"
                                Background="{DynamicResource Long.Brush.Accent.Soft}">
                            <Path Data="{StaticResource Long.Icon.Plugin}" Style="{StaticResource LongIcon}"
                                  Width="14" Height="14" Stroke="{DynamicResource Long.Brush.Accent.Primary}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="PluginTitle" Margin="9,0,0,0" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                        <Border Style="{StaticResource LongBadge}" Margin="9,0,0,0">
                            <TextBlock Text="分离窗口" FontSize="9"
                                       Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                        </Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource LongIconButton}"
                            Width="32" Height="30" Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="Long.Plugin.DetachedClose"
                            AutomationProperties.Name="关闭插件窗口">
                        <Path Data="{StaticResource Long.Icon.Close}" Style="{StaticResource LongIcon}" Width="13" Height="13" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="1">
                <ContentPresenter x:Name="PluginContent" />
            </Border>
        </Grid>
    </Border>
</Window>
