<Window x:Class="LongBetterWindows.Host.Views.CapabilityInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="440" MinWidth="360" SizeToContent="Height"
        Style="{StaticResource LongWindowChrome}"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Long.UI.Prompt.Window"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="DialogSurface"
            Background="{DynamicResource Long.Brush.Surface.Card}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
            BorderThickness="1" CornerRadius="{DynamicResource Long.Radius.Card}"
            AutomationProperties.AutomationId="Long.UI.Prompt.Surface">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Long.Brush.Background.Raised}"
                    BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                    BorderThickness="0,0,0,1" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                               Margin="0,0,42,0" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Long.Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis" />
                    <Button HorizontalAlignment="Right" Width="32" Height="30"
                            Style="{StaticResource LongIconButton}" Click="Cancel_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.AutomationId="Long.UI.Prompt.Close"
                            AutomationProperties.Name="{DynamicResource i18n.action.cancel}">
                        <Path Data="{StaticResource Long.Icon.Close}" Style="{StaticResource LongIcon}"
                              Width="13" Height="13" />
                    </Button>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="24,22,24,0">
                <TextBlock x:Name="MessageText" Margin="0,0,0,12"
                           Foreground="{DynamicResource Long.Brush.Text.Secondary}"
                           FontSize="13" LineHeight="20" TextWrapping="Wrap" />
                <TextBox x:Name="InputBox" Style="{StaticResource LongTextBox}"
                         AutomationProperties.AutomationId="Long.UI.Prompt.Input" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="24,20,24,22">
                <Button Style="{StaticResource LongButton}" Margin="0,0,8,0"
                        Click="Cancel_Click" IsCancel="True"
                        AutomationProperties.AutomationId="Long.UI.Prompt.Cancel"
                        Content="{DynamicResource i18n.action.cancel}" />
                <Button Style="{StaticResource LongButton.Primary}"
                        Click="Confirm_Click" IsDefault="True"
                        AutomationProperties.AutomationId="Long.UI.Prompt.Confirm"
                        Content="{DynamicResource i18n.action.confirm}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
