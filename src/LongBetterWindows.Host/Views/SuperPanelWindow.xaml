<Window x:Class="LongBetterWindows.Host.Views.SuperPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interaction="clr-namespace:LongBetterWindows.Host.Interaction"
        Title="{DynamicResource i18n.superPanel.title}"
        Width="640" Height="560"
        MinWidth="560" MinHeight="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{DynamicResource Long.Brush.Surface.Overlay}"
        ShowInTaskbar="False"
        Topmost="True"
        Style="{StaticResource LongWindowChrome}"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        AutomationProperties.AutomationId="Long.SuperPanel"
        AutomationProperties.Name="{DynamicResource i18n.superPanel.title}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <DataTemplate x:Key="SuperPanelResultIconTemplate">
            <Border Width="42" Height="42" CornerRadius="8"
                    Background="{DynamicResource Long.Brush.Background.Raised}"
                    BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                    BorderThickness="1">
                <Grid>
                    <Path Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{DynamicResource Long.Brush.Accent.Primary}"
                          StrokeThickness="1.6">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource Long.Icon.Command}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IconKind}"
                                                 Value="{x:Static interaction:SearchResultIconKind.Management}">
                                        <Setter Property="Data" Value="{StaticResource Long.Icon.Settings}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKind}"
                                                 Value="{x:Static interaction:SearchResultIconKind.Marketplace}">
                                        <Setter Property="Data" Value="{StaticResource Long.Icon.Plugin}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKind}"
                                                 Value="{x:Static interaction:SearchResultIconKind.Plugin}">
                                        <Setter Property="Data" Value="{StaticResource Long.Icon.Plugin}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKind}"
                                                 Value="{x:Static interaction:SearchResultIconKind.Settings}">
                                        <Setter Property="Data" Value="{StaticResource Long.Icon.Settings}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Image Source="{Binding IconPath}" Width="32" Height="32" Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="SuperPanelCompactItemsPanel">
            <UniformGrid Columns="4" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="SuperPanelContextItemsPanel">
            <StackPanel />
        </ItemsPanelTemplate>

        <Style x:Key="SuperPanelCompactItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Height" Value="102" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="8" CornerRadius="8"
                                Background="{DynamicResource Long.Brush.Surface.Card}"
                                BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource Long.Brush.Surface.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource Long.Brush.Accent.Soft}" />
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource Long.Brush.Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuperPanelContextItem" TargetType="ListBoxItem"
               BasedOn="{StaticResource SuperPanelCompactItem}">
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <DataTemplate x:Key="SuperPanelCompactResultTemplate">
            <Grid>
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource SuperPanelResultIconTemplate}"
                                HorizontalAlignment="Center" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Title}" Margin="2,50,2,0"
                           TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource Long.Brush.Text.Primary}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SuperPanelContextResultTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource SuperPanelResultIconTemplate}"
                                VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </StackPanel>
                <Button Grid.Column="2" Click="SecondaryActions_Click"
                        Width="26" Height="26" Margin="4,0"
                        Content="⋯" ToolTip="{DynamicResource i18n.superPanel.moreActions}"
                        AutomationProperties.AutomationId="Long.Result.MoreActions"
                        AutomationProperties.Name="{DynamicResource i18n.superPanel.moreResultActions}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LongIconButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSecondaryActions}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="3" Tag="{Binding Id}" Click="PinResult_Click"
                        Width="26" Height="26" Margin="4,0"
                        ToolTip="{DynamicResource i18n.superPanel.togglePin}"
                        AutomationProperties.Name="{DynamicResource i18n.superPanel.togglePinAutomation}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LongIconButton}">
                            <Setter Property="Content" Value="☆" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanPin}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                    <Setter Property="Content" Value="★" />
                                    <Setter Property="Foreground" Value="{DynamicResource Long.Brush.Accent.Primary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="PanelChrome"
            Background="{DynamicResource Long.Brush.Surface.Overlay}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Strong}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Long.Radius.Flyout}"
            Padding="16">
        <Border.Effect>
            <StaticResource ResourceKey="Long.Shadow.Level3" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Height="2" VerticalAlignment="Top" Margin="18,-16,18,0"
                    CornerRadius="0,0,3,3"
                    Background="{DynamicResource Long.Brush.Accent.Gradient}" />

            <Grid Grid.Row="0" Margin="2,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="11"
                        Background="{DynamicResource Long.Brush.Accent.Gradient}">
                    <Path Data="{StaticResource Long.Icon.Sparkle}" Style="{StaticResource LongIcon}"
                          Width="18" Height="18" Stroke="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource i18n.superPanel.title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                    <TextBlock x:Name="ContextSummary" Text="{DynamicResource i18n.superPanel.context.loading}" FontSize="10" Margin="0,2,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource LongButton}" Height="30"
                        Padding="10,0" Margin="0,0,6,0" Click="OpenCommandCenter_Click"
                        AutomationProperties.AutomationId="Long.SuperPanel.OpenCommandCenter"
                        AutomationProperties.Name="{DynamicResource i18n.superPanel.openCommandCenterAutomation}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Long.Icon.Search}" Style="{StaticResource LongIcon}"
                              Width="13" Height="13" />
                        <TextBlock Text="{DynamicResource i18n.superPanel.commandCenter}" FontSize="10" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource LongIconButton}" Width="30" Height="30"
                        Click="Close_Click" AutomationProperties.Name="{DynamicResource i18n.superPanel.closeAutomation}">
                    <Path Data="{StaticResource Long.Icon.Close}" Style="{StaticResource LongIcon}"
                          Width="12" Height="12" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,11,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="GroupTabs"
                              AutomationProperties.AutomationId="Long.SuperPanel.Groups"
                              AutomationProperties.Name="{DynamicResource i18n.superPanel.groupsAutomation}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding Id}" Click="GroupButton_Click"
                                        AllowDrop="True" DragOver="GroupButton_DragOver" Drop="GroupButton_Drop"
                                        Height="30" MinWidth="86" Padding="10,0" Margin="0,0,6,0"
                                        ToolTip="{Binding Hint}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LongButton}">
                                            <Setter Property="Background" Value="{DynamicResource Long.Brush.Surface.Card}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Long.Brush.Accent.Soft}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Long.Brush.Accent.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" MaxWidth="88" TextTrimming="CharacterEllipsis"
                                                   FontSize="10" FontWeight="SemiBold" />
                                        <Border Margin="7,0,0,0" Padding="5,1" CornerRadius="6"
                                                Background="{DynamicResource Long.Brush.Background.Raised}">
                                            <TextBlock Text="{Binding Count}" FontSize="9"
                                                       Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel x:Name="CustomGroupActions" Grid.Column="1" Orientation="Horizontal"
                            Margin="2,0,4,0" Visibility="Collapsed">
                    <Button Style="{StaticResource LongIconButton}" Width="28" Height="28"
                            Content="✎" Click="RenameGroup_Click"
                            ToolTip="{DynamicResource i18n.superPanel.renameGroup}"
                            AutomationProperties.Name="{DynamicResource i18n.superPanel.renameGroup}" />
                    <Button Style="{StaticResource LongIconButton}" Width="28" Height="28"
                            Content="×" Margin="2,0,0,0" Click="DeleteGroup_Click"
                            ToolTip="{DynamicResource i18n.superPanel.deleteGroup}"
                            AutomationProperties.Name="{DynamicResource i18n.superPanel.deleteGroup}" />
                </StackPanel>
                <Button x:Name="AddGroupButton" Grid.Column="2" Style="{StaticResource LongIconButton}"
                        Width="30" Height="30" Content="+" Click="AddGroup_Click"
                        ToolTip="{DynamicResource i18n.superPanel.createGroup}"
                        AutomationProperties.Name="{DynamicResource i18n.superPanel.createGroup}" />
                <Popup x:Name="GroupEditorPopup" PlacementTarget="{Binding ElementName=AddGroupButton}"
                       Placement="Bottom" HorizontalOffset="-196" VerticalOffset="6"
                       AllowsTransparency="True" StaysOpen="False">
                    <Border Width="232" Padding="12" CornerRadius="12"
                            Background="{DynamicResource Long.Brush.Surface.Overlay}"
                            BorderBrush="{DynamicResource Long.Brush.Stroke.Strong}" BorderThickness="1">
                        <Border.Effect><StaticResource ResourceKey="Long.Shadow.Level2" /></Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="GroupEditorTitle" Text="{DynamicResource i18n.superPanel.editor.createShort}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                            <TextBox x:Name="GroupNameTextBox" Margin="0,9,0,9" MaxLength="24" Height="32"
                                     VerticalContentAlignment="Center" PreviewKeyDown="GroupNameTextBox_PreviewKeyDown"
                                     AutomationProperties.Name="{DynamicResource i18n.superPanel.groupNameAutomation}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource LongButton}" Content="{DynamicResource i18n.action.cancel}" Height="28"
                                        Click="CancelGroupEditor_Click" />
                                <Button Style="{StaticResource LongButton.Primary}" Content="{DynamicResource i18n.action.save}" Height="28"
                                        Margin="6,0,0,0" Click="SaveGroupEditor_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <ItemsControl x:Name="ContextBadges" Grid.Row="2" Margin="0,0,0,7"
                          Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource LongBadge}" Margin="2,0,4,3">
                            <TextBlock Text="{Binding Label}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                       FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3">
                <ListBox x:Name="ResultsList" BorderThickness="0" Background="Transparent"
                         AutomationProperties.AutomationId="Long.SuperPanel.Results"
                         AutomationProperties.Name="{DynamicResource i18n.superPanel.resultsAutomation}"
                         AutomationProperties.LiveSetting="Polite"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="ResultsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ResultsList_PreviewMouseMove"
                         MouseLeftButtonUp="ResultsList_MouseLeftButtonUp"
                         DragOver="ResultsList_DragOver"
                         Drop="ResultsList_Drop">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
                    </ListBox.Resources>
                </ListBox>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource Long.Icon.Command}" Style="{StaticResource LongIcon}"
                          Width="28" Height="28" HorizontalAlignment="Center"
                          Stroke="{DynamicResource Long.Brush.Text.Muted}" />
                    <TextBlock x:Name="EmptyStateText" Text="{DynamicResource i18n.superPanel.empty.context}" Style="{StaticResource LongEmptyState}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="4,9,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="InteractionHint" Text="{DynamicResource i18n.superPanel.interactionHint}" FontSize="10"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviousPageButton" Style="{StaticResource LongIconButton}"
                            Width="26" Height="26" Content="‹" Click="PreviousPage_Click"
                            AutomationProperties.AutomationId="Long.SuperPanel.PreviousPage"
                            AutomationProperties.Name="{DynamicResource i18n.superPanel.previousPage}" />
                    <TextBlock x:Name="PageText" MinWidth="42" Text="1/1" TextAlignment="Center"
                               VerticalAlignment="Center" FontSize="10"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    <Button x:Name="NextPageButton" Style="{StaticResource LongIconButton}"
                            Width="26" Height="26" Content="›" Click="NextPage_Click"
                            AutomationProperties.AutomationId="Long.SuperPanel.NextPage"
                            AutomationProperties.Name="{DynamicResource i18n.superPanel.nextPage}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Grid.Column="2" HorizontalAlignment="Right" FontSize="10"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                <TextBlock x:Name="SelectionAnnouncement"
                           Width="1" Height="1" Opacity="0"
                           IsHitTestVisible="False" Focusable="False"
                           AutomationProperties.AutomationId="Long.SuperPanel.SelectionAnnouncement"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Grid>
    </Border>
</Window>
