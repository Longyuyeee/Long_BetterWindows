<Window x:Class="LongBetterWindows.Host.Views.DesignSystemPreview"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Long Design System"
        Width="860" Height="560" MinWidth="680" MinHeight="440"
        Style="{StaticResource LongWindowChrome}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Long.Developer.DesignPreview.Window"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource Long.Brush.Background.Base}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
            BorderThickness="1" CornerRadius="{DynamicResource Long.Radius.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Long.Brush.Background.Raised}"
                    CornerRadius="14,14,0,0" BorderBrush="{DynamicResource Long.Brush.Stroke.Default}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="20,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Long.Icon.Sparkle}" Style="{StaticResource LongIcon}"
                              Stroke="{DynamicResource Long.Brush.Accent.Primary}" />
                        <TextBlock Text="Long Design System" Margin="10,0,0,0" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                        <Border Style="{StaticResource LongBadge}" Margin="10,0,0,0">
                            <TextBlock Text="v1.0" FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                        </Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource LongIconButton}"
                            AutomationProperties.AutomationId="Long.Developer.DesignPreview.Close"
                            AutomationProperties.Name="{DynamicResource i18n.developer.design.close}" Click="Close_Click">
                        <Path Data="{StaticResource Long.Icon.Close}" Style="{StaticResource LongIcon}" Width="16" Height="16" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28">
                    <TextBlock Text="{DynamicResource i18n.developer.design.hero.title}" FontSize="{DynamicResource Long.Type.Display}"
                               FontWeight="SemiBold" Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                    <TextBlock Text="{DynamicResource i18n.developer.design.hero.desc}"
                               Margin="0,8,0,26" FontSize="{DynamicResource Long.Type.Body}"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />

                    <TextBlock Text="{DynamicResource i18n.developer.design.colors}" FontSize="{DynamicResource Long.Type.Title}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Long.Brush.Text.Primary}" Margin="0,0,0,14" />
                    <UniformGrid Columns="6" Margin="0,0,0,28">
                        <Border Style="{StaticResource LongCard}" Background="{DynamicResource Long.Brush.Accent.Primary}" Margin="0,0,8,0"><TextBlock Text="Accent" Foreground="White" /></Border>
                        <Border Style="{StaticResource LongCard}" Background="{DynamicResource Long.Brush.Surface.Card}" Margin="0,0,8,0"><TextBlock Text="Card" Foreground="{DynamicResource Long.Brush.Text.Primary}" /></Border>
                        <Border Style="{StaticResource LongCard}" Background="{DynamicResource Long.Brush.Surface.Hover}" Margin="0,0,8,0"><TextBlock Text="Hover" Foreground="{DynamicResource Long.Brush.Text.Primary}" /></Border>
                        <Border Style="{StaticResource LongCard}" Background="{DynamicResource Long.Brush.State.Success}" Margin="0,0,8,0"><TextBlock Text="Success" Foreground="White" /></Border>
                        <Border Style="{StaticResource LongCard}" Background="{DynamicResource Long.Brush.State.Warning}" Margin="0,0,8,0"><TextBlock Text="Warning" Foreground="White" /></Border>
                        <Border Style="{StaticResource LongCard}" Background="{DynamicResource Long.Brush.State.Danger}"><TextBlock Text="Danger" Foreground="White" /></Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource i18n.developer.design.actions}" FontSize="{DynamicResource Long.Type.Title}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Long.Brush.Text.Primary}" Margin="0,0,0,14" />
                            <Border Style="{StaticResource LongCard}">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,16">
                                        <Button Content="{DynamicResource i18n.developer.design.primaryAction}" Style="{StaticResource LongButton.Primary}" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource i18n.developer.design.primaryAction}" />
                                        <Button Content="{DynamicResource i18n.developer.design.secondaryAction}" Style="{StaticResource LongButton}" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource i18n.developer.design.secondaryAction}" />
                                        <Button Content="{DynamicResource i18n.developer.design.dangerAction}" Style="{StaticResource LongButton.Danger}" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource i18n.developer.design.dangerAction}" />
                                        <Button Content="{DynamicResource i18n.developer.design.disabledState}" Style="{StaticResource LongButton}" IsEnabled="False" Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource LongToggle}" IsChecked="True" AutomationProperties.Name="{DynamicResource i18n.developer.design.motion}" />
                                        <TextBlock Text="{DynamicResource i18n.developer.design.motion}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource LongLoadingState}" Margin="0,18,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource i18n.developer.design.navigation}" FontSize="{DynamicResource Long.Type.Title}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Long.Brush.Text.Primary}" Margin="0,24,0,14" />
                            <Border Style="{StaticResource LongCard}">
                                <StackPanel>
                                    <RadioButton Content="{DynamicResource i18n.nav.overview}" GroupName="PreviewNav" IsChecked="True" Style="{StaticResource LongNavigationItem}" />
                                    <RadioButton Content="{DynamicResource i18n.nav.plugins}" GroupName="PreviewNav" Style="{StaticResource LongNavigationItem}" />
                                    <RadioButton Content="{DynamicResource i18n.nav.developer}" GroupName="PreviewNav" Style="{StaticResource LongNavigationItem}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource i18n.developer.design.inputs}" FontSize="{DynamicResource Long.Type.Title}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Long.Brush.Text.Primary}" Margin="0,0,0,14" />
                            <Border Style="{StaticResource LongCard}">
                                <StackPanel>
                                    <TextBox Style="{StaticResource LongSearchBox}" Text="{DynamicResource i18n.developer.design.searchExample}"
                                             AutomationProperties.Name="{DynamicResource i18n.developer.design.searchExampleA11y}" Margin="0,0,0,12" />
                                    <TextBox Style="{StaticResource LongTextBox}" Text="{DynamicResource i18n.developer.design.standardInput}"
                                             AutomationProperties.Name="{DynamicResource i18n.developer.design.standardInputA11y}" Margin="0,0,0,12" />
                                    <TextBox Style="{StaticResource LongTextBox.Error}" Text="{DynamicResource i18n.developer.design.errorInput}"
                                             AutomationProperties.Name="{DynamicResource i18n.developer.design.errorInputA11y}" />
                                    <TextBlock Text="{DynamicResource i18n.developer.design.checkInput}" Foreground="{DynamicResource Long.Brush.State.Danger}"
                                               FontSize="{DynamicResource Long.Type.Caption}" Margin="4,6,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource i18n.developer.design.feedback}" FontSize="{DynamicResource Long.Type.Title}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Long.Brush.Text.Primary}" Margin="0,24,0,14" />
                            <Border Style="{StaticResource LongCard}">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,16">
                                        <Border Style="{StaticResource LongBadge}" Margin="0,0,8,0"><TextBlock Text="{DynamicResource i18n.developer.design.builtInPlugin}" Foreground="{DynamicResource Long.Brush.Text.Primary}" /></Border>
                                        <Border Style="{StaticResource LongHotkeyBadge}" Margin="0,0,8,0"><TextBlock Text="Alt + Space" FontFamily="{DynamicResource Long.Font.Mono}" Foreground="{DynamicResource Long.Brush.Text.Secondary}" /></Border>
                                    </WrapPanel>
                                    <Border Style="{StaticResource LongToast}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Long.Icon.Check}" Style="{StaticResource LongIcon}"
                                                  Stroke="{DynamicResource Long.Brush.State.Success}" />
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="{DynamicResource i18n.developer.design.completed}" FontWeight="SemiBold" Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                                                <TextBlock Text="{DynamicResource i18n.developer.design.copied}" FontSize="11" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
