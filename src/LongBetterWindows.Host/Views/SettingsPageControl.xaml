<UserControl x:Class="LongBetterWindows.Host.Views.SettingsPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource LongCard}">
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
        <Style x:Key="SettingsCategoryButton"
               TargetType="Button"
               BasedOn="{StaticResource LongButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SettingsCategoryButton.Selected"
               TargetType="Button"
               BasedOn="{StaticResource LongButton.Primary}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>
    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CategoryColumn" Width="200" />
            <ColumnDefinition x:Name="CategoryGapColumn" Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="DesktopCategoryList"
                    Grid.RowSpan="2"
                    automation:AutomationProperties.AutomationId="Long.Settings.CategoryList">
            <Button Tag="appearance" Style="{StaticResource SettingsCategoryButton}"
                    Click="CategoryButton_Click"
                    automation:AutomationProperties.AutomationId="Long.Settings.CategoryItem.appearance"
                    Content="{DynamicResource i18n.settings.category.appearance}" />
            <Button Tag="interaction" Style="{StaticResource SettingsCategoryButton}"
                    Click="CategoryButton_Click"
                    automation:AutomationProperties.AutomationId="Long.Settings.CategoryItem.interaction"
                    Content="{DynamicResource i18n.settings.category.interaction}" />
            <Button Tag="connections" Style="{StaticResource SettingsCategoryButton}"
                    Click="CategoryButton_Click"
                    automation:AutomationProperties.AutomationId="Long.Settings.CategoryItem.connections"
                    Content="{DynamicResource i18n.settings.category.connections}" />
            <Button Tag="updates" Style="{StaticResource SettingsCategoryButton}"
                    Click="CategoryButton_Click"
                    automation:AutomationProperties.AutomationId="Long.Settings.CategoryItem.updates"
                    Content="{DynamicResource i18n.settings.category.updates}" />
        </StackPanel>

        <ComboBox x:Name="CompactCategorySelector"
                  Grid.ColumnSpan="3"
                  Margin="0,0,0,16"
                  Visibility="Collapsed"
                  SelectionChanged="CategorySelector_SelectionChanged"
                  automation:AutomationProperties.Name="{DynamicResource i18n.settings.category.selector}"
                  automation:AutomationProperties.AutomationId="Long.Settings.CategorySelector">
            <ComboBoxItem Tag="appearance"
                          automation:AutomationProperties.AutomationId="Long.Settings.CompactCategoryItem.appearance"
                          Content="{DynamicResource i18n.settings.category.appearance}" />
            <ComboBoxItem Tag="interaction"
                          automation:AutomationProperties.AutomationId="Long.Settings.CompactCategoryItem.interaction"
                          Content="{DynamicResource i18n.settings.category.interaction}" />
            <ComboBoxItem Tag="connections"
                          automation:AutomationProperties.AutomationId="Long.Settings.CompactCategoryItem.connections"
                          Content="{DynamicResource i18n.settings.category.connections}" />
            <ComboBoxItem Tag="updates"
                          automation:AutomationProperties.AutomationId="Long.Settings.CompactCategoryItem.updates"
                          Content="{DynamicResource i18n.settings.category.updates}" />
        </ComboBox>

        <Grid x:Name="CategoryContent" Grid.RowSpan="2" Grid.Column="2">
        <StackPanel x:Name="AppearanceCategory" VerticalAlignment="Top"
                    automation:AutomationProperties.AutomationId="Long.Settings.Category.appearance">
        <TextBlock Text="{DynamicResource i18n.settings.category.appearance}"
                   automation:AutomationProperties.AutomationId="Long.Settings.CategoryContent.appearance"
                   automation:AutomationProperties.HeadingLevel="Level2"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource i18n.settings.language.title}"
                               FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource i18n.settings.language.desc}"
                               Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </StackPanel>
                <ComboBox x:Name="LanguageSelector" Grid.Column="1" Width="156"
                          VerticalAlignment="Center"
                          SelectionChanged="LanguageSelector_SelectionChanged">
                    <ComboBoxItem Tag="zh-CN"
                                  Content="{DynamicResource i18n.settings.language.zh}" />
                    <ComboBoxItem Tag="en-US"
                                  Content="{DynamicResource i18n.settings.language.en}" />
                </ComboBox>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource i18n.settings.theme.title}"
                               FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource i18n.settings.theme.desc}"
                               Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </StackPanel>
                <Button x:Name="ThemeButton" Grid.Column="1"
                        Style="{StaticResource LongButton}"
                        Click="ThemeToggle_Click"
                        AutomationProperties.AutomationId="Long.Settings.Theme.Toggle" />
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource i18n.settings.motion.title}"
                               FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource i18n.settings.motion.desc}"
                               Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </StackPanel>
                <ToggleButton x:Name="MotionToggle" Grid.Column="1"
                              Style="{StaticResource LongToggle}"
                              IsChecked="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}, Mode=OneWay}"
                              IsEnabled="False" />
            </Grid>
        </Border>
        </StackPanel>

        <StackPanel x:Name="UpdatesCategory" VerticalAlignment="Top" Visibility="Collapsed"
                    automation:AutomationProperties.AutomationId="Long.Settings.Category.updates">
        <TextBlock Text="{DynamicResource i18n.settings.category.updates}"
                   automation:AutomationProperties.AutomationId="Long.Settings.CategoryContent.updates"
                   automation:AutomationProperties.HeadingLevel="Level2"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource i18n.settings.update.title}"
                               FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource i18n.settings.update.desc}"
                               Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    <TextBlock x:Name="UpdateStatusText" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Muted}"
                               automation:AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Button x:Name="UpdateActionButton" Grid.Column="1"
                        Style="{StaticResource LongButton.Primary}"
                        Click="UpdateAction_Click" />
            </Grid>
        </Border>
        </StackPanel>

        <StackPanel x:Name="InteractionCategory" VerticalAlignment="Top" Visibility="Collapsed"
                    automation:AutomationProperties.AutomationId="Long.Settings.Category.interaction">
        <TextBlock Text="{DynamicResource i18n.settings.category.interaction}"
                   automation:AutomationProperties.AutomationId="Long.Settings.CategoryContent.interaction"
                   automation:AutomationProperties.HeadingLevel="Level2"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource i18n.settings.gesture.title}"
                           FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource i18n.settings.gesture.desc}"
                           Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                <TextBlock x:Name="MouseGestureStatusText" Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                <WrapPanel x:Name="MouseGestureButtons" Margin="0,12,0,0">
                    <Button Content="{DynamicResource i18n.settings.gesture.disabled}"
                            Tag="Disabled" Style="{StaticResource LongButton}"
                            Click="MouseGestureMode_Click" />
                    <Button Content="{DynamicResource i18n.settings.gesture.middle}"
                            Tag="MiddleButton" Style="{StaticResource LongButton}"
                            Margin="6,0,0,0" Click="MouseGestureMode_Click" />
                    <Button Content="{DynamicResource i18n.settings.gesture.longRight}"
                            Tag="LongRightPress" Style="{StaticResource LongButton}"
                            Margin="6,0,0,0" Click="MouseGestureMode_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>
        </StackPanel>

        <StackPanel x:Name="ConnectionsCategory" VerticalAlignment="Top" Visibility="Collapsed"
                    automation:AutomationProperties.AutomationId="Long.Settings.Category.connections">
        <TextBlock Text="{DynamicResource i18n.settings.category.connections}"
                   automation:AutomationProperties.AutomationId="Long.Settings.CategoryContent.connections"
                   automation:AutomationProperties.HeadingLevel="Level2"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource i18n.settings.broker.title}"
                               FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource i18n.settings.broker.desc}"
                               Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    <TextBlock x:Name="BrokerStatusText" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Muted}"
                               automation:AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel x:Name="BrokerActions" Grid.Column="1"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="BrokerToggle"
                                  Style="{StaticResource LongToggle}"
                                  HorizontalAlignment="Right"
                                  Click="BrokerToggle_Click" />
                    <Button Content="{DynamicResource i18n.settings.broker.export}"
                            Style="{StaticResource LongButton}"
                            Margin="0,8,0,0"
                            Click="ExportBrokerDiagnostics_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource i18n.settings.privacy.title}"
                               FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource i18n.settings.privacy.desc}"
                               Margin="0,5,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                    <TextBlock x:Name="SearchPreferenceStatusText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Long.Brush.Text.Muted}" />
                </StackPanel>
                <Button x:Name="ClearPreferencesButton" Grid.Column="1"
                        Content="{DynamicResource i18n.settings.privacy.clear}"
                        Style="{StaticResource LongButton}"
                        Click="ClearSearchPreferences_Click" />
            </Grid>
        </Border>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
