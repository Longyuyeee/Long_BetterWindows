<Window x:Class="ColorPickerPlugin.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕取色"
        AutomationProperties.Name="屏幕颜色拾取器"
        Width="250" Height="214"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="{DynamicResource Long.Brush.Surface.Overlay}"
            BorderBrush="{DynamicResource Long.Brush.Stroke.Strong}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Long.Radius.Flyout}"
            Padding="16">
        <Border.Effect>
            <StaticResource ResourceKey="Long.Shadow.Level2" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock x:Name="TitleText" Text="屏幕取色" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                <Border HorizontalAlignment="Right" Style="{StaticResource LongHotkeyBadge}">
                    <TextBlock Text="ESC" FontSize="10" />
                </Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ColorBox" Width="72" Height="72"
                        BorderBrush="{DynamicResource Long.Brush.Stroke.Strong}"
                        BorderThickness="1" CornerRadius="{DynamicResource Long.Radius.Control}"
                        Background="Gray" />
                <StackPanel Grid.Column="1" Margin="14,6,0,0">
                    <TextBlock x:Name="HexText" Text="#000000" FontSize="18" FontWeight="Bold"
                               FontFamily="{DynamicResource Long.Font.Mono}"
                               Foreground="{DynamicResource Long.Brush.Text.Primary}" />
                    <TextBlock x:Name="RgbText" Text="rgb(0, 0, 0)" Margin="0,5,0,0"
                               FontSize="11" FontFamily="{DynamicResource Long.Font.Mono}"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource Long.Brush.Accent.Soft}"
                    CornerRadius="{DynamicResource Long.Radius.Badge}" Padding="9,6">
                <TextBlock x:Name="InstructionText" Text="单击屏幕复制色值 · Esc 取消" HorizontalAlignment="Center"
                           FontSize="10" Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
            </Border>
        </Grid>
    </Border>
</Window>
