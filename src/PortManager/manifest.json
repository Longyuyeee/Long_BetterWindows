{
  "id": "com.long.portmanager",
  "version": "1.0.1",
  "name": "端口管理器",
  "author": "Long",
  "description": "端口扫描、进程识别、占用分析与安全释放，快速找到谁占用了端口，判断能否安全关闭",
  "entry_point": "index.html",
  "runtime": "webview",
  "capabilities": [
    "network.ports",
    "system.process",
    "system.clipboard"
  ],
  "commands": [
    {
      "id": "port-manager.open",
      "title": "打开端口管理器",
      "description": "查询端口占用、关联进程并执行受控释放",
      "aliases": ["端口管理", "端口占用", "port manager", "duankouguanli"],
      "accepted_inputs": ["none", "text"],
      "outputs": [
        {
          "key": "query",
          "type": "text",
          "description": "已完成查询的协议与端口"
        }
      ],
      "view_mode": "list",
      "priority": 26
    }
  ],
  "window": {
    "mode": "wide",
    "preferred_width": 1040,
    "preferred_height": 720,
    "min_width": 760,
    "min_height": 520
  },
  "localization": {
    "default_language": "zh-CN",
    "resources": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "lifecycle": {
    "start_with_host": false,
    "close_behavior": "stop",
    "default_presentation": "embedded",
    "search_in_background": false
  },
  "default_settings": {
    "auto_refresh": true,
    "refresh_interval": 5000
  }
}
