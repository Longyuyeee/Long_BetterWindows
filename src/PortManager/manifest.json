{
  "id": "com.long.portmanager",
  "version": "1.0.0",
  "name": "端口管理器",
  "author": "Long",
  "description": "端口扫描、进程识别、占用分析与安全释放，快速找到谁占用了端口，判断能否安全关闭",
  "entry_point": "index.html",
  "runtime": "webview",
  "capabilities": [
    "network.ports",
    "system.process",
    "system.clipboard"
  ],
  "default_settings": {
    "auto_refresh": true,
    "refresh_interval": 5000
  }
}
