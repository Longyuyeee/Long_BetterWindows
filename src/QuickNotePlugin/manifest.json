{
  "id": "com.long.quick-note",
  "version": "1.2.0",
  "name": "快速便签",
  "author": "Long",
  "entry_point": "index.html",
  "runtime": "webview",
  "capabilities": ["storage.local"],
  "commands": [
    {
      "id": "note.new",
      "title": "新建快速便签",
      "description": "记录文本或将剪贴板内容放入便签编辑区",
      "aliases": ["便签", "笔记", "note", "quick note", "bianqian"],
      "accepted_inputs": ["text", "clipboard"],
      "view_mode": "document",
      "keep_alive": true,
      "priority": 22
    }
  ],
  "window": {
    "mode": "standard",
    "preferred_width": 760,
    "preferred_height": 760,
    "min_width": 600,
    "min_height": 560
  },
  "localization": {
    "default_language": "zh-CN",
    "resources": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "default_settings": {
    "auto_start": false,
    "max_items": 30,
    "max_item_characters": 65536,
    "max_collection_characters": 500000
  }
}
