<Window x:Class="WindowManagerPlugin.WindowManagerGuide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="窗口管理" Width="560" Height="500" SizeToContent="Manual"
        Background="Transparent"
        Foreground="{DynamicResource Long.Brush.Text.Primary}"
        FontFamily="{DynamicResource Long.Font.Ui}"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="Long.WindowManager.Guide.Window"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="14"
                            GlassFrameThickness="0" ResizeBorderThickness="6"
                            UseAeroCaptionButtons="True" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource Long.Brush.Surface.Card}"
            BorderBrush="{DynamicResource Long.Brush.Border.Default}"
            BorderThickness="1" CornerRadius="14" Padding="24">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="窗口管理" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="DescriptionText" Text="用统一指令或快捷键整理当前窗口" Margin="0,6,0,0"
                               Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
                </StackPanel>
                <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource LongIconButton}" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.AutomationId="Long.WindowManager.Guide.Close"
                        AutomationProperties.Name="关闭窗口管理指南">
                    <Path Data="{StaticResource Long.Icon.Close}" Style="{StaticResource LongIcon}"
                          Width="13" Height="13" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Margin="0,22,0,18"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="CommonTitleText" Text="常用操作" FontWeight="SemiBold" Foreground="{DynamicResource Long.Brush.Accent.Primary}" />
                    <UniformGrid Columns="2" Margin="0,8,0,18">
                        <Border Style="{StaticResource LongCard}" Margin="0,0,6,6"><StackPanel><TextBlock x:Name="TopmostText" Text="切换置顶" FontWeight="SemiBold"/><TextBlock Text="Ctrl + Alt + T" Margin="0,6,0,0" Foreground="{DynamicResource Long.Brush.Text.Muted}"/></StackPanel></Border>
                        <Border Style="{StaticResource LongCard}" Margin="6,0,0,6"><StackPanel><TextBlock x:Name="MaximizeText" Text="最大化" FontWeight="SemiBold"/><TextBlock Text="Ctrl + Alt + ↑" Margin="0,6,0,0" Foreground="{DynamicResource Long.Brush.Text.Muted}"/></StackPanel></Border>
                    </UniformGrid>
                    <TextBlock x:Name="LayoutsTitleText" Text="半屏与分区" FontWeight="SemiBold" Foreground="{DynamicResource Long.Brush.Accent.Primary}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LeftText" Text="←  左半屏" Margin="0,4"/><TextBlock x:Name="RightText" Text="→  右半屏" Margin="0,4"/>
                            <TextBlock x:Name="BottomText" Text="↓  下半屏" Margin="0,4"/><TextBlock x:Name="TopLeftText" Text="1  左上四分屏" Margin="0,4"/>
                            <TextBlock x:Name="BottomLeftText" Text="3  左下四分屏" Margin="0,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TopRightText" Text="2  右上四分屏" Margin="0,4"/><TextBlock x:Name="BottomRightText" Text="4  右下四分屏" Margin="0,4"/>
                            <TextBlock x:Name="ThirdLeftText" Text="Shift + ←  左侧 ⅓" Margin="0,4"/><TextBlock x:Name="ThirdRightText" Text="Shift + →  右侧 ⅔" Margin="0,4"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource Long.Brush.Accent.Soft}" CornerRadius="8" Padding="12,9">
                <TextBlock x:Name="HintText" Text="提示：所有操作也可以直接在命令中心搜索“窗口”。"
                           Foreground="{DynamicResource Long.Brush.Text.Secondary}" />
            </Border>
        </Grid>
    </Border>
</Window>
