{
  "id": "com.long.clipboardhistory",
  "version": "1.1.0",
  "name": "剪贴板历史",
  "author": "Long",
  "description": "在后台记录文本剪贴板历史，支持按关键词和时间检索并快速重新复制",
  "entry_point": "index.html",
  "runtime": "webview",
  "background": {
    "entry_point": "ClipboardHistory.Background.dll"
  },
  "capabilities": [
    "system.clipboard",
    "system.clipboard.monitor",
    "storage.local",
    "system.hotkey"
  ],
  "commands": [
    {
      "id": "clipboard-history.open",
      "title": "打开剪贴板历史",
      "description": "搜索并重新使用最近复制的文本",
      "aliases": ["剪贴板历史", "历史剪贴板", "clipboard history", "jtbll"],
      "accepted_inputs": ["none", "text", "clipboard"],
      "view_mode": "list",
      "keep_alive": true,
      "priority": 42
    }
  ],
  "window": {
    "mode": "standard",
    "preferred_width": 820,
    "preferred_height": 720,
    "min_width": 620,
    "min_height": 500
  },
  "localization": {
    "default_language": "zh-CN",
    "resources": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "lifecycle": {
    "start_with_host": true,
    "close_behavior": "background",
    "default_presentation": "embedded",
    "search_in_background": false
  },
  "default_settings": {
    "hotkey": "Ctrl+Shift+V",
    "max_items": 500,
    "auto_start": true
  }
}
