{
  "id": "com.long.clipboardhistory",
  "version": "1.0.0",
  "name": "剪贴板历史",
  "author": "Long",
  "description": "自动记录剪贴板历史，支持按关键词、时间、类型搜索，并可重新放回剪贴板",
  "entry_point": "index.html",
  "runtime": "webview",
  "capabilities": [
    "system.clipboard",
    "system.clipboard.monitor",
    "storage.local",
    "system.hotkey"
  ],
  "commands": [
    {
      "id": "clipboard-history.open",
      "title": "打开剪贴板历史",
      "description": "搜索、固定并重新使用最近复制的内容",
      "aliases": ["剪贴板历史", "历史剪贴板", "clipboard history", "jtbll"],
      "accepted_inputs": ["none", "text", "clipboard"],
      "view_mode": "list",
      "keep_alive": true,
      "priority": 42
    }
  ],
  "window": {
    "mode": "standard",
    "preferred_width": 820,
    "preferred_height": 720,
    "min_width": 620,
    "min_height": 500
  },
  "lifecycle": {
    "start_with_host": true,
    "close_behavior": "background",
    "default_presentation": "embedded",
    "search_in_background": false
  },
  "default_settings": {
    "hotkey": "Ctrl+Shift+V",
    "max_items": 500,
    "auto_start": true
  }
}
