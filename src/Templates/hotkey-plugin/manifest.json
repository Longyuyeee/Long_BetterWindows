{
  "id": "com.example.hotkey",
  "version": "1.0.0",
  "name": "热键插件模板",
  "author": "",
  "entry_point": "HotkeyPlugin.dll",
  "capabilities": [
    "system.hotkey"
  ],
  "lifecycle": {
    "start_with_host": true,
    "close_behavior": "background",
    "default_presentation": "detached",
    "search_in_background": false
  },
  "default_settings": {
    "hotkey": "Alt+X",
    "auto_start": true
  }
}
