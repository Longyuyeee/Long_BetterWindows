{
  "id": "com.long.url-toolkit",
  "version": "1.0.0",
  "name": "URL 工具箱",
  "author": "Long",
  "entry_point": "index.html",
  "runtime": "webview",
  "capabilities": ["system.clipboard"],
  "commands": [
    {
      "id": "url.encode",
      "title": "URL 编码",
      "description": "对文本或剪贴板内容执行 URL 编码",
      "aliases": ["url", "网址编码", "encode uri", "wangzhibianma"],
      "accepted_inputs": ["text", "url", "clipboard"],
      "outputs": [
        {
          "key": "result",
          "type": "text",
          "description": "URL 编码后的文本"
        }
      ],
      "view_mode": "form",
      "priority": 16
    },
    {
      "id": "url.decode",
      "title": "URL 解码",
      "description": "还原 URL 编码后的文本",
      "aliases": ["网址解码", "decode uri", "wangzhijiema"],
      "accepted_inputs": ["text", "url", "clipboard"],
      "outputs": [
        {
          "key": "result",
          "type": "text",
          "description": "URL 解码后的文本"
        }
      ],
      "view_mode": "form",
      "priority": 15
    }
  ],
  "window": {
    "mode": "standard",
    "preferred_width": 760,
    "preferred_height": 660,
    "min_width": 600,
    "min_height": 520
  },
  "lifecycle": {"start_with_host": false, "close_behavior": "stop", "default_presentation": "embedded", "search_in_background": false},
  "localization": {
    "default_language": "zh-CN",
    "resources": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "default_settings": {"auto_start": false}
}
