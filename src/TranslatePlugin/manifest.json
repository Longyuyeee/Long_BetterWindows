{
  "id": "com.long.translate",
  "version": "1.1.0",
  "name": "翻译工具",
  "author": "Long",
  "entry_point": "index.html",
  "runtime": "webview",
  "capabilities": ["system.clipboard", "network.http"],
  "commands": [
    {
      "id": "translate.text",
      "title": "翻译文本",
      "description": "翻译输入文本、链接或剪贴板内容",
      "aliases": ["翻译", "translate", "fy", "fanyi"],
      "accepted_inputs": ["text", "url", "clipboard"],
      "outputs": [
        {
          "key": "result",
          "type": "text",
          "description": "翻译后的文本"
        }
      ],
      "view_mode": "form",
      "keep_alive": true,
      "priority": 35
    }
  ],
  "window": {
    "mode": "standard",
    "preferred_width": 760,
    "preferred_height": 700,
    "min_width": 600,
    "min_height": 540
  },
  "localization": {
    "default_language": "zh-CN",
    "resources": {
      "zh-CN": "i18n/zh-CN.json",
      "en-US": "i18n/en-US.json"
    }
  },
  "default_settings": {"auto_start": false}
}
