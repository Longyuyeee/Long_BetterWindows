{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://long-assistant.local/schemas/automated-acceptance.schema.json",
  "title": "Long Assistant Automated Acceptance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "commit_sha",
    "source_dirty",
    "tested_artifacts",
    "gates"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source_dirty": { "type": "boolean" },
    "tested_artifacts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tested_artifact" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "package" } }
          },
          "minContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "executable" } }
          },
          "minContains": 1
        }
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tested_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "kind": {
          "enum": ["package", "executable", "installer", "manifest", "report"]
        },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "kind": { "enum": ["json", "log", "screenshot", "trace", "other"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "blocked_environment",
            "not_applicable"
          ]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "environment_blocker": { "type": "string", "minLength": 1, "maxLength": 500 },
        "not_applicable_reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "enum": ["passed", "failed"] } }
          },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "blocked_environment" } }
          },
          "then": { "required": ["environment_blocker"] }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "not_applicable" } }
          },
          "then": { "required": ["not_applicable_reason"] }
        }
      ]
    }
  }
}
