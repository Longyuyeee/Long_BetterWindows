{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://long-assistant.local/schemas/plugin-worker-migration-readiness.schema.json",
  "title": "Long Assistant Plugin Worker Migration Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_date",
    "phase",
    "decision",
    "assessed_existing_candidates",
    "eligible_existing_candidates",
    "production_enabled",
    "real_plugins_migrated",
    "recommended_next",
    "first_candidate_audit",
    "reference_workload",
    "worker_policy",
    "exit_criteria",
    "candidates"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "assessment_date": { "type": "string", "format": "date" },
    "phase": { "const": "PX6B-8" },
    "decision": { "const": "sample_contract_split_rejected_worker_migration_paused" },
    "assessed_existing_candidates": { "const": 8 },
    "eligible_existing_candidates": { "const": 0 },
    "production_enabled": { "const": false },
    "real_plugins_migrated": { "const": 0 },
    "recommended_next": { "const": "unsigned_rc_acceptance_and_manual_plugin_validation" },
    "first_candidate_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "command_id",
        "verdict",
        "pure_worker_operations",
        "host_owned_operations",
        "source_capabilities",
        "production_component_created",
        "production_route_changed",
        "blockers"
      ],
      "properties": {
        "plugin_id": { "const": "com.long.sample" },
        "command_id": { "const": "sample.hello" },
        "verdict": { "const": "rejected_no_meaningful_worker_contract" },
        "pure_worker_operations": { "const": [] },
        "host_owned_operations": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["localized_ui_presentation", "notification.show"] }
        },
        "source_capabilities": { "const": ["system.notification"] },
        "production_component_created": { "const": false },
        "production_route_changed": { "const": false },
        "blockers": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reference_workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "project",
        "cataloged",
        "host_or_wpf_reference",
        "ambient_user_data",
        "system_side_effects",
        "commands"
      ],
      "properties": {
        "plugin_id": { "const": "reference.headless.native" },
        "project": { "const": "tools/LongBetterWindows.PluginWorker.Reference/LongBetterWindows.PluginWorker.Reference.csproj" },
        "cataloged": { "const": false },
        "host_or_wpf_reference": { "const": false },
        "ambient_user_data": { "const": false },
        "system_side_effects": { "const": false },
        "commands": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["reference.sha256", "reference.delay"] }
        }
      }
    },
    "worker_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_hash_source",
        "trusted_descriptor_bridge",
        "sealed_file_evidence",
        "post_extraction_file_reverification",
        "production_release_gate_closed",
        "host_preflight_sha256",
        "worker_post_handshake_sha256",
        "load_verified_bytes",
        "reject_reparse_points",
        "maximum_assembly_bytes",
        "approved_host_methods",
        "reference_allowed_host_methods"
      ],
      "properties": {
        "package_hash_source": { "const": "verified_package_file_manifest_required" },
        "trusted_descriptor_bridge": { "const": true },
        "sealed_file_evidence": { "const": true },
        "post_extraction_file_reverification": { "const": true },
        "production_release_gate_closed": { "const": true },
        "host_preflight_sha256": { "const": true },
        "worker_post_handshake_sha256": { "const": true },
        "load_verified_bytes": { "const": true },
        "reject_reparse_points": { "const": true },
        "maximum_assembly_bytes": { "const": 67108864 },
        "approved_host_methods": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["host.capability.query"] }
        },
        "reference_allowed_host_methods": { "const": [] }
      }
    },
    "exit_criteria": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "candidates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_id",
        "manifest",
        "component_project",
        "runtime_profile",
        "headless_component",
        "has_host_ui",
        "direct_ihostapi_object",
        "capabilities",
        "side_effect_tier",
        "required_proxy_methods",
        "required_resource_leases",
        "decision",
        "blockers",
        "evidence"
      ],
      "properties": {
        "plugin_id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
        "manifest": { "type": "string", "pattern": "^src/.+/manifest\\.json$" },
        "component_project": { "type": "string", "pattern": "^src/.+\\.csproj$" },
        "runtime_profile": { "enum": ["native_dll", "webview_native_background"] },
        "headless_component": { "type": "boolean" },
        "has_host_ui": { "type": "boolean" },
        "direct_ihostapi_object": { "const": true },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "side_effect_tier": { "enum": ["low", "high", "critical"] },
        "required_proxy_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_resource_leases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "decision": { "enum": ["reference_split_only", "defer_missing_proxy", "defer_high_risk"] },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contains"],
      "properties": {
        "path": { "type": "string", "pattern": "^src/" },
        "contains": { "type": "string", "minLength": 1 }
      }
    }
  }
}
