{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://long-assistant.local/schemas/final-closure-report.schema.json",
  "title": "Long Assistant Final Closure Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "generated_at_utc", "classification",
    "source_commit", "source_dirty", "allow_dirty", "version",
    "checks_skipped", "release_host", "plugin_matrix",
    "native_performance_preflight", "lpwp_compatibility",
    "automated_acceptance", "release_eligible"
  ],
  "properties": {
    "$schema": {
      "const": "https://long-assistant.local/schemas/final-closure-report.schema.json"
    },
    "schema_version": { "const": 2 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "classification": { "const": "final_closure" },
    "source_commit": { "$ref": "#/$defs/commit" },
    "source_dirty": { "type": "boolean" },
    "allow_dirty": { "type": "boolean" },
    "version": { "type": "string", "minLength": 1 },
    "checks_skipped": { "type": "boolean" },
    "release_host": { "$ref": "#/$defs/release_host" },
    "plugin_matrix": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/plugin_matrix" }]
    },
    "native_performance_preflight": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/native_preflight" }]
    },
    "lpwp_compatibility": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/lpwp" }]
    },
    "automated_acceptance": { "$ref": "#/$defs/automated_acceptance" },
    "release_eligible": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "release_host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exists", "path", "sha256"],
      "properties": {
        "exists": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "plugin_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "source_commit", "source_dirty", "plugin_count",
        "command_count", "acceptance_scenario_count", "automated_gate_count",
        "passed_gate_count", "failed_gate_count",
        "environment_blocked_gate_count", "not_run_gate_count",
        "not_applicable_gate_count", "contract_valid", "release_eligible",
        "report_sha256"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "source_commit": { "$ref": "#/$defs/commit" },
        "source_dirty": { "type": "boolean" },
        "plugin_count": { "type": "integer", "minimum": 0 },
        "command_count": { "type": "integer", "minimum": 0 },
        "acceptance_scenario_count": { "type": "integer", "minimum": 0 },
        "automated_gate_count": { "type": "integer", "minimum": 0 },
        "passed_gate_count": { "type": "integer", "minimum": 0 },
        "failed_gate_count": { "type": "integer", "minimum": 0 },
        "environment_blocked_gate_count": { "type": "integer", "minimum": 0 },
        "not_run_gate_count": { "type": "integer", "minimum": 0 },
        "not_applicable_gate_count": { "type": "integer", "minimum": 0 },
        "contract_valid": { "type": "boolean" },
        "release_eligible": { "type": "boolean" },
        "report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "native_preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows", "administrator", "wpr_available",
        "required_profiles_available", "wpa_exporter_available", "ready"
      ],
      "properties": {
        "windows": { "type": "boolean" },
        "administrator": { "type": "boolean" },
        "wpr_available": { "type": "boolean" },
        "required_profiles_available": { "type": "boolean" },
        "wpa_exporter_available": { "type": "boolean" },
        "ready": { "type": "boolean" }
      }
    },
    "lpwp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol", "lpwp_version", "source_commit", "dotnet_contract_tests",
        "web_sdk_tests", "runtime_matrix", "fixture_count",
        "ipc_package_sha256", "reference_widget_sha256", "report_sha256", "valid"
      ],
      "properties": {
        "protocol": { "const": "long.plugin.ipc/1.0" },
        "lpwp_version": { "type": "string", "minLength": 1 },
        "source_commit": { "$ref": "#/$defs/commit" },
        "dotnet_contract_tests": { "type": "boolean" },
        "web_sdk_tests": { "type": "boolean" },
        "runtime_matrix": { "type": "boolean" },
        "fixture_count": { "type": "integer", "minimum": 0 },
        "ipc_package_sha256": { "$ref": "#/$defs/sha256" },
        "reference_widget_sha256": { "$ref": "#/$defs/sha256" },
        "report_sha256": { "$ref": "#/$defs/sha256" },
        "valid": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "kind": { "enum": ["json", "log", "executable", "other"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary", "category", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,191}$" },
        "status": {
          "enum": [
            "not_run", "passed", "failed", "blocked_environment", "not_applicable"
          ]
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "category": {
          "enum": ["build", "test", "plugin_matrix", "artifact", "performance", "lpwp"]
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "environment_blocker": { "type": "string", "minLength": 1 },
        "not_applicable_reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "enum": ["passed", "failed"] } }
          },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "blocked_environment" } }
          },
          "then": { "required": ["environment_blocker"] }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "not_applicable" } }
          },
          "then": { "required": ["not_applicable_reason"] }
        }
      ]
    },
    "automated_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automated_gate_count", "passed_gate_count", "failed_gate_count",
        "environment_blocked_gate_count", "not_run_gate_count",
        "not_applicable_gate_count", "contract_valid", "gates", "errors"
      ],
      "properties": {
        "automated_gate_count": { "type": "integer", "minimum": 1 },
        "passed_gate_count": { "type": "integer", "minimum": 0 },
        "failed_gate_count": { "type": "integer", "minimum": 0 },
        "environment_blocked_gate_count": { "type": "integer", "minimum": 0 },
        "not_run_gate_count": { "type": "integer", "minimum": 0 },
        "not_applicable_gate_count": { "type": "integer", "minimum": 0 },
        "contract_valid": { "type": "boolean" },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gate" }
        },
        "errors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
