{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://long-assistant.local/schemas/plugin-isolation-compatibility.schema.json",
  "title": "Long Assistant Plugin Isolation Compatibility Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_date",
    "policy",
    "experiment",
    "shared_worker_contract",
    "profiles"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "assessment_date": { "type": "string", "format": "date" },
    "policy": { "$ref": "#/$defs/policy" },
    "experiment": { "$ref": "#/$defs/experiment" },
    "shared_worker_contract": { "$ref": "#/$defs/workerContract" },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "decision",
        "migration_rule",
        "resource_attribution_rule",
        "first_experiment"
      ],
      "properties": {
        "phase": { "const": "PX6B-1" },
        "decision": { "const": "assessment_only" },
        "migration_rule": { "type": "string", "minLength": 1 },
        "resource_attribution_rule": { "type": "string", "minLength": 1 },
        "first_experiment": { "const": "synthetic_headless_native_command_worker" }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "status",
        "worker_project",
        "test_path",
        "production_enabled",
        "real_plugins_migrated",
        "validated_gates"
      ],
      "properties": {
        "phase": { "const": "PX6B-3" },
        "status": { "const": "read_only_capability_proxy_validated" },
        "worker_project": { "const": "tools/LongBetterWindows.PluginWorker/LongBetterWindows.PluginWorker.csproj" },
        "test_path": { "const": "tests/LongBetterWindows.Tests/ExperimentalPluginWorkerTests.cs" },
        "production_enabled": { "const": false },
        "real_plugins_migrated": { "const": 0 },
        "validated_gates": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "enum": [
              "process_identity",
              "ephemeral_nonce",
              "lifecycle",
              "command",
              "cancellation",
              "deadline_timeout",
              "crash_detection",
              "deterministic_cleanup",
              "dedicated_resource_snapshot",
              "health_mapping",
              "public_api_isolation",
              "read_only_capability_proxy",
              "access_context_restoration",
              "reverse_method_rejection",
              "crash_resource_lease_cleanup"
            ]
          }
        }
      }
    },
    "workerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_model",
        "transport_reuse",
        "protocol_namespace",
        "maximum_frame_bytes",
        "default_deadline_ms",
        "minimum_deadline_ms",
        "maximum_deadline_ms",
        "authentication",
        "host_api_rule",
        "host_proxy_methods",
        "resource_lease_rule",
        "ui_rule",
        "lifecycle_methods"
      ],
      "properties": {
        "process_model": { "const": "one_worker_per_plugin_instance" },
        "transport_reuse": { "const": "lpwp_length_prefixed_json_framing" },
        "protocol_namespace": { "const": "long.plugin.worker/experimental-1" },
        "maximum_frame_bytes": { "const": 1048576 },
        "default_deadline_ms": { "const": 10000 },
        "minimum_deadline_ms": { "const": 100 },
        "maximum_deadline_ms": { "const": 120000 },
        "authentication": { "const": "host_spawned_pipe_with_process_identity_and_ephemeral_nonce" },
        "host_api_rule": { "type": "string", "minLength": 1 },
        "host_proxy_methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "const": "host.capability.query" }
        },
        "resource_lease_rule": { "const": "session_owned_lifo_release_on_close_or_crash" },
        "ui_rule": { "const": "wpf_and_webview_ui_remain_in_host_process" },
        "lifecycle_methods": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "initialize",
              "start",
              "stop",
              "enter_background",
              "resume",
              "release_resources",
              "language_changed"
            ]
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "manifest_runtime",
        "has_native_background",
        "current_inventory_count",
        "current_boundary",
        "ui_boundary",
        "readiness",
        "target_model",
        "migration_risk",
        "blockers",
        "evidence"
      ],
      "properties": {
        "id": {
          "enum": [
            "native_dll",
            "csharp_script",
            "webview",
            "webview_native_background"
          ]
        },
        "manifest_runtime": { "enum": ["native", "csharp-script", "webview"] },
        "has_native_background": { "type": "boolean" },
        "current_inventory_count": { "type": "integer", "minimum": 0 },
        "current_boundary": { "type": "string", "minLength": 1 },
        "ui_boundary": { "type": "string", "minLength": 1 },
        "readiness": {
          "enum": ["candidate_after_contract", "retain_current_boundary"]
        },
        "target_model": { "type": "string", "minLength": 1 },
        "migration_risk": { "enum": ["medium", "high", "very_high"] },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contains"],
      "properties": {
        "path": { "type": "string", "pattern": "^(src|catalog)/" },
        "contains": { "type": "string", "minLength": 1 }
      }
    }
  }
}
